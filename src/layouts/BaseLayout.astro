---
import SiteHeader from '@components/SiteHeader.astro';
import SiteFooter from '@components/SiteFooter.astro';
import '@styles/global.css';
interface Props { title?: string; description?: string; }
const { title = 'B Tecky — Practical technology, thoughtfully built', description = 'B Tecky builds practical digital products, software experiences and technology learning resources.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en"><head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} /><meta name="theme-color" content="#ffffff" />
<meta property="og:type" content="website" /><meta property="og:site_name" content="B Tecky" />
<meta property="og:title" content={title} /><meta property="og:description" content={description} />
<link rel="canonical" href={canonical} /><link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
<title>{title}</title></head><body><SiteHeader /><slot /><SiteFooter /></body></html>
