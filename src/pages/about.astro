---
import BaseLayout from '@layouts/BaseLayout.astro';
const socials=[
 {name:'B Tecky YouTube',detail:'Main technology channel',url:'https://www.youtube.com/@btecky',icon:'▶',tone:'youtube'},
 {name:'KalkaEngineer',detail:'Engineering and learning videos',url:'https://www.youtube.com/@KalkaEngineer',icon:'▶',tone:'youtube'},
 {name:'PlaceAdda',detail:'PlaceAdda video channel',url:'https://www.youtube.com/@placeadda',icon:'▶',tone:'youtube'},
 {name:'Algorithms & Code',detail:'Programming and algorithms',url:'https://www.youtube.com/@Algorithm-Code',icon:'▶',tone:'youtube'},
 {name:'KalkaEngineer Instagram',detail:'Instagram community',url:'https://www.instagram.com/kalkaengineeer/',icon:'◎',tone:'instagram'},
 {name:'Lavish Sheth Instagram',detail:'Personal updates',url:'https://www.instagram.com/lavish__sheth/',icon:'◎',tone:'instagram'},
 {name:'Lavish Sheth LS',detail:'Creator profile',url:'https://www.instagram.com/lavish_sheth_ls/',icon:'◎',tone:'instagram'},
 {name:'Lavish Sheth LinkedIn',detail:'Professional profile',url:'https://www.linkedin.com/in/lavish-sheth-163844215/',icon:'in',tone:'linkedin'},
 {name:'B Tecky Google profile',detail:'Google creator profile',url:'https://profile.google.com/@btecky',icon:'G',tone:'google'},
 {name:'B Tecky Telegram',detail:'Join our community updates',url:'https://t.me/bteckyls',icon:'➤',tone:'telegram'},
 {name:'B Tecky WhatsApp',detail:'Follow the broadcast channel',url:'https://whatsapp.com/channel/0029Va7uSWT7oQhlRVJKka1Q',icon:'◉',tone:'whatsapp'},
];
---
<BaseLayout title="About B Tecky — Our mission, people and community" description="Learn about B Tecky, our practical technology products, learning resources, founder, team and social channels.">
<main class="about-page">
<section class="about-hero"><div class="container"><p class="eyebrow">THE PEOPLE & IDEAS BEHIND THE WORK</p><h1 class="display">Technology should make<br><span>progress feel possible.</span></h1><p>B Tecky is an independent technology initiative building useful digital tools, practical learning experiences and a welcoming community for curious builders.</p><a class="about-telegram" href="https://t.me/bteckyls" target="_blank" rel="noopener noreferrer">Join B Tecky on Telegram <span>↗</span></a></div></section>
<section class="container about-mission"><div><p class="eyebrow">WHY B TECKY EXISTS</p><h2 class="display">Make technology<br>more useful and accessible.</h2></div><div><p>B Tecky started with a simple belief: technology becomes valuable when it helps people solve real problems, learn with confidence and turn ideas into working outcomes.</p><p>We bring together product experiments, step-by-step guides, video explainers and community opportunities. We share what we learn, listen to feedback and improve the experience as the community grows.</p></div></section>
<section class="about-products"><div class="container"><div class="section-heading"><p class="eyebrow">WHAT YOU CAN DO HERE</p><h2 class="display">One home for tools,<br>learning and opportunities.</h2></div><div class="about-feature-grid">
<a href="/arcade" class="about-feature"><span class="about-feature-icon">✦</span><b>Arcade Score Checker</b><p>Check Google Cloud Arcade progress and make your points easier to understand.</p><span>Explore tool ↗</span></a>
<a href="/arcade/guide" class="about-feature"><span class="about-feature-icon">▶</span><b>Arcade guides & videos</b><p>Find explainers, useful updates and Arcade-related video walkthroughs.</p><span>Explore Arcade hub ↗</span></a>
<a href="/blog?type=written" class="about-feature"><span class="about-feature-icon">▤</span><b>Written blogs</b><p>In-depth technical articles, practical examples and tutorials.</p><span>Read articles ↗</span></a>
<a href="/blog?type=video" class="about-feature"><span class="about-feature-icon">▷</span><b>Video blogs</b><p>Watch concise walkthroughs, opportunity updates and technology explainers.</p><span>Watch videos ↗</span></a>
<a href="/playlists" class="about-feature"><span class="about-feature-icon">▥</span><b>Learning playlists</b><p>Curated video paths to help you build skills at your own pace.</p><span>Browse playlists ↗</span></a>
<a href="/contact" class="about-feature"><span class="about-feature-icon">✉</span><b>Community & collaboration</b><p>Suggest ideas, ask questions or explore a project together.</p><span>Get in touch ↗</span></a>
</div></div></section>
<section class="container founder-section"><div class="founder-photo-wrap"><img src="/assets/images/lavish-btecky-founder.png" alt="Lavish Sheth, founder of B Tecky" loading="lazy"></div><div class="founder-copy"><p class="eyebrow">FOUNDER & DEVELOPMENT LEAD</p><h2 class="display">Lavish Sheth</h2><p>I lead B Tecky’s vision, product direction and development. I enjoy software engineering, building web experiences, exploring new technologies and turning useful ideas into practical products.</p><p>B Tecky is a place to build in public, share what works, learn from the community and create digital experiences that are thoughtful, approachable and genuinely useful.</p><div class="founder-links"><a href="https://www.linkedin.com/in/lavish-sheth-163844215/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href="mailto:lavishsheth122@gmail.com">Email ↗</a><a href="https://profile.google.com/@btecky" target="_blank" rel="noopener noreferrer">Google profile ↗</a></div></div></section>
<section class="team-section"><div class="container"><div class="section-heading"><p class="eyebrow">THE PEOPLE WHO HELP BUILD</p><h2 class="display">Small team. Shared curiosity.</h2><p>We value practical engineering, collaboration and steady improvement.</p></div><div class="team-card"><div class="team-avatar">RP</div><div><span class="team-role">SOFTWARE ENGINEER</span><h3>Rohan Pawar</h3><p>Contributes software engineering experience and a collaborative approach to building digital products. His work reflects the practical, team-first mindset we value at B Tecky.</p><a href="https://www.linkedin.com/in/rohan-pawar-35b846206/" target="_blank" rel="noopener noreferrer">LinkedIn profile ↗</a></div></div></div></section>
<section class="container roadmap-section"><div class="section-heading"><p class="eyebrow">WHAT'S COMING NEXT</p><h2 class="display">The next chapter is<br>already taking shape.</h2><p>These are planned directions, not promises of fixed release dates.</p></div><div class="roadmap-grid"><article><span>01</span><h3>More useful products</h3><p>Small web tools and utilities shaped by real community needs.</p></article><article><span>02</span><h3>Better learning paths</h3><p>More structured playlists, tutorials and project-based learning resources.</p></article><article><span>03</span><h3>Creator & community features</h3><p>More ways to discover events, share work and connect with other builders.</p></article></div></section>
<section class="social-section"><div class="container"><div class="section-heading"><p class="eyebrow">FOLLOW THE WORK</p><h2 class="display">Find us across<br>the community.</h2><p>Explore the channels and creator profiles connected to B Tecky.</p></div><div class="social-grid">{socials.map(s=><a class="social-card" href={s.url} target="_blank" rel="noopener noreferrer"><span class:list={['social-icon',s.tone]}>{s.icon}</span><span><b>{s.name}</b><small>{s.detail}</small></span><span class="social-arrow">↗</span></a>)}</div></div></section>
<section class="container about-final"><div><p class="eyebrow">HAVE AN IDEA OR QUESTION?</p><h2 class="display">Let's build something<br>useful together.</h2></div><div><a class="about-telegram" href="https://t.me/bteckyls" target="_blank" rel="noopener noreferrer">Join B Tecky on Telegram ↗</a><a class="about-contact" href="/contact">Contact the team ↗</a></div></section>
</main>
</BaseLayout>
<style>
.about-page{overflow:hidden}.about-hero{padding:100px 0 90px;background:radial-gradient(ellipse at 78% 30%,rgba(49,94,251,.12),transparent 38%),linear-gradient(135deg,#f4f7ff,#fff 65%)}.about-hero h1{font-size:clamp(3.1rem,6.4vw,6rem);line-height:.96;letter-spacing:-.075em;margin:25px 0}.about-hero h1 span{color:var(--color-brand)}.about-hero>div>p:not(.eyebrow){max-width:650px;color:var(--color-muted);font-size:1.1rem;line-height:1.8}.about-telegram{display:inline-flex;align-items:center;gap:12px;margin-top:20px;padding:14px 19px;border-radius:12px;background:#315efb;color:#fff;font-weight:800}.about-mission{padding-block:95px;display:grid;grid-template-columns:1fr 1fr;gap:70px}.about-mission h2,.section-heading h2,.founder-copy h2,.about-final h2{font-size:clamp(2.5rem,4.8vw,4.4rem);line-height:1;letter-spacing:-.065em;margin:15px 0}.about-mission>div:last-child{color:var(--color-muted);line-height:1.85}.about-products,.team-section,.social-section{padding:85px 0;background:#f6f8ff}.section-heading{margin-bottom:32px}.section-heading>p:last-child{color:var(--color-muted);line-height:1.7}.about-feature-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.about-feature{padding:24px;border:1px solid var(--color-border);border-radius:18px;background:#fff;transition:transform .2s,box-shadow .2s}.about-feature:hover{transform:translateY(-4px);box-shadow:0 16px 35px rgba(25,42,80,.08)}.about-feature-icon{display:grid;place-items:center;width:42px;height:42px;border-radius:12px;background:#eef2ff;color:#315efb;font-size:1.15rem}.about-feature b{display:block;margin-top:18px;font-size:1rem}.about-feature p{min-height:68px;color:var(--color-muted);font-size:.86rem;line-height:1.65}.about-feature>span:last-child{color:#315efb;font-size:.8rem;font-weight:800}.founder-section{padding-block:100px;display:grid;grid-template-columns:.8fr 1.2fr;gap:65px;align-items:center}.founder-photo-wrap{border-radius:24px;overflow:hidden;background:#e9efff;box-shadow:0 20px 55px rgba(30,50,100,.12)}.founder-photo-wrap img{width:100%;aspect-ratio:4/5;object-fit:cover}.founder-copy>p:not(.eyebrow){color:var(--color-muted);line-height:1.8}.founder-links{display:flex;gap:18px;flex-wrap:wrap;margin-top:22px}.founder-links a,.team-card a{color:#315efb;font-size:.85rem;font-weight:800}.team-section{background:#fff}.team-card{display:grid;grid-template-columns:100px 1fr;gap:25px;max-width:780px;padding:28px;border:1px solid var(--color-border);border-radius:20px;background:#f8faff}.team-avatar{width:88px;height:88px;display:grid;place-items:center;border-radius:22px;background:linear-gradient(145deg,#315efb,#8ba4ff);color:white;font:800 2rem var(--font-display)}.team-role{font-size:.65rem;letter-spacing:.14em;color:#315efb;font-weight:900}.team-card h3{font:800 1.6rem var(--font-display);margin:8px 0}.team-card p{color:var(--color-muted);line-height:1.7}.roadmap-section{padding-block:95px}.roadmap-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.roadmap-grid article{padding:23px;border:1px solid var(--color-border);border-radius:17px}.roadmap-grid article>span{color:#315efb;font-weight:900;font-size:.72rem}.roadmap-grid h3{font:800 1.2rem var(--font-display)}.roadmap-grid p{color:var(--color-muted);font-size:.88rem;line-height:1.7}.social-section{background:#f6f8ff}.social-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.social-card{display:flex;align-items:center;gap:14px;padding:14px 16px;background:#fff;border:1px solid #e5eaf4;border-radius:14px}.social-icon{width:40px;height:40px;display:grid;place-items:center;border-radius:12px;color:#fff;font-weight:900;font-size:1.1rem}.youtube{background:#e62117}.instagram{background:linear-gradient(135deg,#833ab4,#fd1d1d,#fcb045)}.linkedin{background:#0a66c2}.google{background:#4285f4}.telegram{background:#229ed9}.whatsapp{background:#25d366}.social-card b,.social-card small{display:block}.social-card b{font-size:.84rem}.social-card small{margin-top:4px;color:var(--color-muted);font-size:.72rem}.social-arrow{margin-left:auto;color:#315efb}.about-final{padding-block:90px;display:flex;justify-content:space-between;align-items:center;gap:25px}.about-final h2{margin-bottom:0}.about-contact{display:block;margin-top:14px;color:#315efb;font-weight:800}
@media(max-width:760px){.about-hero{padding:70px 0}.about-mission,.founder-section{grid-template-columns:1fr;gap:25px;padding-block:65px}.about-feature-grid,.roadmap-grid{grid-template-columns:1fr 1fr}.founder-photo-wrap{max-width:460px}.about-final{align-items:flex-start;flex-direction:column;padding-block:65px}}
@media(max-width:520px){.about-feature-grid,.roadmap-grid,.social-grid{grid-template-columns:1fr}.team-card{grid-template-columns:1fr}.about-products,.team-section,.social-section{padding:65px 0}}
</style>