<style>.legal-hero{padding:76px 0 48px;background:linear-gradient(135deg,#f3f6ff,#fff)}.legal-hero h1{font-size:clamp(2.8rem,6vw,4.8rem);letter-spacing:-.06em;margin:15px 0}.legal-hero p:not(.eyebrow){max-width:700px;color:#667085;line-height:1.7}.legal-hero small{color:#667085}.legal-content{max-width:850px;padding-block:48px 90px}.legal-content section{padding:20px 0;border-bottom:1px solid #e6e9f0}.legal-content h2{font:800 1.35rem var(--font-display);letter-spacing:-.03em}.legal-content p{color:#475467;line-height:1.8}.legal-content a{color:#315efb;text-decoration:underline;text-underline-offset:3px}</style>