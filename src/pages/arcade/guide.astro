---
import BaseLayout from '@layouts/BaseLayout.astro';
import catalogue from '../../../blog/posts.json';
type Post={slug:string;title:string;summary?:string;date?:string;tags?:string[];videoUrl?:string;videoThumbnail?:string;status?:string};
const related=(catalogue.posts as Post[]).filter(p=>p.status!=='draft'&&p.videoUrl&&/(arcade|google cloud|google skills)/i.test([p.title,p.summary||'',...(p.tags||[])].join(' '))).sort((a,b)=>(b.date||'').localeCompare(a.date||''));
const youtubeId=(url:string)=>url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([^?&/]+)/)?.[1]||'';
---
<BaseLayout title="Google Cloud Arcade Guide & Videos | B Tecky" description="A B Tecky hub for Google Cloud Arcade explainers, progress tips, video walkthroughs and useful updates.">
<main class="arcade-hub">
<section class="arcade-hero"><div class="container"><p class="eyebrow">THE B TECKY ARCADE HUB</p><h1 class="display">Your Arcade journey,<br><span>all in one place.</span></h1><p>Explore the score checker, understand the Arcade learning flow, catch helpful updates and watch video walkthroughs from B Tecky.</p><a class="arcade-button" href="/arcade">Open Arcade Score Checker ↗</a></div></section>
<section class="container arcade-guide-grid"><article><span>01 / START HERE</span><h2>What is Google Cloud Arcade?</h2><p>Google Cloud Arcade is a learning experience built around hands-on activities and skill-building. The exact program structure, campaigns and rewards can change over time, so always check the official Google Skills pages for current details.</p><a href="https://www.skills.google/" target="_blank" rel="noopener noreferrer">Visit Google Skills ↗</a></article><article><span>02 / TRACK PROGRESS</span><h2>Use the B Tecky Score Checker</h2><p>Use the checker to look up the progress data it supports. Enter the email associated with your Arcade participation and review the score information shown by the tool.</p><a href="/arcade">Check your progress ↗</a></article><article><span>03 / LEARN SMARTER</span><h2>Build a steady learning rhythm</h2><p>Keep track of completed activities, read the instructions carefully, save useful resources and revisit the official program pages for deadlines or rule changes.</p><a href="/blog?type=written">Read written guides ↗</a></article></section>
<section class="arcade-videos"><div class="container"><div class="section-heading"><p class="eyebrow">WATCH & LEARN</p><h2 class="display">Arcade videos<br>from B Tecky.</h2><p>Video posts tagged or titled around Google Cloud and Arcade appear here automatically when they include a video link in the blog catalogue.</p></div>{related.length?<div class="arcade-video-grid">{related.map(post=><article class="arcade-video-card"><a href={post.videoUrl} target="_blank" rel="noopener noreferrer" class="arcade-video-thumb"><img src={post.videoThumbnail||'https://img.youtube.com/vi/'+youtubeId(post.videoUrl||'')+'/hqdefault.jpg'} alt={post.title} loading="lazy"><span>▶ Watch video</span></a><div><small>{post.date||'B TECKY VIDEO'}</small><h3>{post.title}</h3><p>{post.summary||''}</p><a href={'/blog/'+post.slug}>Read the full post ↗</a></div></article>)}</div>:<div class="arcade-empty">Arcade video walkthroughs will appear here as they are published. Browse the <a href="/blog?type=video">video blog library</a> in the meantime.</div>}</div></section>
<section class="container arcade-links"><div><p class="eyebrow">KEEP EXPLORING</p><h2 class="display">More from B Tecky.</h2></div><a href="/blog?type=written">Written guides ↗</a><a href="/blog?type=video">Video blogs ↗</a><a href="/playlists">Learning playlists ↗</a></section>
</main>
</BaseLayout>
<style>
.arcade-hub{overflow:hidden}.arcade-hero{padding:95px 0;background:radial-gradient(ellipse at 78% 35%,rgba(49,94,251,.15),transparent 38%),linear-gradient(135deg,#f4f7ff,#fff 65%)}.arcade-hero h1{font-size:clamp(3.2rem,6vw,5.8rem);line-height:.96;letter-spacing:-.075em;margin:25px 0}.arcade-hero h1 span{color:#315efb}.arcade-hero>div>p:not(.eyebrow){max-width:650px;color:#667085;font-size:1.1rem;line-height:1.8}.arcade-button{display:inline-flex;margin-top:20px;padding:14px 18px;background:#315efb;color:#fff;border-radius:12px;font-weight:800}.arcade-guide-grid{padding-block:85px;display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.arcade-guide-grid article{padding:24px;border:1px solid #e5eaf4;border-radius:18px;background:#fff}.arcade-guide-grid article>span{color:#315efb;font-size:.65rem;font-weight:900;letter-spacing:.13em}.arcade-guide-grid h2{font:800 1.5rem var(--font-display);letter-spacing:-.04em}.arcade-guide-grid p,.arcade-video-card p{color:#667085;font-size:.88rem;line-height:1.7}.arcade-guide-grid a,.arcade-video-card>div>a{color:#315efb;font-size:.82rem;font-weight:800}.arcade-videos{padding:85px 0;background:#f6f8ff}.section-heading{margin-bottom:30px}.section-heading h2{font-size:clamp(2.7rem,5vw,4.4rem);line-height:.98;letter-spacing:-.065em;margin:14px 0}.section-heading>p:last-child{max-width:620px;color:#667085;line-height:1.75}.arcade-video-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.arcade-video-card{overflow:hidden;border:1px solid #e5eaf4;border-radius:18px;background:#fff}.arcade-video-thumb{display:block;position:relative;aspect-ratio:16/9;background:#e9efff}.arcade-video-thumb img{width:100%;height:100%;object-fit:cover}.arcade-video-thumb span{position:absolute;bottom:12px;left:12px;background:#315efb;color:#fff;padding:8px 11px;border-radius:8px;font-size:.72rem;font-weight:800}.arcade-video-card>div{padding:18px}.arcade-video-card small{color:#8591a5;font-size:.66rem;font-weight:800}.arcade-video-card h3{font:800 1.08rem/1.3 var(--font-display)}.arcade-empty{padding:25px;border:1px dashed #cbd5e1;border-radius:15px;color:#667085}.arcade-empty a{color:#315efb;font-weight:800}.arcade-links{padding-block:70px;display:flex;align-items:center;gap:24px;flex-wrap:wrap}.arcade-links h2{font-size:2.5rem;margin:10px 30px 0 0}.arcade-links>a{color:#315efb;font-weight:800}
@media(max-width:760px){.arcade-hero{padding:65px 0}.arcade-guide-grid,.arcade-video-grid{grid-template-columns:1fr}.arcade-guide-grid{padding-block:55px}.arcade-videos{padding:60px 0}.arcade-links{padding-block:50px;align-items:flex-start;flex-direction:column}}
</style>