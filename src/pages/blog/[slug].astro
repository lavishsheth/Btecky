---
import BaseLayout from '@layouts/BaseLayout.astro';
import catalogue from '../../../blog/posts.json';
type BlogPost = {
  slug: string;
  title: string;
  date?: string;
  tags?: string[];
  summary?: string;
  body?: string;
  videoUrl?: string;
  videoThumbnail?: string;
  cover?: string;
  coverAlt?: string;
  author?: string;
  status?: string;
  seoTitle?: string;
  seoDescription?: string;
  contentType?: string;
};
export function getStaticPaths() {
  return catalogue.posts
    .filter((post: BlogPost) => post.status !== 'draft')
    .map((post: BlogPost) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props as { post: BlogPost };

const escapeHtml = (value: string) => value.replace(/[&<>"']/g, (char) => ({
  '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
}[char] || char));

function renderInline(value: string): string {
  const code: string[] = [];
  let text = escapeHtml(value).replace(/`([^`]+)`/g, (_match, content) => {
    const token = `@@CODE${code.length}@@`;
    code.push(`<code>${content}</code>`);
    return token;
  });
  text = text.replace(/!\[([^\]]*)\]\((https?:\/\/[^\s)]+|\/(?!\/)[^\s)]*)\)/g, (_m, alt, src) =>
    `<figure class="article-figure"><img src="${src}" alt="${alt}" loading="lazy" decoding="async"><figcaption>${alt}</figcaption></figure>`);
  text = text.replace(/\[([^\]]+)\]\((https?:\/\/[^\s)]+|\/(?!\/)[^\s)]*)\)/g, (_m, label, href) =>
    `<a href="${href}" rel="noopener noreferrer">${label}</a>`);
  text = text.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
    .replace(/__([^_]+)__/g, '<strong>$1</strong>')
    .replace(/\*([^*]+)\*/g, '<em>$1</em>')
    .replace(/_([^_]+)_/g, '<em>$1</em>')
    .replace(/~~([^~]+)~~/g, '<del>$1</del>');
  return text.replace(/@@CODE(\d+)@@/g, (_m, index) => code[Number(index)] || '');
}

function renderMarkdown(source: string): string {
  const lines = String(source || '').replace(/\r\n?/g, '\n').split('\n');
  const html: string[] = [];
  let i = 0;
  while (i < lines.length) {
    const line = lines[i];
    if (!line.trim()) { i++; continue; }
    const fence = line.match(/^\s*```\s*([a-zA-Z0-9+#._-]*)/);
    if (fence) {
      const language = fence[1] || '';
      i++;
      const code: string[] = [];
      while (i < lines.length && !/^\s*```/.test(lines[i])) code.push(lines[i++]);
      if (i < lines.length) i++;
      html.push(`<pre class="code-block"><code${language ? ` class="language-${language}"` : ''}>${escapeHtml(code.join('\n'))}</code></pre>`);
      continue;
    }
    if (i + 1 < lines.length && line.includes('|') && /^\s*\|?\s*:?-{3,}/.test(lines[i+1])) {
      const cells = (row: string) => row.trim().replace(/^\|/, '').replace(/\|$/, '').split('|').map(cell => cell.trim());
      const headers = cells(line);
      i += 2;
      const rows: string[][] = [];
      while (i < lines.length && lines[i].trim() && lines[i].includes('|')) rows.push(cells(lines[i++]));
      html.push(`<div class="article-table-wrap"><table><thead><tr>${headers.map(cell => `<th scope="col">${renderInline(cell)}</th>`).join('')}</tr></thead><tbody>${rows.map(row => `<tr>${headers.map((_, index) => `<td>${renderInline(row[index] || '')}</td>`).join('')}</tr>`).join('')}</tbody></table></div>`);
      continue;
    }
    const heading = line.match(/^\s*(#{1,6})\s+(.+)$/);
    if (heading) {
      const level = heading[1].length;
      const headingId = heading[2].toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
      html.push(level === 2
        ? `<h2 id="${headingId}">${renderInline(heading[2])}</h2>`
        : `<h${level}>${renderInline(heading[2])}</h${level}>`);
      i++; continue;
    }
    if (/^\s*([-*_])\1\1+\s*$/.test(line)) { html.push('<hr>'); i++; continue; }
    if (/^\s*>/.test(line)) {
      const quote: string[] = [];
      while (i < lines.length && /^\s*>/.test(lines[i])) quote.push(lines[i++].replace(/^\s*>\s?/, ''));
      html.push(`<blockquote>${renderMarkdown(quote.join('\n'))}</blockquote>`);
      continue;
    }
    const listMatch = line.match(/^\s*([-*+] |\d+[.)] )/);
    if (listMatch) {
      const ordered = /^\s*\d/.test(line);
      const items: string[] = [];
      while (i < lines.length && /^\s*([-*+] |\d+[.)] )/.test(lines[i])) {
        items.push(`<li>${renderInline(lines[i].replace(/^\s*([-*+] |\d+[.)] )/, ''))}</li>`);
        i++;
      }
      html.push(`<${ordered ? 'ol' : 'ul'}>${items.join('')}</${ordered ? 'ol' : 'ul'}>`);
      continue;
    }
    const paragraph: string[] = [line];
    i++;
    while (i < lines.length && lines[i].trim() &&
      !/^\s*(#{1,6}\s|>|[-*_]{3,}\s*$|```|[-*+] |\d+[.)] )/.test(lines[i])) {
      paragraph.push(lines[i++]);
    }
    html.push(`<p>${renderInline(paragraph.join(' '))}</p>`);
  }
  return html.join('\n');
}
const articleHtml = renderMarkdown(post.body || '');
const tableOfContents = [...String(post.body || '').matchAll(/^##\s+(.+)$/gm)].map(match => ({title:match[1].trim(),id:match[1].trim().toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'')}));
const wordCount = String(post.body || '').trim().split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.ceil(wordCount / 210));
---
<BaseLayout title={post.seoTitle || post.title+' | B Tecky'} description={post.seoDescription || post.summary || post.title}>
<main class="container article-page">
<a class="back-link" href="/blog">← Back to the learning library</a>
<article class="article-shell">
<header class="article-head"><p class="eyebrow">{post.date || 'B TECKY'}{post.tags?.length ? ' · '+post.tags.join(' · ') : ''}</p><h1 class="display">{post.title}</h1><p class="summary">{post.summary}</p><p class="reading-time"><span>⏱ {readingMinutes} min read</span>{post.author ? <span>By {post.author}</span> : <span>By B Tecky Editorial</span>}</p></header>
<div class="article-card">
{(post.videoThumbnail || post.cover) && <img class="cover" src={post.videoThumbnail || (post.cover!.startsWith('/') ? post.cover : '/'+post.cover)} alt={post.coverAlt || post.title} />}
{tableOfContents.length >= 4 && <nav class="article-toc" aria-label="On this page"><details open><summary>In this guide <span>{tableOfContents.length} sections</span></summary><ol>{tableOfContents.map(item => <li><a href={`#${item.id}`}>{item.title}</a></li>)}</ol></details></nav>}
<div class="article-body" set:html={articleHtml}></div>
{post.videoUrl && <section class="video-section"><h2>Watch the video</h2><a href={post.videoUrl} target="_blank" rel="noopener noreferrer">Open the related video ↗</a></section>}
</div>
</article>
</main>
</BaseLayout>
<style>
.article-page{max-width:1040px;padding-block:44px 110px}.back-link{display:inline-flex;align-items:center;gap:8px;color:var(--color-muted);font-weight:700;font-size:.9rem;margin-bottom:22px}.article-shell{max-width:900px;margin-inline:auto}.article-head{padding:20px 0 34px}.article-head .eyebrow{font-size:.72rem;letter-spacing:.08em;font-weight:800;color:var(--color-brand)}.article-head h1{font-size:clamp(2.5rem,6vw,4.65rem);line-height:1.02;letter-spacing:-.065em;margin:18px 0 22px;max-width:850px}.summary{font-size:1.18rem;line-height:1.75;color:var(--color-muted);white-space:pre-line;max-width:790px}.reading-time{display:flex;gap:18px;flex-wrap:wrap;font-size:.82rem;color:#77839a;margin-top:18px;font-weight:700}.article-card{background:#fff;border:1px solid #dce4f3;border-radius:24px;padding:clamp(20px,4vw,46px);box-shadow:0 18px 55px rgba(22,39,82,.055)}.cover{display:block;width:100%;max-height:470px;object-fit:cover;border-radius:16px;margin:0 auto 38px}.article-toc{max-width:760px;margin:0 auto 42px;padding:20px 22px;border:1px solid #e5eaf4;border-radius:15px;background:#f7f9ff}.article-toc summary{cursor:pointer;font-weight:900;color:#17233f;list-style:none}.article-toc summary::-webkit-details-marker{display:none}.article-toc summary span{float:right;font-size:.72rem;color:#8993a5;font-weight:700}.article-toc ol{columns:2;column-gap:35px;margin:15px 0 0;padding-left:20px}.article-toc li{break-inside:avoid;margin:7px 0;font-size:.86rem}.article-toc a{color:var(--color-brand);text-decoration:none}.article-toc a:hover{text-decoration:underline}.article-body{max-width:760px;margin-inline:auto;font-size:1.06rem;line-height:1.9;color:#344054;overflow-wrap:anywhere}.article-body :global(p){margin:0 0 1.35em}.article-body :global(h2){font-family:var(--font-display);font-size:clamp(1.55rem,3vw,2rem);line-height:1.2;letter-spacing:-.04em;color:var(--color-ink);margin:2.15em 0 .7em;padding-bottom:.45em;border-bottom:1px solid #edf0f6}.article-body :global(h3){font-family:var(--font-display);font-size:1.35rem;line-height:1.3;color:var(--color-ink);margin:1.8em 0 .6em}.article-body :global(ul),.article-body :global(ol){padding-left:1.5em;margin:0 0 1.5em}.article-body :global(li){padding-left:.35em;margin:.45em 0}.article-body :global(a){color:var(--color-brand);text-decoration:underline;text-underline-offset:3px}.article-body :global(blockquote){border-left:4px solid var(--color-brand);padding:.35em 1.2em;margin:1.7em 0;border-radius:0 12px 12px 0;background:#f5f7ff;color:#475467}.article-body :global(pre){overflow:auto;padding:20px;border-radius:14px;background:#101828;color:#f8fafc;font-size:.9rem;line-height:1.65}.article-body :global(.article-figure){margin:2.2em 0}.article-body :global(.article-figure img){display:block;width:100%;height:auto;border-radius:14px;border:1px solid #e4e9f2}.article-body :global(figcaption){font-size:.84rem;color:#667085;text-align:center;margin-top:.65em}.article-body :global(.article-table-wrap){overflow-x:auto;margin:1.7em 0;border:1px solid #e4e9f2;border-radius:13px}.article-body :global(code){font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.9em;background:#f0f3f9;padding:.12em .35em;border-radius:5px}.article-body :global(pre code){background:transparent!important;color:#f8fafc!important;padding:0}.article-body :global(hr){border:0;border-top:1px solid var(--color-border);margin:2em 0}.article-table-wrap{overflow-x:auto;margin:1.7em 0;border:1px solid #e4e9f2;border-radius:13px}.article-body :global(table){width:100%;border-collapse:collapse;font-size:.92rem}.article-body :global(th),.article-body :global(td){padding:13px 15px;text-align:left;vertical-align:top;border-bottom:1px solid #e9edf4}.article-body :global(th){background:#f4f6fc;color:#17233f;font-weight:800}.article-body :global(tr:last-child td){border-bottom:0}.video-section{max-width:760px;margin:45px auto 0;padding:24px;border:1px solid var(--color-border);border-radius:16px;background:#f9faff}.video-section h2{margin-top:0}.video-section a{color:var(--color-brand);font-weight:800}
@media(max-width:640px){.article-page{padding-block:30px 72px}.article-head{padding:16px 0 25px}.article-card{padding:18px;border-radius:17px}.article-body{font-size:1rem}.cover{border-radius:12px;margin-bottom:28px}.article-toc ol{columns:1}}
</style>
