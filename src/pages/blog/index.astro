---
import BaseLayout from '@layouts/BaseLayout.astro';
import catalogue from '../../data/posts.json';
const posts = catalogue.posts
  .filter((post) => post.status !== 'draft')
  .sort((a,b) => (b.date || '').localeCompare(a.date || ''));
const categories = [...new Set(posts.flatMap((post) => post.tags || []))].sort((a,b) => a.localeCompare(b));
---
<BaseLayout title="Practical Tech Guides & Learning | B Tecky" description="Explore practical guides on AI, Python, Java, machine learning, cloud, cybersecurity and web development.">
<main class="container blog-page">
<header class="blog-heading"><p class="eyebrow">THE B TECKY LEARNING LIBRARY</p><h1 class="display">Ideas worth<br /><span>understanding.</span></h1><p>Practical technology guides, explainers and walkthroughs for curious builders.</p></header>
<section class="blog-tools" aria-label="Find articles">
<label class="search-label" for="article-search">Search the library</label>
<input id="article-search" type="search" placeholder="Search topics, titles and guides…" autocomplete="off" />
<div class="category-list" aria-label="Filter by topic"><button class="category-chip is-active" type="button" data-category="all">All topics</button>{categories.map((category) => <button class="category-chip" type="button" data-category={category}>{category}</button>)}</div>
<p class="results-count" id="results-count" aria-live="polite">{posts.length} articles</p>
</section>
<section class="post-grid" id="post-grid" aria-label="Articles">
{posts.map((post) => <article class="post-card" data-title={(post.title+' '+(post.summary || '')+' '+(post.tags || []).join(' ')).toLowerCase()} data-tags={(post.tags || []).join('|').toLowerCase()}>
{post.cover && <a class="post-cover" href={`/blog/${post.slug}`}><img src={post.cover.startsWith('/') ? post.cover : '/'+post.cover} alt={post.coverAlt || post.title} loading="lazy" /></a>}
<div class="post-meta">{post.date || 'B Tecky'}{post.tags?.length ? ' · '+post.tags.slice(0,2).join(', ') : ''}</div>
<h2><a href={`/blog/${post.slug}`}>{post.title}</a></h2>
<p>{post.summary}</p><a class="read-link" href={`/blog/${post.slug}`}>Read article ↗</a>
</article>)}
</section>
<p class="empty-state" id="empty-state" hidden>No articles match that search. Try another topic or keyword.</p>
</main>
</BaseLayout>
<style>
.blog-page{padding-block:76px 110px}.blog-heading{max-width:760px;margin-bottom:42px}.blog-heading h1{font-size:clamp(3.2rem,7vw,6rem);line-height:.98;margin:18px 0}.blog-heading h1 span{color:var(--color-brand)}.blog-heading>p:last-child{color:var(--color-muted);font-size:1.1rem;line-height:1.7}.blog-tools{padding:24px;border:1px solid var(--color-border);border-radius:18px;background:var(--color-canvas);margin-bottom:28px}.search-label{display:block;font-weight:700;font-size:.9rem;margin-bottom:8px}.blog-tools input{width:100%;padding:14px 16px;border:1px solid var(--color-border);border-radius:10px;background:white;color:var(--color-ink);outline-offset:2px}.category-list{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px}.category-chip{border:1px solid var(--color-border);border-radius:999px;background:white;padding:8px 13px;font-size:.82rem;font-weight:600;cursor:pointer}.category-chip:hover,.category-chip.is-active{background:var(--color-ink);border-color:var(--color-ink);color:white}.results-count{font-size:.85rem;color:var(--color-muted);margin:16px 0 0}.post-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.post-card{border:1px solid var(--color-border);border-radius:18px;padding:18px;background:white;min-width:0;display:flex;flex-direction:column}.post-cover{display:block;overflow:hidden;border-radius:11px;margin-bottom:17px}.post-card img{width:100%;aspect-ratio:16/9;object-fit:cover;transition:transform .3s}.post-card:hover img{transform:scale(1.025)}.post-meta{font-size:.76rem;color:var(--color-muted);font-weight:600}.post-card h2{font-family:var(--font-display);font-size:1.25rem;line-height:1.3;letter-spacing:-.025em;margin:10px 0}.post-card p{color:var(--color-muted);font-size:.92rem;line-height:1.65;margin:0 0 18px}.read-link{margin-top:auto;color:var(--color-brand);font-weight:700;font-size:.88rem}.empty-state{padding:48px;text-align:center;color:var(--color-muted)}@media(max-width:900px){.post-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.blog-page{padding-block:48px 72px}.post-grid{grid-template-columns:1fr}.blog-tools{padding:16px}}
</style>
<script>
const search = document.querySelector('#article-search');
const cards = [...document.querySelectorAll('.post-card')];
const chips = [...document.querySelectorAll('.category-chip')];
const count = document.querySelector('#results-count');
const empty = document.querySelector('#empty-state');
let activeCategory = 'all';
function filterArticles() {
  const term = (search?.value || '').trim().toLowerCase();
  let visible = 0;
  for (const card of cards) {
    const matchesText = card.dataset.title.includes(term);
    const tags = (card.dataset.tags || '').split('|');
    const matchesCategory = activeCategory === 'all' || tags.includes(activeCategory.toLowerCase());
    const show = matchesText && matchesCategory;
    card.hidden = !show;
    if (show) visible++;
  }
  if (count) count.textContent = visible + (visible === 1 ? ' article' : ' articles');
  if (empty) empty.hidden = visible !== 0;
}
search?.addEventListener('input', filterArticles);
chips.forEach((chip) => chip.addEventListener('click', () => {
  activeCategory = chip.dataset.category || 'all';
  chips.forEach((item) => item.classList.toggle('is-active', item === chip));
  filterArticles();
}));
</script>
