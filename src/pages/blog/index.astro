---
import BaseLayout from '@layouts/BaseLayout.astro';
import catalogue from '../../../blog/posts.json';
type BlogPost = {slug:string;title:string;date?:string;tags?:string[];summary?:string;body?:string;cover?:string;coverAlt?:string;author?:string;status?:string;contentType?:string};
const posts:BlogPost[]=(catalogue.posts as BlogPost[]).filter(p=>p.status!=='draft').sort((a,b)=>(b.date||'').localeCompare(a.date||''));
const isEvent=(p:BlogPost)=>p.contentType ? p.contentType === 'events' : /(hackathon|internship|giveaway|contest|challenge|conference|webinar|workshop|summit|devfest|hiring|recruit|scholarship|fellowship|swag|prize|register now|apply now|opportunity|opportunities|competition|bootcamp|meetup|event series|call for|applications open|submission deadline|win \$|win an? |free ticket)/i.test([p.title,...(p.tags||[]),p.summary||''].join(' '));
const techCount=posts.filter(p=>!isEvent(p)).length;
const eventCount=posts.filter(isEvent).length;
const topics=[...new Set(posts.flatMap(p=>p.tags||[]))].sort((a,b)=>a.localeCompare(b));
const featured=posts[0];
---
<BaseLayout title="The B Tecky Journal — Tech insights, events & opportunities" description="Explore practical technology explainers, events, hackathons, internships, challenges and opportunities.">
<main class="journal">
<section class="journal-hero"><div class="container journal-hero-inner"><div class="journal-intro"><p class="eyebrow"><span class="pulse"></span> THE B TECKY JOURNAL</p><h1 class="display">Stay curious.<br><span>Stay in the loop.</span></h1><p class="journal-lede">Useful tech knowledge, fresh ideas and opportunities worth showing up for — all in one place.</p><div class="journal-actions"><a href="#articles" class="journal-primary">Explore the latest <span>↓</span></a><a href="/contact" class="journal-secondary">Suggest a topic ↗</a></div></div><div class="journal-feature"><div class="feature-label">LATEST STORY <span>✳</span></div><a class="feature-cover" href={`/blog/${featured.slug}`}>{featured.cover?<img src={featured.cover} alt={featured.coverAlt||featured.title}/>:<span class="feature-placeholder">B / TECKY</span>}<span class="feature-category">{isEvent(featured)?'EVENTS & OPPORTUNITIES':'TECH INSIGHT'}</span></a><div class="feature-copy"><p>{featured.date||'B TECKY'} · {featured.tags?.[0]||'FEATURED'}</p><h2><a href={`/blog/${featured.slug}`}>{featured.title}</a></h2><a class="feature-link" href={`/blog/${featured.slug}`}>Read the story ↗</a></div></div></div><div class="container journal-stats"><span><b>{techCount}</b> TECH ARTICLES</span><span><b>{eventCount}</b> EVENTS & OPPORTUNITIES</span><span><b>{posts.length}</b> STORIES IN THE LIBRARY</span></div></section>
<section class="container journal-content" id="articles"><div class="journal-heading"><div><p class="eyebrow">FIND YOUR NEXT READ</p><h2 class="display">The library.</h2><p>Choose your lane, search a topic, and find something useful.</p></div><div class="journal-search"><label for="article-search">Search the journal</label><input id="article-search" type="search" placeholder="Search articles, topics, keywords…" autocomplete="off"></div></div>
<div class="type-switch" role="group" aria-label="Choose blog type"><button type="button" class="type-tab is-active" data-type="all"><span>✦</span><span><b>All stories</b><small>{posts.length} articles</small></span></button><button type="button" class="type-tab" data-type="tech"><span>⌘</span><span><b>Tech blogs</b><small>{techCount} explainers & guides</small></span></button><button type="button" class="type-tab" data-type="events"><span>✳</span><span><b>Events & opportunities</b><small>{eventCount} things to explore</small></span></button></div>
<div class="topic-row"><span>FILTER BY TOPIC</span><div class="topic-chips"><button type="button" class="topic-chip is-active" data-topic="all">All topics</button>{topics.map(topic=><button type="button" class="topic-chip" data-topic={topic.toLowerCase()}>{topic}</button>)}</div></div>
<div class="listing-meta"><p id="results-count" aria-live="polite">{posts.length} stories</p><span>NEWEST FIRST ↘</span></div>
<section class="journal-grid" id="post-grid" aria-label="Journal articles">{posts.map((post,index)=><article class="journal-card" data-type={isEvent(post)?'events':'tech'} data-title={(post.title+' '+(post.summary||'')+' '+(post.tags||[]).join(' ')).toLowerCase()} data-tags={(post.tags||[]).join('|').toLowerCase()}><a class="journal-card-image" href={`/blog/${post.slug}`}>{post.cover?<img src={post.cover} alt={post.coverAlt||post.title} loading="lazy"/>:<span class="feature-placeholder">B / TECKY</span>}<span class="card-category">{isEvent(post)?'EVENTS & OPPORTUNITIES':'TECH INSIGHT'}</span><span class="card-number">{String(index+1).padStart(2,'0')}</span></a><div class="journal-card-copy"><p class="journal-card-meta">{post.date||'B TECKY'}{post.tags?.[0]?' · '+post.tags[0]:''}</p><h3><a href={`/blog/${post.slug}`}>{post.title}</a></h3><p class="journal-summary">{post.summary||''}</p><a class="journal-read" href={`/blog/${post.slug}`}>Read article <span>↗</span></a></div></article>)}</section><p class="no-results" id="empty-state" hidden>No stories match those filters. Try another keyword or topic.</p></section>
<section class="journal-bottom"><div class="container journal-bottom-inner"><div><p class="eyebrow">NEVER STOP EXPLORING</p><h2 class="display">Your next big idea<br>starts with a read.</h2></div><a href="/playlists" class="journal-primary">Explore video learning ↗</a></div></section>
</main>
</BaseLayout>
<style>
.journal{overflow:hidden}.journal-hero{background:radial-gradient(ellipse at 80% 25%,rgba(76,105,255,.16),transparent 35%),linear-gradient(135deg,#f5f7ff,#fff 55%,#f8f9ff);padding:72px 0 0}.journal-hero-inner{display:grid;grid-template-columns:1fr .9fr;gap:70px;align-items:center;padding-bottom:65px}.journal-intro h1{font-size:clamp(3.5rem,6.5vw,6rem);line-height:.94;letter-spacing:-.075em;margin:24px 0}.journal-intro h1 span{color:var(--color-brand)}.journal-lede{max-width:540px;color:var(--color-muted);font-size:1.1rem;line-height:1.8}.pulse{width:7px;height:7px;background:#1fbd87;border-radius:50%;box-shadow:0 0 0 5px #dcf7ed}.journal-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}.journal-primary,.journal-secondary{display:inline-flex;align-items:center;gap:18px;padding:14px 18px;border-radius:11px;font-weight:800;font-size:.85rem}.journal-primary{background:var(--color-brand);color:#fff;box-shadow:0 10px 24px #315efb2b}.journal-secondary{border:1px solid var(--color-border);background:#fff}.journal-feature{background:#fff;border:1px solid #e4e9f5;border-radius:22px;padding:15px;box-shadow:0 24px 65px rgba(30,48,95,.1);transform:rotate(1deg)}.feature-label{display:flex;justify-content:space-between;padding:5px 5px 13px;font-size:.62rem;font-weight:900;letter-spacing:.14em;color:#8792a6}.feature-label span{color:var(--color-brand)}.feature-cover{height:230px;position:relative;display:block;border-radius:13px;overflow:hidden;background:linear-gradient(135deg,#dce5ff,#fff0e8)}.feature-cover img{width:100%;height:100%;object-fit:cover}.feature-category,.card-category{position:absolute;left:14px;bottom:14px;background:#fff;color:var(--color-brand);border-radius:7px;padding:7px 9px;font-size:.55rem;font-weight:900;letter-spacing:.08em}.feature-placeholder{height:100%;display:grid;place-items:center;color:#315efb;font:900 3rem var(--font-display)}.feature-copy{padding:17px 7px 8px}.feature-copy>p,.journal-card-meta{font-size:.68rem;color:#8792a6;font-weight:700}.feature-copy h2{font:700 1.35rem/1.2 var(--font-display);letter-spacing:-.04em;margin:10px 0}.feature-link{color:var(--color-brand);font-size:.8rem;font-weight:800}.journal-stats{border-top:1px solid #e4e9f5;display:flex;gap:55px;flex-wrap:wrap;padding:20px 0;color:#8390a6;font-size:.62rem;letter-spacing:.13em;font-weight:900}.journal-stats b{color:#24365c;margin-right:6px}.journal-content{padding-block:90px 110px}.journal-heading{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:35px}.journal-heading h2{font-size:clamp(2.8rem,5vw,4.4rem);letter-spacing:-.07em;line-height:1;margin:13px 0}.journal-heading>div:first-child>p:last-child{color:var(--color-muted)}.journal-search{width:min(360px,100%)}.journal-search label{display:block;font-size:.72rem;font-weight:800;margin-bottom:8px}.journal-search input{width:100%;padding:14px 15px;border:1px solid var(--color-border);border-radius:11px;background:#fff;outline-offset:3px}.type-switch{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:28px}.type-tab{display:flex;align-items:center;gap:14px;text-align:left;padding:17px;border:1px solid var(--color-border);border-radius:14px;background:white;cursor:pointer;transition:.2s}.type-tab>span:first-child{width:42px;height:42px;border-radius:12px;background:#eef2ff;color:var(--color-brand);display:grid;place-items:center;font-size:1.1rem}.type-tab b,.type-tab small{display:block}.type-tab b{font-size:.88rem}.type-tab small{font-size:.7rem;color:var(--color-muted);margin-top:4px}.type-tab.is-active{border-color:#9db1ff;background:#f7f8ff;box-shadow:0 8px 24px #315efb12}.topic-row{padding:18px 0;border-block:1px solid var(--color-border);display:flex;gap:20px;align-items:flex-start}.topic-row>span{white-space:nowrap;font-size:.6rem;letter-spacing:.12em;font-weight:900;color:#8a95a8;padding-top:10px}.topic-chips{display:flex;gap:8px;flex-wrap:wrap}.topic-chip{border:1px solid var(--color-border);border-radius:999px;padding:8px 12px;background:white;font-size:.72rem;font-weight:700;color:#566176;cursor:pointer}.topic-chip.is-active,.topic-chip:hover{background:#101828;color:#fff;border-color:#101828}.listing-meta{display:flex;justify-content:space-between;align-items:center;padding:22px 0 15px}.listing-meta p{font-size:.85rem;font-weight:800}.listing-meta span{font-size:.6rem;letter-spacing:.13em;color:#8a95a8;font-weight:900}.journal-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.journal-card{border:1px solid #e6eaf2;border-radius:18px;overflow:hidden;background:white;display:flex;flex-direction:column;min-width:0;transition:transform .2s,box-shadow .2s}.journal-card:hover{transform:translateY(-4px);box-shadow:0 18px 42px rgba(25,42,80,.09)}.journal-card[hidden]{display:none}.journal-card-image{height:195px;position:relative;display:block;background:linear-gradient(135deg,#e7edff,#fff1e9);overflow:hidden}.journal-card-image img{width:100%;height:100%;object-fit:cover;transition:transform .35s}.journal-card:hover .journal-card-image img{transform:scale(1.04)}.card-category{bottom:auto;top:13px}.card-number{position:absolute;right:14px;bottom:12px;color:#fff;text-shadow:0 1px 5px #0008;font:800 1.2rem var(--font-display)}.journal-card-copy{padding:20px;display:flex;flex-direction:column;flex:1}.journal-card-copy h3{font:700 1.18rem/1.25 var(--font-display);letter-spacing:-.04em;margin:10px 0}.journal-summary{font-size:.84rem;line-height:1.65;color:var(--color-muted);display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.journal-read{display:flex;justify-content:space-between;margin-top:auto;padding-top:18px;color:var(--color-brand);font-size:.78rem;font-weight:900}.no-results{text-align:center;padding:55px;color:var(--color-muted)}.journal-bottom{background:#101828;color:white;padding:65px 0}.journal-bottom-inner{display:flex;justify-content:space-between;align-items:center;gap:25px}.journal-bottom h2{font-size:clamp(2.2rem,4vw,3.6rem);line-height:1;margin:14px 0;letter-spacing:-.06em}.journal-bottom .eyebrow{color:#9fb5ff}
@media(max-width:900px){.journal-hero-inner{gap:30px}.journal-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.journal-stats{gap:25px}}
@media(max-width:650px){.journal-hero{padding-top:54px}.journal-hero-inner{grid-template-columns:1fr;gap:35px;padding-bottom:40px}.journal-intro h1{font-size:clamp(3.5rem,15vw,5rem)}.feature-cover{height:190px}.journal-stats{gap:12px 22px}.journal-content{padding-block:65px 75px}.journal-heading{align-items:stretch;flex-direction:column}.type-switch{grid-template-columns:1fr;gap:8px}.type-tab{padding:12px}.topic-row{flex-direction:column;gap:10px}.journal-grid{grid-template-columns:1fr}.journal-card-image{height:210px}.journal-bottom-inner{align-items:flex-start;flex-direction:column}}
</style>
<script>
const search=document.querySelector<HTMLInputElement>('#article-search');
const cards=Array.from(document.querySelectorAll<HTMLElement>('.journal-card'));
const typeTabs=Array.from(document.querySelectorAll<HTMLButtonElement>('.type-tab'));
const topicChips=Array.from(document.querySelectorAll<HTMLButtonElement>('.topic-chip'));
const count=document.querySelector<HTMLElement>('#results-count');
const empty=document.querySelector<HTMLElement>('#empty-state');
let activeType='all',activeTopic='all';
const params=new URLSearchParams(window.location.search);
const requestedType=params.get('type');
if(requestedType==='tech'||requestedType==='events') activeType=requestedType;
function syncTabs(){typeTabs.forEach(tab=>tab.classList.toggle('is-active',tab.dataset.type===activeType));topicChips.forEach(chip=>chip.classList.toggle('is-active',chip.dataset.topic===activeTopic));}
function filterPosts(){const term=(search?.value||'').trim().toLowerCase();let visible=0;for(const card of cards){const matchText=(card.dataset.title||'').includes(term);const matchType=activeType==='all'||card.dataset.type===activeType;const tags=(card.dataset.tags||'').split('|');const matchTopic=activeTopic==='all'||tags.includes(activeTopic);const show=matchText&&matchType&&matchTopic;card.hidden=!show;if(show)visible++;}if(count)count.textContent=visible+(visible===1?' story':' stories');if(empty)empty.hidden=visible!==0;}
typeTabs.forEach(tab=>tab.addEventListener('click',()=>{activeType=tab.dataset.type||'all';syncTabs();filterPosts();const url=new URL(window.location.href);if(activeType==='all')url.searchParams.delete('type');else url.searchParams.set('type',activeType);history.replaceState({},'',url);}));
topicChips.forEach(chip=>chip.addEventListener('click',()=>{activeTopic=chip.dataset.topic||'all';syncTabs();filterPosts();}));
search?.addEventListener('input',filterPosts);
syncTabs();filterPosts();
</script>