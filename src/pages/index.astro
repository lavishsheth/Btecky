---
import BaseLayout from '@layouts/BaseLayout.astro';
import catalogue from '../../blog/posts.json';
type Post = {slug:string;title:string;date?:string;tags?:string[];summary?:string;cover?:string;coverAlt?:string;videoThumbnail?:string;status?:string;contentType?:string;videoUrl?:string};
const posts: Post[] = (catalogue.posts as Post[]).filter(p=>p.status!=='draft').sort((a,b)=>(b.date||'').localeCompare(a.date||''));
const isEvent = (p:Post) => p.contentType ? p.contentType === 'events' : /(hackathon|internship|giveaway|contest|challenge|conference|webinar|workshop|summit|devfest|hiring|recruit|scholarship|fellowship|swag|prize|register now|apply now|opportunity|opportunities|competition|bootcamp|meetup|event series|call for|applications open|submission deadline|win \$|win an? |free ticket)/i.test([p.title,...(p.tags||[]),p.summary||''].join(' '));
const latest=posts.slice(0,3);
const cardLabel=(p:Post)=>isEvent(p)?'EVENTS & OPPORTUNITIES':'TECH INSIGHT';
const thumbnail=(p:Post)=>p.videoThumbnail || p.cover || '';
---
<BaseLayout title="B Tecky — Build useful things. Learn what matters." description="Explore practical technology guides, developer tools, learning resources and community opportunities from B Tecky.">
<main class="home-page">
<section class="hero"><div class="container hero-grid"><div class="hero-copy"><p class="eyebrow"><span class="live-dot"></span> INDEPENDENT TECH · PRODUCTS · LEARNING</p><h1 class="display">Make technology<br><span>work for you.</span></h1><p class="hero-intro">Tools that solve real problems. Guides that make complex ideas clearer. Opportunities that help curious builders move forward.</p><div class="hero-actions"><a class="button button-primary" href="#explore">Explore B Tecky <span>↗</span></a><a class="button button-quiet" href="/blog">Discover the blog</a></div><div class="hero-proof"><span>✦</span> Practical by design. Curious by nature.</div></div><div class="hero-visual"><div class="visual-glow"></div><div class="visual-orbit orbit-a"></div><div class="visual-orbit orbit-b"></div><div class="visual-panel panel-main"><div class="panel-top"><span class="brand-mini">B.</span><span>BUILD / LEARN / GROW</span><span class="panel-status">● LIVE</span></div><div class="panel-title">Ideas into<br><em>impact.</em></div><div class="panel-bottom"><span>01 — EXPLORE</span><span>02 — CREATE</span><span>03 — IMPROVE</span></div><div class="panel-progress"><i></i></div></div><div class="floating-note note-one"><span>01 / TOOLS</span><strong>Make it<br>useful.</strong></div><div class="floating-note note-two"><span>02 / LEARNING</span><strong>Keep getting<br>better.</strong></div><div class="visual-spark spark-one">✳</div><div class="visual-spark spark-two">✦</div></div></div><div class="container hero-bottom"><span>THOUGHTFUL DIGITAL PRODUCTS</span><span>●</span><span>REAL-WORLD LEARNING</span><span>●</span><span>COMMUNITY OPPORTUNITIES</span></div></section>
<section class="numbers container"><div><strong>{posts.length}+</strong><span>published guides & stories</span></div><div><strong>02</strong><span>ways to explore the blog</span></div><div><strong>24/7</strong><span>free tools & resources</span></div><div class="numbers-note">A growing library, built for people who like to make things happen.</div></section>
<section id="explore" class="explore-section container"><div class="section-top"><div><p class="eyebrow">THE B TECKY ECOSYSTEM</p><h2 class="display">A better starting point<br>for your next idea.</h2></div><p>Whether you're building, learning or looking for your next opportunity, start here.</p></div><div class="ecosystem-grid">
<a class="eco-card eco-feature" href="/arcade"><div class="eco-visual arcade-visual"><span class="visual-index">01 / PROGRESS TRACKING</span><div class="score-window"><small>YOUR PROGRESS</small><b>+128</b><span>POINTS TRACKED <i>↗</i></span><div class="score-bars"><i></i><i></i><i></i><i></i><i></i><i></i></div></div></div><div class="eco-copy"><span class="eco-tag">ARCADE TOOL</span><h3>Arcade Score Checker</h3><p>Check your Google Cloud Arcade progress, points, milestones and rank using the latest supported report.</p><span class="text-link">Open the score checker ↗</span></div></a>
<a class="eco-card" href="/arcade-calculator.html"><div class="eco-visual calc-visual"><span class="visual-index">02 / FULL POINTS TOOL</span><div class="calc-window"><span>SEASON TOTAL</span><strong>Points + bonuses</strong><b>Prize-tier progress ↗</b><hr/><span>FULL ARCADE CALCULATOR</span></div></div><div class="eco-copy"><span class="eco-tag">FULL POINTS CALCULATOR</span><h3>Arcade Points Calculator</h3><p>Combine games, skill badges and eligible bonuses to estimate your full season total and progress towards prize tiers.</p><span class="text-link">Open the full calculator ↗</span></div></a>
<a class="eco-card" href="/playlists"><div class="eco-visual video-visual"><span class="visual-index">03 / VIDEO LEARNING</span><div class="play-orb"><span>▶</span></div><div class="video-lines"><i></i><i></i><i></i></div></div><div class="eco-copy"><span class="eco-tag">B TECKY LEARNING</span><h3>Learning Playlists</h3><p>Follow curated video paths for cloud, AI, developer tools and practical technology, alongside the wider B Tecky blog.</p><span class="text-link">Browse playlists ↗</span></div></a>
</div></section>
<section class="editorial-section"><div class="container"><div class="section-top"><div><p class="eyebrow">FRESH FROM THE LIBRARY</p><h2 class="display">Ideas worth<br><span>your time.</span></h2></div><a class="section-link" href="/blog">Explore all articles ↗</a></div><div class="story-grid">{latest.map((post)=><article class="story-card"><a class="story-image" href={`/blog/${post.slug}`}>{thumbnail(post)?<><img class="home-story-thumb" src={thumbnail(post)} alt={post.coverAlt||post.title} loading="lazy"/><span class="image-placeholder" aria-hidden="true">B / TECKY</span></>:<span class="image-placeholder">B / TECKY</span>}<span class="story-type">{cardLabel(post)}</span></a><div class="story-copy"><p class="story-meta">{post.date||'B Tecky'}{post.tags?.[0]?' · '+post.tags[0]:''}</p><h3><a href={`/blog/${post.slug}`}>{post.title}</a></h3><p>{(post.summary||'').slice(0,150)}{(post.summary||'').length>150?'…':''}</p><a class="text-link" href={`/blog/${post.slug}`}>Read story ↗</a></div></article>)}</div><div class="journal-categories" aria-label="Explore blog formats">
<a class="journal-category journal-written" href="/blog?type=written"><span>01 / READ & LEARN</span><h3>Written blogs</h3><p>In-depth explainers, practical tutorials and step-by-step guides across technology.</p><b>Explore written blogs ↗</b></a>
<a class="journal-category journal-video" href="/blog?type=video"><span>02 / WATCH & DISCOVER</span><h3>Video blogs</h3><p>Walkthroughs, opportunity breakdowns, event updates and hands-on videos.</p><b>Explore video blogs ↗</b></a>
</div></div></section>
<section class="home-partnerships container" id="partnerships"><div class="home-partnership-intro"><p class="eyebrow">BUILD WITH B TECKY</p><h2 class="display">Good ideas grow<br>through collaboration.</h2><p>We welcome thoughtful collaborations with technology companies, product teams, developer communities, learning platforms and brands that want to create useful experiences for their audiences.</p><div class="home-partnership-actions"><a class="button button-primary" href="/contact">Start a conversation ↗</a><a class="button button-quiet" href="mailto:lavishsheth122@gmail.com?subject=B%20Tecky%20Partnership%20Enquiry">Email about a partnership ↗</a></div></div><div class="home-partner-content"><p class="eyebrow">OUR ECOSYSTEM</p><div class="home-partner-grid">
<a href="https://be10x.com/" target="_blank" rel="noopener noreferrer"><img src="https://www.google.com/s2/favicons?domain=be10x.com&sz=128" alt="be10x logo" loading="lazy"><b>be10x</b><small>Collaboration</small></a>
<a href="https://www.nvidia.com/" target="_blank" rel="noopener noreferrer"><img src="https://cdn.simpleicons.org/nvidia" alt="NVIDIA logo" loading="lazy"><b>NVIDIA</b><small>Collaboration / content</small></a>
<a href="https://hack2skill.com/" target="_blank" rel="noopener noreferrer"><img src="https://www.google.com/s2/favicons?domain=hack2skill.com&sz=128" alt="Hack2Skill logo" loading="lazy"><b>Hack2Skill</b><small>Technology ecosystem</small></a>
<a href="https://www.scaler.com/" target="_blank" rel="noopener noreferrer"><img src="https://www.google.com/s2/favicons?domain=scaler.com&sz=128" alt="Scaler logo" loading="lazy"><b>Scaler</b><small>Learning ecosystem</small></a>
<a href="https://www.masaischool.com/" target="_blank" rel="noopener noreferrer"><img src="https://www.google.com/s2/favicons?domain=masaischool.com&sz=128" alt="Masai School logo" loading="lazy"><b>Masai School</b><small>Learning ecosystem</small></a>
<a href="https://www.codingninjas.com/" target="_blank" rel="noopener noreferrer"><img src="https://www.google.com/s2/favicons?domain=codingninjas.com&sz=128" alt="Coding Ninjas logo" loading="lazy"><b>Coding Ninjas</b><small>Learning ecosystem</small></a>
</div><p class="home-partner-disclaimer">Brand names and logos belong to their respective owners. Inclusion does not imply endorsement, sponsorship or a formal commercial partnership unless specifically stated.</p></div></section>
</main>
<script>
document.querySelectorAll<HTMLImageElement>('.home-story-thumb').forEach(img=>img.addEventListener('error',()=>{img.hidden=true;}));
</script>
</BaseLayout>
