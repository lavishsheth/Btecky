---
import BaseLayout from '@layouts/BaseLayout.astro';
import { assertValidLearnLabCatalogue } from '../../../data/learn/catalogue';
import { learnRegistry } from '../../../data/learn/registry';
import { learningCategories } from '../../../data/learn/categories';

assertValidLearnLabCatalogue();
const courses = [...learnRegistry.courseContent].sort((a, b) => a.title.localeCompare(b.title));
const publishedCategories = learningCategories.filter((category) => courses.some((course) => course.categoryId === category.id));
---
<BaseLayout title="Explore courses — B Tecky LearnLab" description="Browse free, practical technology courses from B Tecky LearnLab. Search topics, compare levels and explore course curricula.">
<main class="discovery-page">
  <div class="discovery-wrap">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/learn/">LearnLab</a><span>/</span><span>All courses</span></nav>
    <header class="discovery-hero"><p class="eyebrow">LEARN SOMETHING NEW</p><h1>Find your next <em>skill.</em></h1><p>Explore individual courses, follow your curiosity and learn at your own pace. Every published course includes a clear curriculum, learning outcomes and practical work.</p><div class="discovery-count"><b>{courses.length}</b> published {courses.length===1?'course':'courses'} <i></i> <b>{publishedCategories.length}</b> active {publishedCategories.length===1?'category':'categories'}</div></header>
    <section class="discovery-tools" aria-label="Course search and filters">
      <label class="search-box"><span aria-hidden="true">⌕</span><input id="course-search" type="search" placeholder="Search courses, topics or skills..." aria-label="Search courses" /><kbd>/</kbd></label>
      <div class="filter-row" role="group" aria-label="Filter by category"><button type="button" class="active" data-filter="all" aria-pressed="true">All courses</button>{publishedCategories.map((category)=><button type="button" data-filter={category.id} aria-pressed="false">{category.title}</button>)}</div>
      <div class="filter-row filter-row--level" role="group" aria-label="Filter by level"><span>Level</span><button type="button" class="active" data-level="all" aria-pressed="true">All levels</button><button type="button" data-level="Beginner" aria-pressed="false">Beginner</button><button type="button" data-level="Intermediate" aria-pressed="false">Intermediate</button><button type="button" data-level="Advanced" aria-pressed="false">Advanced</button></div>
    </section>
    <section class="course-results" aria-live="polite"><div class="results-heading"><h2>Available courses</h2><span id="result-count">{courses.length} results</span></div>
      <div class="course-grid" id="course-grid">
      {courses.map((course)=><a class="course-card" href={'/learn/'+course.slug+'/'} data-course-card data-category={course.categoryId} data-level={course.level} data-search={(course.title+' '+course.category+' '+course.summary+' '+course.description+' '+course.outcomes.join(' ')).toLowerCase()}>
        <div class="card-top"><span class="course-icon">{course.categoryId==='web-development'?'&lt;/&gt;':'⌘'}</span><span class="level">{course.level}</span></div><span class="category">{course.category}</span><h3>{course.title}</h3><p>{course.summary}</p><div class="course-meta"><span>{course.lessons.length} lessons</span><span>{course.lessons.reduce((sum,lesson)=>sum+lesson.minutes,0)} min</span><b>View curriculum ↗</b></div>
      </a>)}
      </div>
      <p id="empty-state" class="empty-state" hidden>No courses match those filters. Try another search or clear a filter.</p>
    </section>
    <section class="category-directory"><div class="directory-heading"><div><p class="eyebrow">EXPLORE BY SUBJECT</p><h2>Browse categories</h2></div><p>Some subjects are still in development. We'll add courses as their learning material is ready.</p></div><div class="category-grid">{learningCategories.map((category)=>category.status==='published'&&courses.some((course)=>course.categoryId===category.id)?<a class="category-card" href={'/learn/categories/'+category.slug+'/'}><span>AVAILABLE</span><b>{category.title}</b><small>{category.description}</small><i>Explore category ↗</i></a>:<div class="category-card category-card--soon"><span>COMING SOON</span><b>{category.title}</b><small>{category.description}</small><i>Curriculum in development</i></div>)}</div></section>
  </div>
</main>
<script>
const search=document.querySelector<HTMLInputElement>('#course-search');
const cards=[...document.querySelectorAll<HTMLElement>('[data-course-card]')];
const categoryButtons=[...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
const levelButtons=[...document.querySelectorAll<HTMLButtonElement>('[data-level]')];
const count=document.querySelector<HTMLElement>('#result-count');
const empty=document.querySelector<HTMLElement>('#empty-state');
let category='all';let level='all';
function update(){const q=search?.value.trim().toLowerCase()||'';let shown=0;cards.forEach(card=>{const visible=(category==='all'||card.dataset.category===category)&&(level==='all'||card.dataset.level===level)&&(!q||(card.dataset.search||'').includes(q));card.hidden=!visible;if(visible)shown++;});if(count)count.textContent=shown+' '+(shown===1?'result':'results');if(empty)empty.hidden=shown>0;}
function activate(buttons: HTMLButtonElement[],selected: HTMLButtonElement){buttons.forEach((button: HTMLButtonElement)=>{const active=button===selected;button.classList.toggle('active',active);button.setAttribute('aria-pressed',String(active));});}
search?.addEventListener('input',update);
categoryButtons.forEach(button=>button.addEventListener('click',()=>{category=button.dataset.filter||'all';activate(categoryButtons,button);update();}));
levelButtons.forEach(button=>button.addEventListener('click',()=>{level=button.dataset.level||'all';activate(levelButtons,button);update();}));
document.addEventListener('keydown',event=>{if(event.key==='/'&&!['INPUT','TEXTAREA'].includes(document.activeElement?.tagName||'')){event.preventDefault();search?.focus();}});
</script>
</BaseLayout>
<style>
.discovery-page{background:#f8f9fc;min-height:75vh;padding:28px 0 90px;color:#17213b}.discovery-wrap{width:min(1120px,calc(100% - 40px));margin:auto}.crumbs{display:flex;gap:10px;color:#7b8498;font-size:.78rem}.crumbs a{color:#315efb;font-weight:800}.discovery-hero{max-width:760px;padding:65px 0 42px}.eyebrow{font-size:.67rem;color:#315efb;font-weight:900;letter-spacing:.14em}.discovery-hero h1{font-size:clamp(3rem,6vw,5.4rem);letter-spacing:-.075em;line-height:.98;margin:14px 0}.discovery-hero h1 em{font-style:normal;color:#315efb}.discovery-hero>p:not(.eyebrow){max-width:650px;color:#667085;line-height:1.8;font-size:.95rem}.discovery-count{display:flex;align-items:center;gap:8px;margin-top:24px;color:#7c8799;font-size:.75rem}.discovery-count b{color:#17213b}.discovery-count i{width:4px;height:4px;border-radius:50%;background:#aab2c0;margin:0 5px}.discovery-tools{padding:20px;border:1px solid #e5e9f2;border-radius:15px;background:#fff}.search-box{display:flex;align-items:center;gap:10px;height:48px;padding:0 13px;border:1px solid #e1e6f0;border-radius:10px}.search-box>span{font-size:1.3rem;color:#7e8aa0}.search-box input{width:100%;border:0;outline:0;color:#17213b;font-size:.82rem}.search-box kbd{padding:3px 6px;border:1px solid #e5e9f0;border-radius:5px;color:#9aa3b2;font-size:.62rem}.filter-row{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:14px}.filter-row button{padding:8px 12px;border:1px solid #e4e8f0;border-radius:8px;background:#fff;color:#68758a;font-size:.7rem;font-weight:800;cursor:pointer}.filter-row button:hover,.filter-row button.active{border-color:#315efb;background:#edf1ff;color:#315efb}.filter-row--level{padding-top:13px;border-top:1px solid #edf0f5}.filter-row--level>span{font-size:.68rem;color:#8993a5;font-weight:800;margin-right:4px}.course-results{padding-top:43px}.results-heading,.directory-heading{display:flex;align-items:end;justify-content:space-between;gap:25px;margin-bottom:20px}.results-heading h2,.directory-heading h2{margin:0;font-size:1.8rem;letter-spacing:-.05em}.results-heading>span{font-size:.72rem;color:#7b8498}.course-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.course-card{display:flex;flex-direction:column;min-height:255px;padding:22px;border:1px solid #e5e9f2;border-radius:15px;background:#fff;color:inherit;transition:transform .2s,box-shadow .2s,border-color .2s}.course-card:hover{transform:translateY(-4px);border-color:#cbd6ff;box-shadow:0 14px 35px #17213b0c}.course-card[hidden]{display:none}.card-top{display:flex;justify-content:space-between;align-items:center}.course-icon{display:grid;place-items:center;width:42px;height:42px;border-radius:11px;background:#edf1ff;color:#315efb;font:800 .85rem monospace}.level{padding:6px 9px;border-radius:20px;background:#f1f3f8;color:#738097;font-size:.6rem;font-weight:800}.category{margin-top:18px;color:#315efb;font-size:.61rem;font-weight:900;letter-spacing:.1em;text-transform:uppercase}.course-card h3{margin:7px 0;font-size:1.25rem;letter-spacing:-.04em}.course-card>p{margin:0;color:#6d788b;font-size:.77rem;line-height:1.65}.course-meta{display:flex;align-items:center;gap:11px;margin-top:auto;padding-top:18px;color:#8993a5;font-size:.63rem}.course-meta b{margin-left:auto;color:#315efb;font-size:.65rem;white-space:nowrap}.empty-state{padding:25px;text-align:center;border:1px dashed #cfd6e4;border-radius:12px;color:#667085;font-size:.83rem}.category-directory{padding-top:75px}.directory-heading>p{max-width:390px;margin:0;color:#6d788b;font-size:.82rem;line-height:1.7}.directory-heading .eyebrow{margin:0 0 9px}.category-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.category-card{display:flex;flex-direction:column;min-height:165px;padding:18px;border:1px solid #e5e9f2;border-radius:13px;background:#fff;color:inherit}.category-card>span{color:#8993a5;font-size:.56rem;font-weight:900;letter-spacing:.1em}.category-card>b{margin:13px 0 5px;font-size:1rem}.category-card>small{color:#6d788b;font-size:.72rem;line-height:1.6}.category-card>i{margin-top:auto;padding-top:13px;color:#315efb;font-size:.68rem;font-style:normal;font-weight:900}.category-card:hover{border-color:#cbd6ff}.category-card:focus-visible,.course-card:focus-visible{outline:3px solid #315efb;outline-offset:3px}
@media(max-width:850px){.course-grid,.category-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:580px){.discovery-wrap{width:calc(100% - 30px)}.discovery-hero{padding:45px 0 30px}.course-grid,.category-grid{grid-template-columns:1fr}.results-heading,.directory-heading{align-items:flex-start;flex-direction:column}.discovery-tools{padding:13px}.course-card{min-height:220px}}
</style>