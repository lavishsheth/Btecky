---
import BaseLayout from '@layouts/BaseLayout.astro';
import { learnRegistry, validateLearnRegistry } from '../../../../data/learn/registry';
import { courses } from '../../../../data/learn/courses';
const registryErrors = validateLearnRegistry();
if (registryErrors.length) throw new Error(registryErrors.join('; '));
export function getStaticPaths() {
  return learnRegistry.paths.map((path) => ({ params: { path: path.slug }, props: { path } }));
}
const { path } = Astro.props;
const contentById = new Map(courses.map((course) => [course.id, course]));
const topic = learnRegistry.topics.find((item) => item.id === path.topicId);
const stages = path.stages.map((stage) => ({ ...stage, course: stage.courseId ? contentById.get(stage.courseId) : undefined }));
const availableCount = stages.filter((stage) => stage.availability === 'available' && stage.course).length;
const progressCourseMap = Object.fromEntries(courses.map((course) => [course.id, {
  id: course.id, slug: course.slug,
  lessonIds: course.lessons.map((lesson) => course.id + ':' + lesson.slug),
  lessonSlugs: course.lessons.map((lesson) => lesson.slug),
}]));
const structuredData = {
  '@context': 'https://schema.org', '@type': 'ItemList', name: path.title, description: path.description,
  itemListElement: stages.map((stage, index) => ({ '@type': 'ListItem', position: index + 1, name: stage.title, ...(stage.course ? { url: 'https://www.btecky.tech/learn/' + stage.course.slug + '/' } : {}) })),
};
---
<BaseLayout title={path.title + ' — B Tecky LearnLab'} description={path.description} noindex={availableCount === 0}>
<script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
<script type="application/json" id="learnlab-course-map" set:html={JSON.stringify(progressCourseMap)}></script>
<main class="path-detail-page" data-path-id={path.id}><div class="path-detail-wrap">
<nav class="crumbs" aria-label="Breadcrumb"><a href="/learn/">LearnLab</a><span>/</span><a href="/learn/paths/">Learning paths</a><span>/</span><span>{path.title}</span></nav>
<header class="path-hero"><p class="eyebrow">{topic?.title ?? 'LEARNING PATH'} / GUIDED JOURNEY</p><span class="level">{path.level}</span><h1>{path.title}</h1><p>{path.description}</p><div class="path-meta"><span>{stages.length} stages</span><span>{availableCount} courses available</span><span>Free · Self-paced · No account</span></div>{path.slug === 'web-development' && <a class="project-link" href="/learn/paths/web-development/project/">Open your connected website project ↗</a>}</header>
<section class="path-progress" aria-labelledby="progress-title"><div><div><p class="eyebrow">YOUR JOURNEY</p><h2 id="progress-title">A clear next step, whenever you're ready.</h2></div><span data-path-progress-label>Progress is stored on this device</span></div><div class="progress-track" role="progressbar" aria-label="Learning path progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><i data-path-progress-bar></i></div><p data-path-next>Start with the first available course. You can explore any published course at any time.</p></section>
<ol class="stage-list">{stages.map((stage, index) => <li class="stage-card" data-stage data-course-id={stage.course?.id ?? ''}><span class="stage-number">{String(index + 1).padStart(2, '0')}</span><div class="stage-copy"><span class="stage-state">{stage.availability === 'available' && stage.course ? 'AVAILABLE COURSE' : 'COMING SOON'}</span><h2>{stage.title}</h2><p>{stage.description}</p>{stage.course && <div class="stage-course-meta"><span>{stage.course.lessons.length} lessons</span><span>{stage.course.lessons.reduce((sum, lesson) => sum + lesson.minutes, 0)} minutes</span></div>}</div>{stage.course ? <a class="stage-action" href={'/learn/' + stage.course.slug + '/'} data-stage-action>Explore course ↗</a> : <span class="stage-coming">In development</span>}</li>)}</ol>
<footer class="path-footer"><a href="/learn/paths/">← All learning paths</a><a href="/learn/courses/">Browse individual courses ↗</a></footer>
</div></main>
<script>
  import { readProgress, setLastPath, writeProgress, subscribeToProgress } from '../../../../data/learn/progress';
  const mapElement = document.querySelector<HTMLScriptElement>('#learnlab-course-map');
  const courseMap = JSON.parse(mapElement?.textContent || '{}');
  const pathId = document.querySelector<HTMLElement>('[data-path-id]')?.dataset.pathId || '';
  const stages = [...document.querySelectorAll<HTMLElement>('[data-stage]')];
  const barTrack = document.querySelector<HTMLElement>('.progress-track[role="progressbar"]');
  let progress = readProgress(courseMap);
  if (progress.lastPathId !== pathId) writeProgress(setLastPath(progress, pathId));
  const update = () => {
    progress = readProgress(courseMap);
    let totalLessons = 0;
    let completedLessons = 0;
    let nextStage: HTMLElement | undefined;
    stages.forEach((stage) => {
      const courseId = stage.dataset.courseId || '';
      const course = courseMap[courseId];
      if (!course) return;
      totalLessons += course.lessonIds.length;
      const completed = progress.courses[courseId]?.completedLessonIds ?? [];
      completedLessons += completed.length;
      const action = stage.querySelector<HTMLAnchorElement>('[data-stage-action]');
      const isComplete = completed.length === course.lessonIds.length && course.lessonIds.length > 0;
      stage.classList.toggle('is-complete', isComplete);
      stage.classList.remove('is-next');
      if (action && isComplete) action.textContent = 'Review completed course ↗';
      else if (action && !nextStage) {
        nextStage = stage;
        stage.classList.add('is-next');
        action.textContent = completed.length ? 'Continue course ↗' : 'Start course ↗';
      } else if (action) action.textContent = 'Explore course ↗';
    });
    const percent = totalLessons ? Math.round((completedLessons / totalLessons) * 100) : 0;
    const label = document.querySelector<HTMLElement>('[data-path-progress-label]');
    const bar = document.querySelector<HTMLElement>('[data-path-progress-bar]');
    const next = document.querySelector<HTMLElement>('[data-path-next]');
    if (label) label.textContent = completedLessons + ' of ' + totalLessons + ' lessons complete (' + percent + '%)';
    if (bar) bar.style.width = percent + '%';
    if (barTrack) barTrack.setAttribute('aria-valuenow', String(percent));
    if (next) {
      if (!totalLessons) next.textContent = 'No courses are available in this path yet. Check back as the curriculum is published.';
      else if (nextStage) next.textContent = 'Your suggested next step is ' + (nextStage.querySelector('h2')?.textContent ?? 'the next course') + '. You can still open any available stage.';
      else next.textContent = 'You have completed every currently available course in this path. Congratulations!';
    }
  };
  update();
  const unsubscribe = subscribeToProgress(update);
  window.addEventListener('pagehide', unsubscribe, { once: true });
</script>
</BaseLayout>
<style>
.path-detail-page{min-height:70vh;padding:30px 0 90px;background:#f8f9fc;color:#17213b}.path-detail-wrap{width:min(1000px,calc(100% - 40px));margin:auto}.crumbs{display:flex;gap:10px;flex-wrap:wrap;color:#7b8498;font-size:.78rem}.crumbs a,.path-footer a{color:#315efb;font-weight:800}.path-hero{max-width:760px;padding:58px 0 38px}.eyebrow{margin:0;color:#315efb;font-size:.66rem;font-weight:900;letter-spacing:.13em}.level{display:inline-block;margin-top:18px;padding:6px 10px;border-radius:20px;background:#edf1ff;color:#315efb;font-size:.66rem;font-weight:800}.path-hero h1{margin:17px 0;font-size:clamp(2.8rem,7vw,5rem);letter-spacing:-.07em;line-height:1}.path-hero>p:not(.eyebrow){max-width:680px;color:#667085;line-height:1.8}.path-meta{display:flex;flex-wrap:wrap;gap:17px;margin-top:23px;color:#68738a;font-size:.75rem;font-weight:700}.project-link{display:inline-block;margin-top:22px;color:#315efb;font-size:.8rem;font-weight:900}.path-progress{margin:15px 0 28px;padding:23px;border:1px solid #e2e7f2;border-radius:16px;background:#fff}.path-progress>div:first-child{display:flex;justify-content:space-between;gap:20px;align-items:end}.path-progress h2{margin:8px 0 0;font-size:1.35rem;letter-spacing:-.04em}.path-progress>div:first-child>span{color:#667085;font-size:.7rem}.progress-track{height:7px;margin-top:18px;border-radius:9px;background:#edf0f6;overflow:hidden}.progress-track i{display:block;width:0;height:100%;border-radius:9px;background:#315efb;transition:width .2s}.path-progress>p{margin:10px 0 0;color:#7b8498;font-size:.72rem;line-height:1.6}.stage-list{display:grid;gap:12px;margin:0;padding:0;list-style:none}.stage-card{display:grid;grid-template-columns:48px 1fr auto;gap:18px;align-items:center;padding:23px;border:1px solid #e5e9f2;border-radius:15px;background:#fff}.stage-card.is-next{border-color:#cbd6ff;background:#fbfcff}.stage-card.is-complete .stage-state{color:#16834d}.stage-number{display:grid;place-items:center;width:42px;height:42px;border-radius:12px;background:#edf1ff;color:#315efb;font-size:.8rem;font-weight:900}.stage-copy h2{margin:7px 0;font-size:1.1rem;letter-spacing:-.03em}.stage-copy p{margin:0;color:#68738a;font-size:.78rem;line-height:1.65}.stage-state{color:#315efb;font-size:.58rem;font-weight:900;letter-spacing:.1em}.stage-course-meta{display:flex;gap:15px;margin-top:10px;color:#8993a5;font-size:.65rem}.stage-action{padding:11px 14px;border-radius:9px;background:#315efb;color:#fff;font-size:.7rem;font-weight:900;white-space:nowrap}.stage-coming{color:#8993a5;font-size:.72rem;font-weight:800}.path-footer{display:flex;justify-content:space-between;gap:20px;margin-top:28px;font-size:.78rem}@media(max-width:620px){.path-detail-wrap{width:calc(100% - 30px)}.path-hero{padding:42px 0 28px}.path-progress>div:first-child{display:block}.path-progress>div:first-child>span{display:block;margin-top:10px}.stage-card{grid-template-columns:36px 1fr;gap:13px;padding:17px}.stage-number{width:34px;height:34px}.stage-action,.stage-coming{grid-column:2;justify-self:start}.path-footer{flex-direction:column}}
</style>
