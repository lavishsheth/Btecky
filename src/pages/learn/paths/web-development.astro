---
import BaseLayout from '@layouts/BaseLayout.astro';
import { courses, type Course } from '../../../data/learn/courses';
import '../../../styles/learn-web-development.css';
const stages = ['html','css','javascript'].map((slug,index)=>({course:courses.find((item)=>item.slug===slug),index})).filter((item): item is { course: Course; index: number } => Boolean(item.course));
---
<BaseLayout title="Complete Web Development Path — B Tecky LearnLab" description="Build one real website from HTML structure to CSS design and JavaScript interaction in one connected, cumulative project.">
<main class="web-path"><div class="wrap">
<nav class="crumbs"><a href="/learn/">LearnLab</a><span>/</span><a href="/learn/paths/">Learning paths</a><span>/</span>Web Development</nav>
<header class="hero"><p class="eyebrow">COMPLETE LEARNING PROGRAMME · BEGINNER TO PROJECT READY</p><h1>Build one website.<br><em>From first tag to final interaction.</em></h1><p>Learn HTML, then use the very same project to learn CSS and JavaScript. Your files stay together as you move through every stage. No starting over. No copying your old code into a new editor.</p><div class="hero-meta"><span>3 subject courses</span><span>{stages.reduce((sum,item)=>sum+item.course.lessons.length,0)} guided lessons</span><span>1 cumulative project</span></div><a class="start" href={stages[0]?.course?'/learn/html/'+stages[0].course.lessons[0].slug+'/project/':'/learn/html/'}>Start building your website →</a></header>
<section class="project-flow"><div><p class="eyebrow">ONE PROJECT · THREE STAGES</p><h2>Your website grows with you.</h2><p>Each stage adds a new layer to the same saved project. You can open the individual subject courses at any time, but the recommended route is HTML → CSS → JavaScript.</p></div><div class="stage-list">{stages.map(({course,index})=><article class="stage"><span class="number">0{index+1}</span><div class="stage-body"><small>STAGE 0{index+1} · {course.lessons.length} LESSONS</small><h3>{course.title}</h3><p>{course.summary}</p><div class="stage-actions"><a href={'/learn/'+course.slug+'/'}>View subject course ↗</a><a href={'/learn/'+course.slug+'/'+course.lessons[0].slug+'/project/'}>Open project workspace ↗</a></div></div><b class="output">{index===0?'STRUCTURE':index===1?'DESIGN':'FUNCTIONALITY'}</b></article>)}</div></section>
<section class="continuity"><div><p class="eyebrow">YOUR WORK CARRIES FORWARD</p><h2>One project folder. Three files. One finished website.</h2><p>HTML is your page structure. CSS styles that structure. JavaScript makes those same elements interactive. The workspace keeps index.html, styles.css and script.js together and previews them as one website.</p></div><div class="files"><span>PROJECT FILES</span><b>▤ &nbsp; index.html <i>Structure</i></b><b>▤ &nbsp; styles.css <i>Design</i></b><b>▤ &nbsp; script.js <i>Behaviour</i></div></section>
<section class="subject-links"><p class="eyebrow">LEARN A SUBJECT ON ITS OWN</p><h2>Prefer one topic at a time?</h2><div>{stages.map(({course})=><a href={'/learn/'+course.slug+'/'}><b>{course.title}</b><span>Explore independent course →</span></a>)}</div></section>
</div></main>
</BaseLayout>
