---
import BaseLayout from '@layouts/BaseLayout.astro';
import { learningPaths } from '../../../../../data/learn/paths';
const path = learningPaths.find((item) => item.slug === 'web-development');
---
<BaseLayout title="My Web Development Project — B Tecky LearnLab" description="Build one website across HTML, CSS, JavaScript and React. Save your work locally and download your project.">
<main class="workspace"><div class="wrap">
<nav class="crumb"><a href="/learn/">LearnLab</a><span>/</span><a href="/learn/paths/">Learning paths</a><span>/</span><a href="/learn/paths/">Web development</a><span>/</span><span>My project</span></nav>
<header class="hero"><p class="eyebrow">YOUR CONNECTED LEARNING PROJECT</p><h1>One website.<br/><em>Built step by step.</em></h1><p>Everything you learn across the Web Development path comes together here. Your HTML, CSS and JavaScript work on the same website — and the project is ready to grow into React when that course is available.</p><div class="hero-actions"><button type="button" id="download-project" class="primary">Download my project ↓</button><a href="/learn/playground/" class="secondary">Open example playground ↗</a></div><p class="privacy-note">Your edits are saved in this browser on this device. No account or cloud sync is required.</p></header>
<section class="stage-strip" aria-label="Project learning stages">
{(path?.stages ?? []).map((stage,index)=><div class="stage"><span>0{index+1}</span><b>{stage.title}</b><small>{stage.status==='available'?'Available course':'Course coming soon'}</small></div>)}
</section>
<div class="workspace-grid">
<section class="editor-panel"><div class="panel-heading"><div><p class="eyebrow">PROJECT FILES</p><h2>Code editor</h2></div><span class="saved" id="save-status">Saved locally</span></div>
<div class="file-tabs" role="tablist" aria-label="Project files">
<button type="button" class="file-tab active" data-file="html" role="tab" aria-selected="true">index.html</button>
<button type="button" class="file-tab" data-file="css" role="tab" aria-selected="false">styles.css</button>
<button type="button" class="file-tab" data-file="js" role="tab" aria-selected="false">script.js</button>
<button type="button" class="file-tab" data-file="react" role="tab" aria-selected="false">App.jsx <small>Next</small></button>
</div>
<div class="editor-caption"><span id="file-description">Page structure and content</span><button type="button" id="reset-file">Reset this file</button></div>
<textarea id="code-editor" spellcheck="false" aria-label="Edit project code"></textarea>
<div class="editor-actions"><button type="button" id="run-project" class="primary">▶ Run website</button><button type="button" id="reset-project" class="secondary">Reset all files</button></div>
<p class="editor-hint" id="editor-hint">Edit the HTML, CSS and JavaScript, then run the website to see all changes together.</p>
</section>
<section class="preview-panel"><div class="panel-heading"><div><p class="eyebrow">LIVE WEBSITE</p><h2>Project preview</h2></div><span class="preview-state" id="preview-state">Ready to run</span></div><iframe id="project-preview" title="Your project website preview" sandbox="allow-scripts" srcdoc="<!doctype html><html><body style='font-family:system-ui;padding:32px;color:#26334d'><h1>Your website will appear here</h1><p>Edit your project files and select Run website.</p></body></html>"></iframe><div class="preview-footer"><span>Preview runs in an isolated browser frame.</span><button type="button" id="refresh-preview">Refresh preview ↻</button></div></section>
</div>
<section class="how-it-connects"><p class="eyebrow">HOW YOUR LEARNING CONNECTS</p><h2>Every lesson adds something to this project.</h2><div class="connect-grid"><article><b>During HTML</b><p>Build the content and structure. Your CSS and JavaScript files stay ready for later courses.</p></article><article><b>During CSS</b><p>Style the exact HTML you already created. No rebuilding the page from scratch.</p></article><article><b>During JavaScript</b><p>Add behaviour to the same elements and make your website interactive.</p></article><article><b>During React</b><p>Carry the same product idea forward and evolve the interface into reusable components.</p></article></div></section>
</div></main>
<script>
type ProjectFile = 'html' | 'css' | 'js' | 'react';
const defaults: Record<ProjectFile, string> = {
html:'<!doctype html>\n<html lang="en">\n<head>\n  <meta charset="UTF-8">\n  <meta name="viewport" content="width=device-width, initial-scale=1">\n  <title>My First Project</title>\n  <link rel="stylesheet" href="styles.css">\n</head>\n<body>\n  <header class="site-header">\n    <a class="brand" href="#">My Project</a>\n    <nav><a href="#about">About</a><a href="#contact">Contact</a></nav>\n  </header>\n  <main>\n    <section class="hero">\n      <p class="eyebrow">MY FIRST WEBSITE</p>\n      <h1>Ideas become <span>websites.</span></h1>\n      <p>I am building this website one skill at a time with B Tecky LearnLab.</p>\n      <button id="hello-button" type="button">Say hello</button>\n      <p id="hello-message" aria-live="polite"></p>\n    </section>\n    <section id="about"><h2>About this project</h2><p>This is the same project I will improve as I learn HTML, CSS and JavaScript.</p></section>\n    <section id="contact"><h2>Get in touch</h2><form id="contact-form"><label>Your name <input name="name" required></label><button>Send</button></form></section>\n  </main>\n  <script src="script.js"></scr' + 'ipt>\n</body>\n</html>',
css:'* { box-sizing: border-box; }\nbody { margin: 0; font-family: system-ui, sans-serif; color: #17213b; background: #f7f8fc; }\n.site-header { display:flex; justify-content:space-between; align-items:center; padding:20px max(5vw,24px); background:white; }\n.brand { color:#315efb; font-weight:900; text-decoration:none; }\nnav { display:flex; gap:20px; }\nnav a { color:#59657a; text-decoration:none; }\nmain { max-width:900px; margin:auto; padding:48px 24px; }\n.hero { padding:60px 36px; border-radius:24px; background:#142653; color:white; }\n.eyebrow { color:#9fb4ff; font-size:.75rem; font-weight:800; letter-spacing:.12em; }\nh1 { font-size:clamp(2.5rem,7vw,5rem); line-height:1; letter-spacing:-.06em; }\nh1 span { color:#9fb4ff; }\n.hero p { max-width:560px; line-height:1.7; }\nbutton { border:0; border-radius:9px; padding:12px 18px; background:#315efb; color:white; font-weight:800; cursor:pointer; }\nmain > section:not(.hero) { margin-top:28px; padding:28px; border:1px solid #e3e8f2; border-radius:16px; background:white; }\ninput { display:block; margin:8px 0 14px; padding:10px; border:1px solid #ccd3e1; border-radius:8px; }\n@media(max-width:600px){.site-header{align-items:flex-start;gap:12px;flex-direction:column}.hero{padding:38px 24px}}',
js:"document.querySelector('#hello-button')?.addEventListener('click', () => {\n  document.querySelector('#hello-message').textContent = 'Hello! My website is getting interactive.';\n});\n\ndocument.querySelector('#contact-form')?.addEventListener('submit', (event) => {\n  event.preventDefault();\n  const name = new FormData(event.currentTarget).get('name');\n  document.querySelector('#hello-message').textContent = 'Thanks, ' + name + '! This demo form works in the preview.';\n});",
react:"import { useState } from 'react';\n\nexport default function App() {\n  const [message, setMessage] = useState('Welcome to my project');\n\n  return (\n    <main>\n      <h1>My project, now in React</h1>\n      <p>{message}</p>\n      <button onClick={() => setMessage('My React interface is interactive!')}>\n        Say hello\n      </button>\n    </main>\n  );\n}"
};
const descriptions={html:'Page structure and content',css:'Visual design and responsive layout',js:'Interactions and browser behaviour',react:'React component starter — preview becomes available with the React course'};
const key='btecky.learnlab.web-project.v1';
let files: Record<ProjectFile, string>={...defaults};try{const stored=JSON.parse(localStorage.getItem(key)||'{}');files={...files,...stored}}catch{}
let active: ProjectFile='html';
const editor=document.querySelector<HTMLTextAreaElement>('#code-editor')!;
const tabs=[...document.querySelectorAll<HTMLButtonElement>('[data-file]')];
const status=document.querySelector<HTMLElement>('#save-status')!;
const hint=document.querySelector<HTMLElement>('#editor-hint')!;
const preview=document.querySelector<HTMLIFrameElement>('#project-preview')!;
function save(){try{localStorage.setItem(key,JSON.stringify(files));status.textContent='Saved locally';}catch{status.textContent='Local storage unavailable';}}
function selectFile(name: ProjectFile){active=name;editor.value=files[name];document.querySelector<HTMLElement>('#file-description')!.textContent=descriptions[name];tabs.forEach(tab=>{const on=tab.dataset.file===name;tab.classList.toggle('active',on);tab.setAttribute('aria-selected',String(on));});hint.textContent=name==='react'?'This React starter is included in your project download. The live React runner will be enabled with the React learning stage.':'Edit this file, then run the website to see your changes.';}
function run(){if(active==='react'){hint.textContent='The React starter is saved and downloadable. Complete the React stage when it becomes available to run this file.';return;}const scriptEnd='<'+'/script>';const html=files.html.replace('<link rel="stylesheet" href="styles.css">','<style>'+files.css+'</style>').replace('<script src="script.js">'+scriptEnd,'<script>'+files.js+scriptEnd);preview.srcdoc=html;document.querySelector<HTMLElement>('#preview-state')!.textContent='Preview updated';}
editor.addEventListener('input',()=>{files[active]=editor.value;status.textContent='Unsaved changes';save();});
tabs.forEach(tab=>tab.addEventListener('click',()=>{const file=tab.dataset.file as ProjectFile|undefined;if(file)selectFile(file)}));
document.querySelector<HTMLButtonElement>('#run-project')!.addEventListener('click',run);
document.querySelector<HTMLButtonElement>('#refresh-preview')!.addEventListener('click',run);
document.querySelector<HTMLButtonElement>('#reset-file')!.addEventListener('click',()=>{files[active]=defaults[active];selectFile(active);save();});
document.querySelector<HTMLButtonElement>('#reset-project')!.addEventListener('click',()=>{if(!confirm('Reset all project files to their starter versions?'))return;files={...defaults};selectFile(active);save();run();});
function crc32(bytes: Uint8Array): number{let crc=-1;for(const byte of bytes){crc^=byte;for(let k=0;k<8;k++)crc=(crc>>>1)^((crc&1)?0xedb88320:0);}return (crc^-1)>>>0;}
function zip(filesMap: Record<string,string>): Blob{const enc=new TextEncoder();const local=[],central=[];let offset=0;for(const [name,content] of Object.entries(filesMap)){const n=enc.encode(name),d=enc.encode(content),crc=crc32(d);const lh=new Uint8Array(30+n.length);const lv=new DataView(lh.buffer);lv.setUint32(0,0x04034b50,true);lv.setUint16(4,20,true);lv.setUint32(14,crc,true);lv.setUint32(18,d.length,true);lv.setUint32(22,d.length,true);lv.setUint16(26,n.length,true);lh.set(n,30);local.push(lh,d);const ch=new Uint8Array(46+n.length);const cv=new DataView(ch.buffer);cv.setUint32(0,0x02014b50,true);cv.setUint16(4,20,true);cv.setUint16(6,20,true);cv.setUint32(16,crc,true);cv.setUint32(20,d.length,true);cv.setUint32(24,d.length,true);cv.setUint16(28,n.length,true);cv.setUint32(42,offset,true);ch.set(n,46);central.push(ch);offset+=lh.length+d.length;}const centralSize=central.reduce((s,a)=>s+a.length,0);const end=new Uint8Array(22);const ev=new DataView(end.buffer);ev.setUint32(0,0x06054b50,true);ev.setUint16(8,central.length,true);ev.setUint16(10,central.length,true);ev.setUint32(12,centralSize,true);ev.setUint32(16,offset,true);const parts=[...local,...central,end].map(part=>part.buffer.slice(part.byteOffset,part.byteOffset+part.byteLength) as ArrayBuffer);return new Blob(parts,{type:'application/zip'});}
document.querySelector<HTMLButtonElement>('#download-project')!.addEventListener('click',()=>{const blob=zip({'index.html':files.html,'styles.css':files.css,'script.js':files.js,'src/App.jsx':files.react,'README.md':'# My B Tecky LearnLab project\n\nOpen index.html in a browser to run the HTML, CSS and JavaScript project.\nThe React starter is in src/App.jsx and can be developed further when you set up a React toolchain.\n'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='btecky-web-development-project.zip';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);});
selectFile('html');run();
</script>
</BaseLayout>
<style>
.workspace{background:#f7f8fc;color:#17213b;min-height:80vh;padding:25px 0 90px}.wrap{width:min(1200px,calc(100% - 40px));margin:auto}.crumb{display:flex;gap:9px;flex-wrap:wrap;color:#7c8799;font-size:.75rem}.crumb a{color:#315efb;font-weight:800}.hero{padding:62px 0 38px;max-width:850px}.eyebrow{font-size:.66rem;letter-spacing:.14em;font-weight:900;color:#315efb}.hero h1{font-size:clamp(3rem,6vw,5.2rem);line-height:.98;letter-spacing:-.075em;margin:14px 0}.hero h1 em{color:#315efb;font-style:normal}.hero>p:not(.eyebrow){max-width:720px;color:#667085;line-height:1.8}.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:23px}.primary,.secondary{border:0;border-radius:9px;padding:12px 17px;font-size:.78rem;font-weight:900;cursor:pointer;text-decoration:none}.primary{background:#315efb;color:white}.secondary{background:white;border:1px solid #dfe4ee;color:#315efb}.privacy-note{font-size:.68rem!important;color:#8993a5!important}.stage-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:10px 0 28px}.stage{display:grid;gap:7px;padding:16px;border:1px solid #e3e8f2;border-radius:12px;background:#fff}.stage span{color:#315efb;font-size:.68rem;font-weight:900}.stage b{font-size:.8rem;line-height:1.4}.stage small{color:#8791a3;font-size:.65rem}.workspace-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;align-items:stretch}.editor-panel,.preview-panel{min-width:0;border:1px solid #e3e8f2;border-radius:15px;background:#fff;overflow:hidden}.panel-heading{display:flex;align-items:center;justify-content:space-between;padding:19px 20px}.panel-heading .eyebrow{margin:0 0 5px}.panel-heading h2{margin:0;font-size:1.25rem;letter-spacing:-.04em}.saved,.preview-state{font-size:.65rem;color:#16834d;font-weight:800}.file-tabs{display:flex;overflow-x:auto;gap:3px;padding:0 13px;border-bottom:1px solid #e8ebf2}.file-tab{border:0;background:transparent;padding:12px 10px;color:#788398;font-size:.68rem;white-space:nowrap;cursor:pointer;border-bottom:2px solid transparent}.file-tab.active{color:#315efb;border-color:#315efb;font-weight:900}.file-tab small{font-size:.55rem;color:#9aa3b4}.editor-caption{display:flex;justify-content:space-between;align-items:center;padding:12px 16px;color:#8993a5;font-size:.65rem}.editor-caption button,.preview-footer button{border:0;background:transparent;color:#315efb;font-size:.65rem;font-weight:800;cursor:pointer}#code-editor{display:block;width:100%;height:390px;resize:vertical;border:0;border-top:1px solid #edf0f5;border-bottom:1px solid #edf0f5;outline:0;padding:18px;background:#111c35;color:#e7edff;font:12px/1.75 ui-monospace,SFMono-Regular,Menlo,monospace;tab-size:2;white-space:pre;overflow:auto}.editor-actions{display:flex;gap:9px;padding:14px 16px}.editor-hint{padding:0 16px 15px;margin:0;color:#7b8498;font-size:.67rem;line-height:1.6}.preview-panel iframe{display:block;width:100%;height:490px;border:0;background:white}.preview-footer{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:12px 15px;border-top:1px solid #edf0f5;color:#8993a5;font-size:.62rem}.how-it-connects{padding-top:65px}.how-it-connects h2{font-size:2rem;letter-spacing:-.05em;margin:8px 0 20px}.connect-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.connect-grid article{padding:19px;border:1px solid #e3e8f2;border-radius:12px;background:#fff}.connect-grid b{font-size:.82rem}.connect-grid p{color:#6e798d;font-size:.73rem;line-height:1.7;margin-bottom:0}
@media(max-width:850px){.workspace-grid{grid-template-columns:1fr}.stage-strip,.connect-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:560px){.wrap{width:calc(100% - 28px)}.hero{padding:42px 0 28px}.stage-strip,.connect-grid{grid-template-columns:1fr 1fr}.preview-panel iframe{height:390px}}
</style>