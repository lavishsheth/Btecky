---
import BaseLayout from '@layouts/BaseLayout.astro';
import { learningPaths } from '../../../data/learn/paths';
import { learningCategories } from '../../../data/learn/categories';
import { catalogueCourses, assertValidLearnLabCatalogue } from '../../../data/learn/catalogue';

assertValidLearnLabCatalogue();
const categoriesById = new Map(learningCategories.map((category) => [category.id, category]));
const coursesById = new Map(catalogueCourses.map((course) => [course.id, course]));
const paths = [...learningPaths].sort((a, b) => a.sortOrder - b.sortOrder);
---
<BaseLayout title="Learning paths — B Tecky LearnLab" description="Choose a structured B Tecky LearnLab learning path and follow a clear sequence from foundations to practical skills.">
<main class="paths-page"><div class="paths-wrap"><nav class="crumbs"><a href="/learn/">LearnLab</a><span>/</span>Learning paths</nav><header><p class="eyebrow">LEARN WITH A CLEAR DIRECTION</p><h1>Learning paths</h1><p>Paths connect courses into a sensible sequence. Start with an available course today; upcoming steps are labelled clearly rather than presented as published lessons.</p></header><div class="path-grid">{paths.map((path,i)=><article class="path-card"><span class="path-index">PATH / {String(i+1).padStart(2,'0')}</span><span class="level">{path.level}</span><h2>{path.title}</h2><p>{path.description}</p><small class="path-category">{categoriesById.get(path.categoryId)?.title ?? 'Learning'}</small><ol>{path.stages.map((stage,j)=><li><span>{String(j+1).padStart(2,'0')}</span>{stage.title}{stage.status==='available'&&stage.courseId?<b>Available</b>:<small>Coming soon</small>}</li>)}</ol>{path.stages.some((stage)=>stage.status==='available'&&stage.courseId&&coursesById.has(stage.courseId))?<a href={'/learn/'+coursesById.get(path.stages.find((stage)=>stage.status==='available'&&stage.courseId)?.courseId ?? '')?.slug+'/'}>Start this path ↗</a>:<span class="path-soon">Curriculum in development</span>}</article>)}</div></div></main>
</BaseLayout>
<style>
.paths-page{background:#f8f9fc;min-height:70vh;padding:28px 0 90px;color:#17213b}.paths-wrap{width:min(1100px,calc(100% - 40px));margin:auto}.crumbs{display:flex;gap:10px;color:#7b8498;font-size:.78rem}.crumbs a{color:#315efb;font-weight:800}.paths-page header{padding:65px 0 35px;max-width:700px}.eyebrow{font-size:.68rem;color:#315efb;font-weight:900;letter-spacing:.13em}.paths-page h1{font-size:clamp(3rem,6vw,5rem);letter-spacing:-.07em;margin:12px 0}.paths-page header>p:last-child{color:#667085;line-height:1.8}.path-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.path-card{padding:24px;border:1px solid #e5e9f2;border-radius:16px;background:#fff}.path-index{font-size:.62rem;color:#8993a5;font-weight:900;letter-spacing:.12em}.level{float:right;padding:6px 9px;border-radius:20px;background:#edf1ff;color:#315efb;font-size:.65rem;font-weight:800}.path-card h2{font-size:1.4rem;letter-spacing:-.04em;margin:25px 0 8px}.path-card>p{min-height:80px;color:#667085;font-size:.84rem;line-height:1.7}.path-card ol{list-style:none;padding:0;margin:22px 0;border-top:1px solid #edf0f5}.path-card li{display:grid;grid-template-columns:25px 1fr auto;gap:7px;align-items:center;padding:12px 0;border-bottom:1px solid #edf0f5;font-size:.76rem}.path-card li span{color:#315efb;font-weight:900}.path-card li b,.path-card li small{font-size:.58rem;color:#16834d}.path-card li small{color:#8993a5}.path-card>a{display:inline-block;color:#315efb;font-size:.8rem;font-weight:900}.path-soon{font-size:.76rem;color:#8993a5;font-weight:700}
@media(max-width:850px){.path-grid{grid-template-columns:1fr 1fr}}@media(max-width:600px){.path-grid{grid-template-columns:1fr}.paths-wrap{width:calc(100% - 30px)}.path-card>p{min-height:0}}
</style>
