---
import BaseLayout from '@layouts/BaseLayout.astro';
type PathStep = { title: string; slug?: string; detail?: string };
type LearningPath = { title: string; level: string; description: string; steps: PathStep[]; available: boolean };
const paths: LearningPath[]=[{title:"Web development foundations",level:"Beginner",description:"Understand how the web works, then learn to structure pages and build visual experiences.",steps:[{title:"HTML Foundations",slug:"html",detail:"Structure content and build accessible pages."},{title:"CSS Foundations",slug:"css",detail:"Style layouts, responsive interfaces and visual systems."},{title:"JavaScript Foundations",slug:"javascript",detail:"Add interaction, logic and dynamic behaviour."}],available:true},{title:"Programming fundamentals",level:"Beginner",description:"Build confidence with variables, data, decisions, loops and functions before moving into larger programs.",steps:[{title:"Programming concepts"},{title:"Python foundations"},{title:"Problem solving"}],available:false},{title:"Modern developer workflow",level:"Beginner → Intermediate",description:"Learn the habits and tools that help developers collaborate, test and ship software reliably.",steps:[{title:"Command line basics"},{title:"Git and GitHub"},{title:"Testing and debugging"}],available:false}];
---
<BaseLayout title="Learning paths — B Tecky LearnLab" description="Choose a structured B Tecky LearnLab learning path and follow a clear sequence from foundations to practical skills.">
<main class="paths-page"><div class="paths-wrap"><nav class="crumbs"><a href="/learn/">LearnLab</a><span>/</span>Learning paths</nav><header><p class="eyebrow">LEARN WITH A CLEAR DIRECTION</p><h1>Learning paths</h1><p>The Web Development path combines three independent subject courses in a recommended order. Follow the complete sequence or open any subject course on its own.</p></header><div class="path-grid">{paths.map((path,i)=><article class="path-card"><span class="path-index">PATH / {String(i+1).padStart(2,'0')}</span><span class="level">{path.level}</span><h2>{path.title}</h2><p>{path.description}</p><ol>{path.steps.map((step,j)=><li><span>{String(j+1).padStart(2,'0')}</span><div class="step-copy"><b>{step.title}</b>{step.detail&&<small>{step.detail}</small>}</div>{path.available?<a class="step-link" href={"/learn/"+(step.slug ?? "")+"/"}>Open course ↗</a>:<small>Coming soon</small>}</li>)}</ol>{path.available?<a href="/learn/html/">Start the complete path ↗</a>:<span class="path-soon">Curriculum in development</span>}</article>)}</div></div></main>
</BaseLayout>
<style>
.paths-page{background:#f8f9fc;min-height:70vh;padding:28px 0 90px;color:#17213b}.paths-wrap{width:min(1100px,calc(100% - 40px));margin:auto}.crumbs{display:flex;gap:10px;color:#7b8498;font-size:.78rem}.crumbs a{color:#315efb;font-weight:800}.paths-page header{padding:65px 0 35px;max-width:700px}.eyebrow{font-size:.68rem;color:#315efb;font-weight:900;letter-spacing:.13em}.paths-page h1{font-size:clamp(3rem,6vw,5rem);letter-spacing:-.07em;margin:12px 0}.paths-page header>p:last-child{color:#667085;line-height:1.8}.path-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.path-card{padding:24px;border:1px solid #e5e9f2;border-radius:16px;background:#fff}.path-index{font-size:.62rem;color:#8993a5;font-weight:900;letter-spacing:.12em}.level{float:right;padding:6px 9px;border-radius:20px;background:#edf1ff;color:#315efb;font-size:.65rem;font-weight:800}.path-card h2{font-size:1.4rem;letter-spacing:-.04em;margin:25px 0 8px}.path-card>p{min-height:80px;color:#667085;font-size:.84rem;line-height:1.7}.path-card ol{list-style:none;padding:0;margin:22px 0;border-top:1px solid #edf0f5}.path-card li{display:grid;grid-template-columns:25px minmax(0,1fr) auto;gap:7px;align-items:center;padding:12px 0;border-bottom:1px solid #edf0f5;font-size:.76rem}.path-card li span{color:#315efb;font-weight:900}.path-card li b{font-size:.78rem;color:#17213b}.step-copy{display:grid;gap:4px}.path-card li .step-copy small{font-size:.68rem;color:#7b8498;line-height:1.4}.path-card li .step-link{font-size:.65rem;color:#315efb;font-weight:900;white-space:nowrap}.path-card li small{color:#8993a5}.path-card>a{display:inline-block;color:#315efb;font-size:.8rem;font-weight:900}.path-soon{font-size:.76rem;color:#8993a5;font-weight:700}
@media(max-width:850px){.path-grid{grid-template-columns:1fr 1fr}}@media(max-width:600px){.path-grid{grid-template-columns:1fr}.paths-wrap{width:calc(100% - 30px)}.path-card>p{min-height:0}}
</style>
