---
import BaseLayout from '@layouts/BaseLayout.astro';
---
<BaseLayout title="Code playground — B Tecky LearnLab" description="Experiment with HTML, CSS and JavaScript examples in a safe live browser playground.">
<main class="playground"><div class="wrap"><nav><a href="/learn/">LearnLab</a><span>/</span><span>Code playground</span></nav><header><p class="eyebrow">EXPERIMENT WITHOUT FEAR</p><h1>Write code.<br/><em>See it happen.</em></h1><p>Try small examples, change the code and run it instantly. This playground is separate from your connected course project, so experiments won't overwrite your project files.</p></header><div class="play-grid"><section class="code-panel"><div class="panel-head"><div><p class="eyebrow">LIVE EDITOR</p><h2>HTML, CSS & JavaScript</h2></div><button type="button" id="reset">Reset example</button></div><div class="tabs"><button class="active" data-tab="html">HTML</button><button data-tab="css">CSS</button><button data-tab="js">JavaScript</button></div><label class="sr-only" for="play-code">Example code editor</label><textarea id="play-code" spellcheck="false"></textarea><div class="run-row"><button type="button" id="run">▶ Run code</button><span id="message" aria-live="polite">Ready to experiment</span></div></section><section class="result-panel"><div class="panel-head"><div><p class="eyebrow">BROWSER OUTPUT</p><h2>Result</h2></div><span>Sandboxed preview</span></div><iframe id="result" title="Code playground output" sandbox="allow-scripts" srcdoc="<h1 style='font-family:system-ui;padding:20px'>Your result appears here</h1>"></iframe><div class="result-foot">The preview is isolated from the rest of this website.</div></section></div><section class="try-next"><p class="eyebrow">KEEP BUILDING</p><h2>Ready to work on your full website?</h2><p>Take what you learn here into your persistent Web Development project. Your project keeps its HTML, CSS and JavaScript together across the learning path.</p><a href="/learn/paths/web-development/project/">Open my connected project ↗</a></section></div></main>
<script>
const samples={
html:'<main>\n  <h1>Hello, learner!</h1>\n  <p>Change this HTML and run it.</p>\n  <button id="hello">Click me</button>\n  <p id="output"></p>\n</main>',
css:'body {\n  font-family: system-ui, sans-serif;\n  padding: 32px;\n  background: #f2f5ff;\n  color: #17213b;\n}\nh1 { color: #315efb; }\nbutton {\n  padding: 10px 16px;\n  border: 0;\n  border-radius: 8px;\n  background: #315efb;\n  color: white;\n  cursor: pointer;\n}',
js:"document.querySelector('#hello')?.addEventListener('click', () => {\n  document.querySelector('#output').textContent = 'Your JavaScript is running!';\n});"
};
let active='';const values={...samples};const code=document.querySelector('#play-code');const tabs=[...document.querySelectorAll('[data-tab]')];
function choose(tab){if(active)values[active]=code.value;active=tab;code.value=values[tab];tabs.forEach(item=>item.classList.toggle('active',item.dataset.tab===tab));}
function run(){values[active]=code.value;const doc='<!doctype html><html><head><meta charset="utf-8"><style>'+values.css+'</style></head><body>'+values.html+'<script>'+values.js.split('</script').join('<\\/script')+'<\\/script></body></html>';document.querySelector('#result').srcdoc=doc;document.querySelector('#message').textContent='Code executed in preview';}
tabs.forEach(tab=>tab.addEventListener('click',()=>choose(tab.dataset.tab)));
document.querySelector('#run').addEventListener('click',run);
document.querySelector('#reset').addEventListener('click',()=>{values[active]=samples[active];choose(active);run();});
try{const seed=sessionStorage.getItem('btecky.learnlab.playground.seed.v1');if(seed){values.html=seed;sessionStorage.removeItem('btecky.learnlab.playground.seed.v1');}}catch{}
choose('html');run();
</script>
</BaseLayout>
<style>
.playground{background:#f7f8fc;color:#17213b;min-height:75vh;padding:28px 0 90px}.wrap{width:min(1120px,calc(100% - 40px));margin:auto}.playground nav{display:flex;gap:9px;color:#7b8498;font-size:.76rem}.playground nav a{color:#315efb;font-weight:800}.playground header{max-width:760px;padding:55px 0 35px}.eyebrow{font-size:.66rem;color:#315efb;font-weight:900;letter-spacing:.13em}.playground h1{font-size:clamp(3rem,6vw,5rem);letter-spacing:-.07em;line-height:1;margin:12px 0}.playground h1 em{font-style:normal;color:#315efb}.playground header>p:last-child,.try-next>p:not(.eyebrow){color:#68748a;line-height:1.8}.play-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}.code-panel,.result-panel{min-width:0;border:1px solid #e3e8f2;border-radius:15px;background:#fff;overflow:hidden}.panel-head{display:flex;justify-content:space-between;align-items:center;padding:18px}.panel-head .eyebrow{margin:0 0 5px}.panel-head h2{font-size:1.1rem;margin:0}.panel-head>span{font-size:.65rem;color:#8993a5}.panel-head button{border:0;background:transparent;color:#315efb;font-size:.68rem;font-weight:800;cursor:pointer}.tabs{display:flex;gap:5px;padding:0 14px;border-bottom:1px solid #e8ebf2}.tabs button{padding:11px 14px;border:0;border-bottom:2px solid transparent;background:transparent;color:#778398;font-size:.72rem;cursor:pointer}.tabs button.active{border-color:#315efb;color:#315efb;font-weight:900}#play-code{display:block;width:100%;height:370px;padding:18px;border:0;outline:0;resize:vertical;background:#111c35;color:#e7edff;font:12px/1.8 ui-monospace,monospace}.run-row{display:flex;align-items:center;gap:12px;padding:14px}.run-row button{border:0;border-radius:8px;padding:11px 15px;background:#315efb;color:white;font-size:.75rem;font-weight:900;cursor:pointer}.run-row span{color:#7b8498;font-size:.68rem}#result{display:block;width:100%;height:450px;border:0;background:white}.result-foot{padding:12px 15px;border-top:1px solid #edf0f5;color:#8993a5;font-size:.64rem}.try-next{margin-top:55px;padding:30px;border:1px solid #e3e8f2;border-radius:15px;background:white}.try-next h2{margin:8px 0;font-size:1.7rem;letter-spacing:-.05em}.try-next a{display:inline-block;margin-top:8px;color:#315efb;font-size:.8rem;font-weight:900}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
@media(max-width:800px){.play-grid{grid-template-columns:1fr}}@media(max-width:560px){.wrap{width:calc(100% - 28px)}.playground header{padding:40px 0 25px}}
</style>