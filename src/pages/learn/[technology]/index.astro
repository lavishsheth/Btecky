---
import BaseLayout from '@layouts/BaseLayout.astro';
import { courses } from '../../../data/learn/courses';
export function getStaticPaths() { return courses.map((course) => ({ params: { technology: course.slug }, props: { course } })); }
const { course } = Astro.props;
---
<BaseLayout title={course.title + ' — B Tecky LearnLab'} description={course.description}>
<main class="course-page"><div class="course-wrap">
<nav class="crumbs" aria-label="Breadcrumb"><a href="/learn/">LearnLab</a><span>/</span><span>{course.category}</span><span>/</span><span>{course.title}</span></nav>
<section class="course-hero"><div><p class="eyebrow">B TECKY LEARNLAB / {course.category.toUpperCase()}</p><span class="level">{course.level}</span><h1>{course.title}</h1><p class="lead">{course.description}</p><div class="course-meta"><span>{course.lessons.length} lessons</span><span>About {course.lessons.reduce((sum,lesson)=>sum+lesson.minutes,0)} minutes</span><span>Self-paced</span></div></div><aside class="outcome-card"><span>WHAT YOU'LL LEARN</span><ul>{course.outcomes.map((item)=><li>{item}</li>)}</ul></aside></section>
<section class="course-content"><div><div class="section-title"><p class="eyebrow">THE CURRICULUM</p><h2>Learn step by step</h2><p>Work through the lessons in order. Each lesson includes an explanation, an example, a practical exercise and a short knowledge check.</p></div><a class="course-project-launch" href={"/learn/"+course.slug+"/"+course.lessons[0].slug+"/project/"}>Open the guided project workspace →</a><div class="lesson-list">{course.lessons.map((lesson,index)=><a class="lesson-row" href={'/learn/'+course.slug+'/'+lesson.slug+'/'}><span class="lesson-number">{String(index+1).padStart(2,'0')}</span><span class="lesson-copy"><b>{lesson.title}</b><small>{lesson.summary}</small></span><span class="lesson-time">{lesson.minutes} min</span><span class="lesson-arrow">↗</span></a>)}</div></div>
<aside class="course-side"><div class="side-card"><h3>Before you start</h3><ul>{course.prerequisites.map((item)=><li>{item}</li>)}</ul><p>No account required. Your lesson and project progress is saved in this browser on this device.</p></div><div class="side-card project-card"><span class="eyebrow">PUT IT INTO PRACTICE</span><h3>{course.project.title}</h3><p>{course.project.brief}</p><ul>{course.project.requirements.map((item)=><li>{item}</li>)}</ul></div></aside></section>
</div></main></BaseLayout>
<style>
.course-page{background:#f8f9fc;min-height:70vh;padding:30px 0 90px;color:#17213b}.course-wrap{width:min(1120px,calc(100% - 40px));margin:auto}.crumbs{display:flex;gap:10px;flex-wrap:wrap;color:#7b8498;font-size:.78rem}.crumbs a{color:#315efb;font-weight:700}.course-hero{display:grid;grid-template-columns:1.1fr .9fr;gap:40px;align-items:center;padding:68px 0 55px}.eyebrow{color:#315efb;font-size:.68rem;letter-spacing:.13em;font-weight:900}.level{display:inline-block;margin-top:16px;padding:6px 10px;border-radius:20px;background:#e8edff;color:#315efb;font-size:.7rem;font-weight:800}.course-hero h1{font-size:clamp(2.8rem,6vw,5rem);letter-spacing:-.07em;line-height:.98;margin:18px 0}.lead{max-width:600px;color:#667085;font-size:1.05rem;line-height:1.8}.course-meta{display:flex;gap:18px;flex-wrap:wrap;margin-top:24px;color:#68738a;font-size:.78rem;font-weight:700}.outcome-card,.side-card{background:#fff;border:1px solid #e7eaf2;border-radius:18px;padding:25px;box-shadow:0 12px 40px #17213b08}.outcome-card>span{font-size:.65rem;letter-spacing:.12em;color:#315efb;font-weight:900}.outcome-card ul,.side-card ul{padding-left:19px;margin:17px 0 0}.outcome-card li,.side-card li{padding:5px 0;color:#59657a;font-size:.85rem;line-height:1.6}.course-content{display:grid;grid-template-columns:1.35fr .65fr;gap:34px;align-items:start}.section-title h2{font-size:2.2rem;letter-spacing:-.05em;margin:8px 0}.section-title>p:last-child{max-width:650px;color:#667085;line-height:1.7}.course-project-launch{display:inline-flex;margin:8px 0 16px;color:#315efb;font-size:.82rem;font-weight:900}.lesson-list{margin-top:24px;border-top:1px solid #e1e5ee}.lesson-row{display:grid;grid-template-columns:42px 1fr auto 18px;gap:15px;align-items:center;padding:19px 10px;border-bottom:1px solid #e1e5ee;color:inherit}.lesson-row:hover{background:#fff}.lesson-number{color:#315efb;font-weight:900;font-size:.78rem}.lesson-copy{display:flex;flex-direction:column;gap:5px}.lesson-copy b{font-size:.95rem}.lesson-copy small{font-size:.76rem;color:#7b8498;line-height:1.5}.lesson-time{font-size:.72rem;color:#7b8498;white-space:nowrap}.lesson-arrow{color:#315efb}.course-side{display:grid;gap:16px}.side-card h3{margin:0;font-size:1.1rem}.side-card p{font-size:.78rem;line-height:1.65;color:#778196}.project-card{background:#142653;color:#fff}.project-card p,.project-card li{color:#d1daf0}.project-card .eyebrow{color:#a9bcff}.project-card ul{padding-left:18px}.project-card li{font-size:.75rem}
@media(max-width:820px){.course-hero,.course-content{grid-template-columns:1fr}.course-hero{padding:45px 0}.course-side{grid-template-columns:1fr 1fr}}@media(max-width:600px){.course-wrap{width:calc(100% - 30px)}.course-side{grid-template-columns:1fr}.lesson-row{grid-template-columns:30px 1fr 16px}.lesson-time{display:none}}
</style>
