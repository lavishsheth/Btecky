---
import BaseLayout from '@layouts/BaseLayout.astro';
import { courses } from '../../../../data/learn/courses';

export function getStaticPaths() {
  return courses.flatMap((course) => course.lessons.map((lesson) => ({
    params: { technology: course.slug, lesson: lesson.slug },
    props: { course, lesson, index: course.lessons.findIndex((item) => item.slug === lesson.slug) }
  })));
}

const { course, lesson, index } = Astro.props;
const phases = [
  { title: 'Create the document foundation', goal: 'Build the first valid HTML page for your personal profile project.', task: 'Create a page with a document declaration, language, metadata, title, a main heading and an introduction paragraph.', hints: ['Start with <!doctype html> before the html element.', 'Put charset, viewport and title inside head.', 'Put the visible h1 and p inside body.'], starter: '<!doctype html>\n<html lang="en">\n<head>\n  <meta charset="UTF-8">\n  <meta name="viewport" content="width=device-width, initial-scale=1">\n  <title>My Profile</title>\n</head>\n<body>\n  <!-- Add your profile content here -->\n</body>\n</html>', checks: ['doctype', 'html', 'head', 'body', 'title', 'h1', 'p'] },
  { title: 'Add content and structure', goal: 'Turn the blank profile into a readable introduction with headings and lists.', task: 'Add an About section and an unordered list containing at least three interests.', hints: ['Use h1 once for the page title.', 'Use h2 for the About section heading.', 'Put each interest in its own li inside ul.'], starter: '<!doctype html>\n<html lang="en">\n<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>My Profile</title></head>\n<body>\n  <h1>My Profile</h1>\n  <!-- Add an About section and interests list -->\n</body>\n</html>', checks: ['h1', 'h2', 'ul', 'li', 'p'] },
  { title: 'Connect the page', goal: 'Add useful links and an image with a meaningful text alternative.', task: 'Add one internal or external link with descriptive text and one image with an appropriate alt attribute.', hints: ['Links use the a element with an href attribute.', 'Avoid vague link text such as “click here”.', 'Informative images need descriptive alt text; decorative images use alt="".'], starter: '<!doctype html>\n<html lang="en">\n<head><meta charset="UTF-8"><title>My Profile</title></head>\n<body>\n  <h1>My Profile</h1>\n  <!-- Add a useful link and an image -->\n</body>\n</html>', checks: ['<a ', 'href=', '<img', 'alt='] },
  { title: 'Use semantic page landmarks', goal: 'Make the profile page easier to navigate with meaningful HTML elements.', task: 'Organise the page using header, nav, main and footer. Put the main profile content inside main.', hints: ['Use header for introductory/site content.', 'Use nav for a group of important navigation links.', 'Keep the primary page content inside one main element.'], starter: '<!doctype html>\n<html lang="en">\n<head><meta charset="UTF-8"><title>My Profile</title></head>\n<body>\n  <!-- Add header, nav, main and footer landmarks -->\n</body>\n</html>', checks: ['<header', '<nav', '<main', '</main>', '<footer'] },
  { title: 'Build an accessible contact form', goal: 'Finish the profile project with a clearly labelled contact form.', task: 'Add a form with a labelled name input, an email input and a submit button.', hints: ['Every input needs a label associated using matching for and id values.', 'Use type="email" for an email address field.', 'Use a button with type="submit" to submit the form.'], starter: '<!doctype html>\n<html lang="en">\n<head><meta charset="UTF-8"><title>My Profile</title></head>\n<body>\n  <h1>My Profile</h1>\n  <!-- Add your accessible contact form -->\n</body>\n</html>', checks: ['<form', '<label', 'for=', '<input', 'type="email"', '<button', 'type="submit"'] }
];
const phase = course.slug === 'html' ? (phases[index] || {
  title: 'Project practice: ' + lesson.title,
  goal: 'Apply the concepts from this lesson to your personal profile website.',
  task: lesson.exercise.prompt,
  hints: [...lesson.objectives, ...lesson.exercise.requirements.slice(0, 2)],
  starter: '<!doctype html>\n<html lang="en">\n<head>\n  <meta charset="UTF-8">\n  <meta name="viewport" content="width=device-width, initial-scale=1">\n  <title>My Profile Project</title>\n</head>\n<body>\n  <header><h1>My Profile</h1></header>\n  <main>\n    <!-- Apply the lesson concepts here -->\n  </main>\n</body>\n</html>',
  checks: ['<html', '<head', '<body']
}) : {
  title: 'Project practice: ' + lesson.title,
  goal: 'Apply this lesson to your ' + course.title + ' portfolio project.',
  task: lesson.exercise.prompt,
  hints: [...lesson.objectives, ...lesson.exercise.requirements.slice(0, 2)],
  starter: course.slug === 'css'
    ? '<!doctype html>\n<html lang="en">\n<head>\n<meta charset="UTF-8">\n<title>CSS Portfolio</title>\n<style>\n/* Write your CSS here */\n</style>\n</head>\n<body>\n<h1>My Portfolio</h1>\n<p>Design this page with CSS.</p>\n</body>\n</html>'
    : '<!doctype html>\n<html lang="en">\n<head>\n<meta charset="UTF-8">\n<title>JavaScript Portfolio</title>\n</head>\n<body>\n<h1>My Interactive Portfolio</h1>\n<button id="action" type="button">Try it</button>\n<script>\n// Write your JavaScript here\n</script>\n</body>\n</html>',
  checks: course.slug === 'css' ? ['<style', 'color', 'font-size'] : ['<script', 'addEventListener', 'function']
};
const next = course.lessons[index + 1];
---
<BaseLayout title={phase.title + ' — LearnLab Project Workspace'} description={phase.goal}>
<main class="workspace"><div class="workspace-wrap">
<nav class="crumbs"><a href="/learn/">LearnLab</a><span>/</span><a href={'/learn/'+course.slug+'/'}>{course.title}</a><span>/</span><a href={'/learn/'+course.slug+'/'+lesson.slug+'/'}>{lesson.title}</a><span>/ Project phase {index+1}</span></nav>
<header class="workspace-head"><div><p class="eyebrow">GUIDED PROJECT / PHASE {index+1} OF {course.lessons.length}</p><h1>{phase.title}</h1><p>{phase.goal}</p></div><a class="back-lesson" href={'/learn/'+course.slug+'/'+lesson.slug+'/'}>← Back to lesson</a></header>
<div class="phase-track">{course.lessons.map((item,i)=><a class:list={{current:i===index}} href={'/learn/'+course.slug+'/'+item.slug+'/project/'}><span>{i+1}</span><small>{item.title}</small></a>)}</div>
<div class="workspace-grid">
<section class="brief-panel"><p class="eyebrow">YOUR CHALLENGE</p><h2>{course.project.title}</h2><p>{phase.task}</p><div class="hint-card"><div><b>Need a nudge?</b><span>Reveal hints one at a time. Try to solve each step before opening the next.</span></div><button type="button" data-hint>Show first hint</button><ol data-hints>{phase.hints.map((hint)=><li hidden>{hint}</li>)}</ol></div><div class="check-card"><b>Phase checklist</b><p>Your project carries forward from phase to phase. Checks are learning aids, not a full validator.</p><ul>{phase.checks.map((check)=><li>{check}</li>)}</ul><button type="button" data-check>Check my work</button><p class="check-result" data-check-result aria-live="polite"></p></div><a class="lesson-link" href={'/learn/'+course.slug+'/'+lesson.slug+'/'}>Review the lesson explanation ↗</a></section>
<section class="editor-panel"><div class="editor-top"><div><b>Code editor</b><span>{course.title} · One project file shared across all {course.lessons.length} phases · Saved on this device</span></div><div class="editor-actions"><button type="button" data-reset title="Reset the entire shared project">Reset project</button><button type="button" data-download>↓ Download</button><button type="button" class="run" data-run>▶ Run</button></div></div><label class="sr-only" for="project-code">Write your code</label><div class="editor-shell"><div class="line-gutter" data-line-gutter aria-hidden="true">1</div><textarea id="project-code" spellcheck="false" autocapitalize="off" autocomplete="off" aria-label="Code editor" wrap="off" autocorrect="off"></textarea></div><div class="preview-head"><b>Live preview</b><span>Sandboxed browser preview</span></div><iframe title="Your project preview" sandbox="allow-scripts" data-preview></iframe><p class="preview-note">Your code runs only in this isolated browser preview. It is not uploaded to our server.</p></section>
</div>
<footer class="workspace-footer"><a href={'/learn/'+course.slug+'/'+lesson.slug+'/'}>← Return to lesson</a>{next?<a class="next-phase" href={'/learn/'+course.slug+'/'+next.slug+'/project/'}>Continue to phase {index+2}: {next.title} →</a>:<a class="next-phase" href={'/learn/'+course.slug+'/'}>Review your finished project →</a>}</footer>
</div></main>
<script define:vars={{courseSlug:course.slug,lessonSlug:lesson.slug,starter:phase.starter,checks:phase.checks,index,lessonSlugs:course.lessons.map((item)=>item.slug),totalLessons:course.lessons.length}}>
const editor=document.querySelector('#project-code');
const preview=document.querySelector('[data-preview]');
const gutter=document.querySelector('[data-line-gutter]');
const storageKey='btecky.learnlab.project.v2.'+courseSlug;\nconst progressKey='btecky.learnlab.project.progress.v1.'+courseSlug;\nconst allLessonSlugs=lessonSlugs;
let runTimer;
const updateGutter=()=>{if(!editor||!gutter)return;const count=editor.value.split('\n').length;gutter.textContent=Array.from({length:count},(_,i)=>i+1).join('\n');gutter.scrollTop=editor.scrollTop;};
const run=()=>{if(preview&&editor)preview.srcdoc=editor.value;};
const save=()=>{try{localStorage.setItem(storageKey,editor.value)}catch{}};
try{
  let saved=localStorage.getItem(storageKey);
  if(!saved){
    for(const slug of allLessonSlugs){
      const previous=localStorage.getItem('btecky.learnlab.project.v1.'+courseSlug+'.'+slug);
      if(previous){saved=previous;break;}
    }
  }
  editor.value=saved??starter;
  if(saved){localStorage.setItem(storageKey,editor.value);}
}catch{editor.value=starter;}
updateGutter();
editor?.addEventListener('input',()=>{save();updateGutter();});
editor?.addEventListener('scroll',()=>{if(gutter)gutter.scrollTop=editor.scrollTop;});
editor?.addEventListener('keydown',(event)=>{if(event.key==='Tab'){event.preventDefault();const start=editor.selectionStart,end=editor.selectionEnd;editor.setRangeText('  ',start,end,'end');save();updateGutter();}});
document.querySelector('[data-run]')?.addEventListener('click',run);
document.querySelector('[data-reset]')?.addEventListener('click',()=>{if(!confirm('Reset the entire '+courseSlug.toUpperCase()+' project? This clears work from every phase on this device.'))return;editor.value=starter;save();try{localStorage.removeItem(progressKey)}catch{};updateGutter();run();});\ndocument.querySelector('[data-download]')?.addEventListener('click',()=>{const blob=new Blob([editor.value],{type:'text/html;charset=utf-8'});const url=URL.createObjectURL(blob);const link=document.createElement('a');link.href=url;link.download=courseSlug+'-portfolio-project.html';link.click();URL.revokeObjectURL(url);});
editor?.addEventListener('input',()=>{clearTimeout(runTimer);runTimer=setTimeout(run,900);});
run();
let hintIndex=0;
document.querySelector('[data-hint]')?.addEventListener('click',(event)=>{const hints=[...document.querySelectorAll('[data-hints] li')];if(hintIndex<hints.length){hints[hintIndex].hidden=false;hintIndex++;event.currentTarget.textContent=hintIndex<hints.length?'Show next hint':'All hints shown';}else event.currentTarget.textContent='All hints shown';});
document.querySelector('[data-check]')?.addEventListener('click',()=>{const code=(editor?.value||'').toLowerCase();const missing=checks.filter((item)=>!code.includes(item.toLowerCase()));const result=document.querySelector('[data-check-result]');if(result){
 if(missing.length){result.textContent='Not quite yet. Review: '+missing.join(', ')+'. Use the hints if you need help.';}
 else{
   result.textContent='Phase '+(index+1)+' complete — your work is saved in the shared '+courseSlug.toUpperCase()+' project. Continue to the next lesson to build on this same file.';
   try{const done=new Set(JSON.parse(localStorage.getItem(progressKey)||'[]'));done.add(lessonSlug);localStorage.setItem(progressKey,JSON.stringify([...done]));}catch{}
 }
}});
</script>
</BaseLayout>
<style>
.workspace{min-height:80vh;background:#f5f7fc;color:#17213b;padding:24px 0 70px}.workspace-wrap{width:min(1440px,calc(100% - 40px));margin:auto}.crumbs{display:flex;gap:9px;flex-wrap:wrap;font-size:.75rem;color:#778196}.crumbs a{color:#315efb;font-weight:700}.workspace-head{display:flex;justify-content:space-between;align-items:end;gap:24px;padding:38px 0 25px}.eyebrow{font-size:.65rem;letter-spacing:.13em;color:#315efb;font-weight:900}.workspace-head h1{font-size:clamp(2.1rem,5vw,3.6rem);letter-spacing:-.06em;margin:10px 0}.workspace-head p:not(.eyebrow){color:#68738a;line-height:1.7;max-width:700px}.back-lesson,.lesson-link,.workspace-footer a{color:#315efb;font-weight:800;font-size:.8rem}.phase-track{display:flex;gap:8px;overflow:auto;padding:0 0 22px}.phase-track a{min-width:130px;flex:1;display:flex;align-items:center;gap:9px;padding:10px;border:1px solid #e1e6f0;border-radius:10px;background:#fff;color:#667085}.phase-track a.current{border-color:#315efb;background:#edf2ff;color:#2449c7}.phase-track span{display:grid;place-items:center;width:25px;height:25px;border-radius:50%;background:#eef1f7;font-size:.7rem;font-weight:900}.phase-track small{font-size:.67rem;line-height:1.35;font-weight:700}.workspace-grid{display:grid;grid-template-columns:minmax(270px,.72fr) minmax(0,1.6fr);gap:18px;align-items:start}.brief-panel,.editor-panel{background:#fff;border:1px solid #e4e8f0;border-radius:16px;padding:22px;min-width:0}.brief-panel h2{font-size:1.35rem;letter-spacing:-.04em}.brief-panel>p:not(.eyebrow){font-size:.86rem;color:#657087;line-height:1.75}.hint-card,.check-card{margin-top:20px;padding:16px;border:1px solid #e6eaf2;border-radius:12px;background:#fafbfe}.hint-card>div{display:grid;gap:6px}.hint-card b,.check-card>b{font-size:.85rem}.hint-card span,.check-card p{font-size:.75rem;color:#758096;line-height:1.6}.hint-card button,.check-card button{border:0;border-radius:8px;background:#eaf0ff;color:#2449c7;padding:9px 12px;font-size:.75rem;font-weight:800;cursor:pointer;margin-top:10px}.hint-card ol{padding-left:20px;font-size:.78rem;color:#566278;line-height:1.7}.check-card ul{padding-left:18px;color:#657087;font-size:.74rem;line-height:1.65}.check-result{font-weight:800;color:#2449c7}.editor-top{display:flex;justify-content:space-between;align-items:center;gap:12px;padding-bottom:14px}.editor-top>div:first-child{display:grid;gap:4px}.editor-top b,.preview-head b{font-size:.88rem}.editor-top span,.preview-head span{font-size:.68rem;color:#8791a3}.editor-actions{display:flex;gap:8px}.editor-actions button{border:1px solid #e1e6f0;background:#fff;border-radius:8px;padding:9px 12px;font-size:.75rem;font-weight:800;cursor:pointer}.editor-actions .run{background:#315efb;border-color:#315efb;color:#fff}.editor-shell{display:grid;grid-template-columns:48px minmax(0,1fr);height:390px;overflow:hidden;border:1px solid #273755;border-radius:10px;background:#101b32}.line-gutter{overflow:hidden;white-space:pre;text-align:right;padding:17px 10px;color:#63718c;background:#0c1528;border-right:1px solid #263550;font:13px/1.7 ui-monospace,SFMono-Regular,Menlo,monospace;user-select:none}.editor-shell textarea{display:block;width:100%;height:100%;resize:vertical;border:0;border-radius:0;background:#101b32;color:#e5edff;padding:17px;font:13px/1.7 ui-monospace,SFMono-Regular,Menlo,monospace;tab-size:2;white-space:pre;overflow:auto;outline:none;caret-color:#fff}.editor-shell textarea:focus{box-shadow:inset 0 0 0 1px #6687ff}.editor-shell textarea::selection{background:#315efb66}.preview-head{display:flex;justify-content:space-between;align-items:center;padding:18px 0 10px}.editor-panel iframe{display:block;width:100%;height:290px;border:1px solid #e1e6f0;border-radius:10px;background:#fff}.preview-note{font-size:.68rem;color:#8791a3;line-height:1.6}.workspace-footer{display:flex;justify-content:space-between;gap:15px;margin-top:20px;padding:18px 2px}.next-phase{background:#142653;color:#fff!important;padding:12px 16px;border-radius:9px}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
@media(max-width:800px){.workspace-grid{grid-template-columns:1fr}.workspace-head{align-items:start;flex-direction:column}.phase-track a{min-width:165px}.workspace-footer{flex-direction:column}.next-phase{text-align:center}}@media(max-width:520px){.workspace-wrap{width:calc(100% - 24px)}.brief-panel,.editor-panel{padding:15px}.editor-top{align-items:flex-start;flex-direction:column}.editor-shell{height:330px}}
</style>
