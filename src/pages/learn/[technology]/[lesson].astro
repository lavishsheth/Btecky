---
import BaseLayout from '@layouts/BaseLayout.astro';
import { type Course, type Lesson } from '../../../data/learn/courses';
import { learnRegistry } from '../../../data/learn/registry';
import LessonWorkspace from '../../../components/learn/LessonWorkspace';
const courses = learnRegistry.courseContent;
export function getStaticPaths() { return learnRegistry.courseContent.flatMap((course: Course) => course.lessons.map((lesson: Lesson) => ({ params: { technology: course.slug, lesson: lesson.slug }, props: { course, lesson } }))); }
const { course, lesson } = Astro.props as { course: Course; lesson: Lesson };
const index = course.lessons.findIndex((item: Lesson) => item.slug === lesson.slug);
const previous = course.lessons[index - 1];
const next = course.lessons[index + 1];
const lessonSlugs = course.lessons.map((item: Lesson) => item.slug);
const progressCourseMap = Object.fromEntries(courses.map((item) => [item.id, { id: item.id, slug: item.slug, lessonIds: item.lessons.map((entry) => item.id + ':' + entry.slug), lessonSlugs: item.lessons.map((entry) => entry.slug) }]));
---
<BaseLayout title={lesson.title + ' — ' + course.title + ' | B Tecky LearnLab'} description={lesson.summary} type="article">
<main class="lesson-page" data-course-id={course.id} data-lesson-slug={lesson.slug} data-lesson-index={index} data-total-lessons={course.lessons.length} data-lesson-ids={JSON.stringify(course.lessons.map((item) => course.id + ':' + item.slug))}><div class="lesson-shell">
<nav class="lesson-crumbs" aria-label="Breadcrumb"><a href="/learn/">LearnLab</a><span>/</span><a href={'/learn/'+course.slug+'/'}>{course.title}</a><span>/</span><span>{lesson.title}</span></nav>
<div class="lesson-layout">
<details class="lesson-sidebar"><summary>Course lessons · {course.lessons.length} lessons</summary><a class="back-course" href={'/learn/'+course.slug+'/'}>← Course overview</a><p class="sidebar-label">YOUR CURRICULUM</p><ol>{course.lessons.map((item,i)=><li class:list={{active:item.slug===lesson.slug}} data-sidebar-lesson={item.slug}><a href={'/learn/'+course.slug+'/'+item.slug+'/'}><span>{String(i+1).padStart(2,'0')}</span>{item.title}</a></li>)}</ol><div class="sidebar-progress"><span>YOUR PROGRESS</span><b data-progress-label>0 / {course.lessons.length} complete</b><div class="progress-track" role="progressbar" aria-label="Course lesson completion" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><i data-progress-bar></i></div></div></details>

<article class="lesson-article" data-lesson-content>
<header class="lesson-heading"><p class="eyebrow">{course.title.toUpperCase()} / LESSON {String(index+1).padStart(2,'0')}</p><span class="lesson-duration">{lesson.minutes} MIN READ</span><h1>{lesson.title}</h1><p class="lesson-summary">{lesson.summary}</p><div class="objectives"><b>By the end, you can:</b><ul>{lesson.objectives.map((item)=><li>{item}</li>)}</ul></div><div class="lesson-tools">{course.categoryId==='web-development'&&<a href="/learn/paths/web-development/project/">↗ Continue building your connected project</a>}<a href="/learn/playground/">▶ Try code in the example playground</a></div></header>
{course.slug === 'html' && <LessonWorkspace client:idle lessonId={'html:' + lesson.slug} lessonIndex={index} previousLessonId={previous ? 'html:' + previous.slug : undefined} />}
<details class="lesson-toc"><summary>On this lesson · {lesson.sections.length} sections</summary><nav>{lesson.sections.map((section,i)=><a href={'#section-'+(i+1)}>{section.title}</a>)}<a href="#practice">Practice</a></nav></details><div class="lesson-body">{lesson.sections.map((section,i)=><section id={'section-'+(i+1)}><h2>{section.title}</h2><div class="prose" set:html={section.body}></div>{section.code&&<><pre class="code-sample"><code>{section.code}</code></pre><button type="button" class="run-example" data-run-example>Try this example in the playground ↗</button></>}{section.note&&<aside class="learning-note"><b>Remember</b><p>{section.note}</p></aside>}</section>)}</div>
<section class="exercise" id="practice"><p class="eyebrow">TRY IT YOURSELF</p><h2>Practice: {lesson.title}</h2><p>{lesson.exercise.prompt}</p><ul>{lesson.exercise.requirements.map((item)=><li>{item}</li>)}</ul><details><summary>Show one possible solution</summary><pre class="code-sample"><code>{lesson.exercise.solution}</code></pre><p class="solution-note">There can be more than one correct implementation. Compare the structure and requirements, not just the exact text.</p></details></section>
<section class="knowledge-check" data-quiz><p class="eyebrow">CHECK YOUR UNDERSTANDING</p><h2>Quick knowledge check</h2>{lesson.quiz.map((question,i)=><fieldset class="quiz-question" data-question={i}><legend>{i+1}. {question.question}</legend>{question.options.map((option,j)=><label><input type="radio" name={'q-'+i} value={j}><span>{option}</span></label>)}<div class="quiz-feedback" data-feedback hidden></div><span class="quiz-explanation" hidden>{question.explanation}</span></fieldset>)}<button type="button" class="check-answers" data-check-answers>Check answers</button><p class="quiz-result" data-quiz-result aria-live="polite"></p></section>
<section class="references"><h2>Further reading</h2><ul>{lesson.references.map((ref)=><li><a href={ref.url} target="_blank" rel="noopener noreferrer">{ref.label} ↗</a></li>)}</ul></section>
<div class="lesson-complete"><div><b>Finished this lesson?</b><span>Mark it complete to keep track of your learning on this device.</span></div><button type="button" data-complete-lesson>Mark as complete</button></div>
<nav class="lesson-navigation" aria-label="Lesson navigation">{previous?<a href={'/learn/'+course.slug+'/'+previous.slug+'/'}><small>← PREVIOUS</small><b>{previous.title}</b></a>:<a href={'/learn/'+course.slug+'/'}><small>← COURSE</small><b>Course overview</b></a>}{next?<a class="next-lesson" href={'/learn/'+course.slug+'/'+next.slug+'/'}><small>NEXT LESSON →</small><b>{next.title}</b></a>:<a class="next-lesson" href={'/learn/'+course.slug+'/'}><small>COURSE COMPLETE →</small><b>Review the curriculum</b></a>}</nav>
</article>

</div></div></main>
<script type="application/json" id="learnlab-course-map" set:html={JSON.stringify(progressCourseMap)}></script>
<script type="application/json" id="learnlab-quiz" set:html={JSON.stringify(lesson.quiz)}></script>
<script>
import { readProgress, setLastLesson, markLessonComplete, writeProgress, subscribeToProgress } from '../../../data/learn/progress';

const root = document.querySelector<HTMLElement>('[data-course-id]');
const courseId = root?.dataset.courseId || '';
const lessonSlug = root?.dataset.lessonSlug || '';
const lessonIndex = Number(root?.dataset.lessonIndex || 0);
const total = Number(root?.dataset.totalLessons || 0);
const lessonIds: string[] = JSON.parse(root?.dataset.lessonIds || '[]');
const quizElement = document.querySelector<HTMLScriptElement>('#learnlab-quiz');
const quiz = JSON.parse(quizElement?.textContent || '[]');
const mapElement = document.querySelector<HTMLScriptElement>('#learnlab-course-map');
const courseMap = JSON.parse(mapElement?.textContent || '{}');
const lessonId = courseId + ':' + lessonSlug;
let progress = readProgress(courseMap);
progress = setLastLesson(progress, courseId, lessonId);
writeProgress(progress);

const button = document.querySelector<HTMLButtonElement>('[data-complete-lesson]');
const completed = () => progress.courses[courseId]?.completedLessonIds.includes(lessonId) ?? false;
const updateProgress = () => {
  const items = progress.courses[courseId]?.completedLessonIds ?? [];
  const count = lessonIds.filter((id) => items.includes(id)).length;
  const label = document.querySelector<HTMLElement>('[data-progress-label]');
  const bar = document.querySelector<HTMLElement>('[data-progress-bar]');
  const track = document.querySelector<HTMLElement>('.sidebar-progress .progress-track[role="progressbar"]');
  if (label) label.textContent = count + ' / ' + total + ' complete';
  if (bar) bar.style.width = (total ? Math.min(100, count / total * 100) : 0) + '%';
  if (track) track.setAttribute('aria-valuenow', String(total ? Math.round(count / total * 100) : 0));
};
const updateButton = () => {
  if (!button) return;
  button.textContent = completed() ? 'Completed ✓' : 'Mark as complete';
  button.classList.toggle('is-complete', completed());
  button.disabled = completed();
};
updateButton();
updateProgress();
const unsubscribe = subscribeToProgress(() => { progress = readProgress(courseMap); updateButton(); updateProgress(); });
window.addEventListener('pagehide', unsubscribe, { once: true });

button?.addEventListener('click', () => {
  progress = markLessonComplete(progress, courseId, lessonId, lessonIds);
  if (!writeProgress(progress)) { button.textContent = 'Could not save on this device'; return; }
  updateButton();
  updateProgress();
  const nextLink = document.querySelector<HTMLAnchorElement>('.lesson-navigation .next-lesson');
  if (nextLink) nextLink.classList.add('is-unlocked');
});

document.querySelectorAll<HTMLButtonElement>('[data-run-example]').forEach((runButton) => runButton.addEventListener('click', () => {
  const code = runButton.previousElementSibling?.querySelector('code')?.textContent || '';
  try { sessionStorage.setItem('btecky.learnlab.playground.seed.v1', code); window.location.href = '/learn/playground/'; }
  catch { runButton.textContent = 'Open playground and paste this example'; }
}));

document.querySelector('[data-check-answers]')?.addEventListener('click', () => {
  let score = 0; let answered = 0;
  document.querySelectorAll<HTMLElement>('[data-question]').forEach((field, index) => {
    const selected = field.querySelector<HTMLInputElement>('input:checked');
    const feedback = field.querySelector<HTMLElement>('[data-feedback]');
    const explanation = field.querySelector<HTMLElement>('.quiz-explanation');
    const correct = Number(selected?.value) === quiz[index].answer;
    if (selected) answered++;
    if (correct) score++;
    if (feedback) { feedback.hidden = false; feedback.textContent = selected ? (correct ? 'Correct.' : 'Not quite.') : 'Choose an answer to see feedback.'; feedback.className = 'quiz-feedback ' + (correct ? 'is-correct' : 'is-incorrect'); }
    if (explanation) explanation.hidden = false;
  });
  const result = document.querySelector<HTMLElement>('[data-quiz-result]');
  if (result) result.textContent = 'You got ' + score + ' of ' + quiz.length + ' correct (' + answered + ' answered). Review the explanations and try again.';
});
</script>
</BaseLayout>
<style>
