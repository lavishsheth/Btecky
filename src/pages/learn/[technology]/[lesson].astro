y:block;width:0;height:100%;background:#315efb}.lesson-article{background:#fff;border:1px solid #e8ebf2;border-radius:18px;padding:clamp(24px,4vw,55px);min-width:0;box-shadow:0 14px 45px #17213b06}.lesson-heading{position:relative;border-bottom:1px solid #e9ecf2;padding-bottom:28px}.lesson-heading .eyebrow,.exercise .eyebrow,.knowledge-check .eyebrow{font-size:.65rem;letter-spacing:.12em;color:#315efb;font-weight:900}.lesson-duration{position:absolute;right:0;top:0;font-size:.62rem;color:#8a94a6;font-weight:800}.lesson-heading h1{font-size:clamp(2.3rem,5vw,3.8rem);letter-spacing:-.065em;line-height:1.02;margin:20px 0 12px}.lesson-tools{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}.lesson-tools a{display:inline-flex;align-items:center;padding:10px 13px;border:1px solid #dfe5f2;border-radius:9px;color:#315efb;font-size:.7rem;font-weight:900;text-decoration:none}.lesson-tools a:hover{background:#f2f5ff}.lesson-summary{font-size:1.03rem;line-height:1.75;color:#68738a}.objectives{margin-top:24px;padding:18px 20px;background:#f5f7ff;border-radius:12px}.objectives b{font-size:.8rem}.objectives ul{margin:9px 0 0;padding-left:19px}.objectives li{font-size:.8rem;line-height:1.7;color:#58647a}.lesson-body{padding-top:12px}.lesson-body section{padding-top:28px;scroll-margin-top:25px}.lesson-body h2,.exercise h2,.knowledge-check h2,.references h2{font-size:1.55rem;letter-spacing:-.04em;margin:0 0 13px}.prose{color:#4e5b70;font-size:.94rem;line-height:1.9}.prose code{padding:2px 5px;border-radius:5px;background:#f0f2f7;color:#2449c7;font-size:.88em}.run-example{border:0;background:transparent;color:#315efb;font-size:.7rem;font-weight:900;cursor:pointer;padding:0;margin-top:-7px}.code-sample{overflow-x:auto;background:#111c35;color:#e7edff;padding:19px;border-radius:12px;font-size:.78rem;line-height:1.75;margin:17px 0;tab-size:2}.code-sample code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;white-space:pre}.learning-note{margin-top:17px;padding:15px 17px;border-left:3px solid #315efb;background:#f3f6ff;border-radius:0 10px 10px 0}.learning-note b{font-size:.78rem;color:#2449c7}.learning-note p{margin:5px 0 0;color:#58647a;font-size:.82rem;line-height:1.7}.exercise,.knowledge-check{margin-top:36px;padding:24px;border:1px solid #e5e9f1;border-radius:14px;background:#fbfcff}.exercise>p:not(.eyebrow){color:#566278;line-height:1.7;font-size:.9rem}.exercise ul{padding-left:20px;color:#566278;font-size:.83rem;line-height:1.8}.exercise details{margin-top:15px}.exercise summary{cursor:pointer;color:#315efb;font-size:.83rem;font-weight:800}.solution-note{font-size:.75rem;color:#7b8498}.quiz-question{border:0;border-top:1px solid #e8ebf2;padding:18px 0 8px;margin:0}.quiz-question legend{font-size:.88rem;font-weight:800;line-height:1.6;padding:0 0 10px}.quiz-question label{display:flex;gap:10px;align-items:flex-start;padding:9px 11px;margin:5px 0;border:1px solid #e7eaf1;border-radius:9px;font-size:.82rem;color:#58647a;cursor:pointer}.quiz-question input{accent-color:#315efb;margin-top:3px}.quiz-feedback{margin-top:8px;font-size:.77rem;font-weight:800}.is-correct{color:#16834d}.is-incorrect{color:#b54735}.quiz-explanation{display:block;margin-top:5px;font-size:.76rem;color:#68738a;line-height:1.6}.check-answers,.lesson-complete button{border:0;border-radius:9px;background:#315efb;color:#fff;padding:12px 16px;font-weight:800;font-size:.8rem;cursor:pointer}.quiz-result{font-size:.8rem;font-weight:700;color:#2449c7}.references{padding:30px 0}.references ul{padding-left:20px;line-height:2}.references a{color:#315efb;font-size:.82rem}.lesson-complete{display:flex;justify-content:space-between;align-items:center;gap:18px;padding:20px;border-radius:13px;background:#142653;color:#fff}.lesson-complete div{display:grid;gap:5px}.lesson-complete b{font-size:.9rem}.lesson-complete span{font-size:.74rem;color:#d1daf0;line-height:1.5}.lesson-complete button.is-complete{background:#18794e}.lesson-navigation{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:22px}.lesson-navigation a{display:grid;gap:7px;padding:16px;border:1px solid #e5e9f1;border-radius:11px;background:#fff;color:#17213b}.lesson-navigation small{font-size:.58rem;color:#315efb;font-weight:900;letter-spacing:.1em}.lesson-navigation b{font-size:.78rem;line-height:1.5}.next-lesson{text-align:right}.lesson-toc{display:grid;gap:12px}.lesson-toc>b{margin-bottom:5px}.lesson-toc a{font-size:.72rem;line-height:1.45;color:#788398}.lesson-toc a:hover{color:#315efb}
@media(max-width:1150px){.lesson-layout{grid-template-columns:210px minmax(0,1fr);gap:24px}.lesson-toc{display:none}}@media(max-width:760px){.lesson-shell{width:calc(100% - 24px)}.lesson-layout{display:block}.lesson-sidebar{position:static;margin-bottom:15px;padding:15px;border:1px solid #e5e9f1;border-radius:12px;background:#fff}.lesson-sidebar ol{display:flex;overflow-x:auto;gap:5px}.lesson-sidebar li{min-width:145px;border-left:0;border-bottom:2px solid #e3e7f0}.lesson-sidebar li.active{border-bottom-color:#315efb}.sidebar-progress{margin-top:12px}.lesson-article{padding:22px 18px}.lesson-duration{position:static;display:inline-block;margin-top:12px}.lesson-complete{align-items:flex-start;flex-direction:column}.lesson-navigation{grid-template-columns:1fr}}
.lesson-sidebar{position:static;top:auto;margin:0;border:1px solid #e5e9f1;border-radius:12px;background:#fff;padding:0;overflow:hidden}.lesson-sidebar>summary,.lesson-toc>summary{padding:14px 17px;cursor:pointer;color:#315efb;font-size:.76rem;font-weight:900;list-style:none}.lesson-sidebar>summary::-webkit-details-marker,.lesson-toc>summary::-webkit-details-marker{display:none}.lesson-sidebar>summary:after,.lesson-toc>summary:after{content:"+";float:right;font-size:1rem}.lesson-sidebar[open]>summary:after,.lesson-toc[open]>summary:after{content:"−"}.lesson-sidebar>.back-course,.lesson-sidebar>.sidebar-label,.lesson-sidebar>ol,.lesson-sidebar>.sidebar-progress{margin-left:17px;margin-right:17px}.lesson-sidebar>.back-course{margin-top:14px}.lesson-sidebar>.sidebar-progress{margin-bottom:16px}.lesson-toc{display:block;position:static;border:1px solid #e5e9f1;border-radius:12px;background:#fff;margin:0 0 24px;overflow:hidden}.lesson-toc nav{display:grid;gap:0;padding:0 17px 12px}.lesson-toc nav a{padding:7px 0;color:#68738a;font-size:.75rem}.lesson-toc nav a:hover{color:#315efb}</style>
