---
import BaseLayout from '@layouts/BaseLayout.astro';
import { courses, type Course, type Lesson } from '../../../data/learn/courses';
export function getStaticPaths() { return courses.flatMap((course: Course) => course.lessons.map((lesson: Lesson) => ({ params: { technology: course.slug, lesson: lesson.slug }, props: { course, lesson } }))); }
const { course, lesson } = Astro.props as { course: Course; lesson: Lesson };
const index = course.lessons.findIndex((item: Lesson) => item.slug === lesson.slug);
const previous = course.lessons[index - 1];
const next = course.lessons[index + 1];
const lessonSlugs = course.lessons.map((item: Lesson) => item.slug);
---
<BaseLayout title={lesson.title + ' — ' + course.title + ' | B Tecky LearnLab'} description={lesson.summary} type="article">
<main class="lesson-page"><div class="lesson-shell">
<nav class="lesson-crumbs" aria-label="Breadcrumb"><a href="/learn/">LearnLab</a><span>/</span><a href={'/learn/'+course.slug+'/'}>{course.title}</a><span>/</span><span>{lesson.title}</span></nav>
<div class="lesson-layout">
<details class="lesson-sidebar"><summary>Course lessons · {course.lessons.length} lessons</summary><a class="back-course" href={'/learn/'+course.slug+'/'}>← Course overview</a><p class="sidebar-label">YOUR CURRICULUM</p><ol>{course.lessons.map((item,i)=><li class:list={{active:item.slug===lesson.slug}} data-sidebar-lesson={item.slug}><a href={'/learn/'+course.slug+'/'+item.slug+'/'}><span>{String(i+1).padStart(2,'0')}</span>{item.title}</a></li>)}</ol><div class="sidebar-progress"><span>YOUR PROGRESS</span><b data-progress-label>0 / {course.lessons.length} complete</b><div class="progress-track"><i data-progress-bar></i></div></div></details>
<div class="lesson-locked" data-lesson-locked hidden role="status"><span class="eyebrow">KEEP GOING STEP BY STEP</span><h1>This lesson is locked for now</h1><p>Complete the previous lesson to unlock this one. Your learning path is designed to build each skill on what you learned before.</p><a href={'/learn/'+course.slug+'/'}>Return to the course curriculum ↗</a></div>
<article class="lesson-article" data-lesson-content>
<header class="lesson-heading"><p class="eyebrow">{course.title.toUpperCase()} / LESSON {String(index+1).padStart(2,'0')}</p><span class="lesson-duration">{lesson.minutes} MIN READ</span><h1>{lesson.title}</h1><p class="lesson-summary">{lesson.summary}</p><div class="objectives"><b>By the end, you can:</b><ul>{lesson.objectives.map((item)=><li>{item}</li>)}</ul></div><div class="lesson-tools">{course.categoryId==='web-development'&&<a href="/learn/paths/web-development/project/">↗ Continue building your connected project</a>}<a href="/learn/playground/">▶ Try code in the example playground</a></div></header>
<details class="lesson-toc"><summary>On this lesson · {lesson.sections.length} sections</summary><nav>{lesson.sections.map((section,i)=><a href={'#section-'+(i+1)}>{section.title}</a>)}<a href="#practice">Practice</a></nav></details><div class="lesson-body">{lesson.sections.map((section,i)=><section id={'section-'+(i+1)}><h2>{section.title}</h2><div class="prose" set:html={section.body}></div>{section.code&&<><pre class="code-sample"><code>{section.code}</code></pre><button type="button" class="run-example" data-run-example>Try this example in the playground ↗</button></>}{section.note&&<aside class="learning-note"><b>Remember</b><p>{section.note}</p></aside>}</section>)}</div>
<section class="exercise" id="practice"><p class="eyebrow">TRY IT YOURSELF</p><h2>Practice: {lesson.title}</h2><p>{lesson.exercise.prompt}</p><ul>{lesson.exercise.requirements.map((item)=><li>{item}</li>)}</ul><details><summary>Show one possible solution</summary><pre class="code-sample"><code>{lesson.exercise.solution}</code></pre><p class="solution-note">There can be more than one correct implementation. Compare the structure and requirements, not just the exact text.</p></details></section>
<section class="knowledge-check" data-quiz><p class="eyebrow">CHECK YOUR UNDERSTANDING</p><h2>Quick knowledge check</h2>{lesson.quiz.map((question,i)=><fieldset class="quiz-question" data-question={i}><legend>{i+1}. {question.question}</legend>{question.options.map((option,j)=><label><input type="radio" name={'q-'+i} value={j}><span>{option}</span></label>)}<div class="quiz-feedback" data-feedback hidden></div><span class="quiz-explanation" hidden>{question.explanation}</span></fieldset>)}<button type="button" class="check-answers" data-check-answers>Check answers</button><p class="quiz-result" data-quiz-result aria-live="polite"></p></section>
<section class="references"><h2>Further reading</h2><ul>{lesson.references.map((ref)=><li><a href={ref.url} target="_blank" rel="noopener noreferrer">{ref.label} ↗</a></li>)}</ul></section>
<div class="lesson-complete"><div><b>Finished this lesson?</b><span>Mark it complete to keep track of your learning on this device.</span></div><button type="button" data-complete-lesson>Mark as complete</button></div>
<nav class="lesson-navigation" aria-label="Lesson navigation">{previous?<a href={'/learn/'+course.slug+'/'+previous.slug+'/'}><small>← PREVIOUS</small><b>{previous.title}</b></a>:<a href={'/learn/'+course.slug+'/'}><small>← COURSE</small><b>Course overview</b></a>}{next?<a class="next-lesson" href={'/learn/'+course.slug+'/'+next.slug+'/'}><small>NEXT LESSON →</small><b>{next.title}</b></a>:<a class="next-lesson" href={'/learn/'+course.slug+'/'}><small>COURSE COMPLETE →</small><b>Review the curriculum</b></a>}</nav>
</article>

</div></div></main>
<script define:vars={{courseSlug:course.slug,lessonSlug:lesson.slug,total:course.lessons.length,lessonIndex:index,lessonSlugs,quiz:lesson.quiz}}>
const key='btecky.learnlab.progress.v1';
const readProgress=()=>{try{return JSON.parse(localStorage.getItem(key)||'{}')}catch{return {}}};
const button=document.querySelector('[data-complete-lesson]');
const completed=()=>((readProgress()[courseSlug]||[]).includes(lessonSlug));
const previousCompleted=()=>lessonIndex===0||((readProgress()[courseSlug]||[]).includes(lessonSlugs[lessonIndex-1]));
const lessonContent=document.querySelector<HTMLElement>('[data-lesson-content]');
const lockedPanel=document.querySelector<HTMLElement>('[data-lesson-locked]');
const updateAccess=()=>{const allowed=previousCompleted();if(lessonContent)lessonContent.hidden=!allowed;if(lockedPanel)lockedPanel.hidden=allowed;document.querySelectorAll<HTMLElement>('[data-sidebar-lesson]').forEach((item)=>{const slug=item.dataset.sidebarLesson||'';const position=lessonSlugs.indexOf(slug);const isLocked=position>0&&!((readProgress()[courseSlug]||[]).includes(lessonSlugs[position-1]));item.classList.toggle('is-locked',isLocked);const link=item.querySelector<HTMLAnchorElement>('a');if(link){link.setAttribute('aria-disabled',String(isLocked));if(isLocked)link.addEventListener('click',(event)=>{event.preventDefault();});}});};
const updateProgress=()=>{const items=readProgress()[courseSlug]||[];const count=lessonSlugs.filter((slug)=>items.includes(slug)).length;const label=document.querySelector<HTMLElement>('[data-progress-label]');const bar=document.querySelector<HTMLElement>('[data-progress-bar]');if(label)label.textContent=count+' / '+total+' complete';if(bar)bar.style.width=(Math.min(100,count/total*100))+'%'};
const updateButton=()=>{if(button){button.textContent=completed()?'Completed ✓':'Mark as complete';button.classList.toggle('is-complete',completed());button.disabled=completed()}};
updateAccess();updateButton();updateProgress();
button?.addEventListener('click',()=>{if(!previousCompleted())return;const all=readProgress();const items=new Set(all[courseSlug]||[]);items.add(lessonSlug);all[courseSlug]=lessonSlugs.filter((slug)=>items.has(slug));try{localStorage.setItem(key,JSON.stringify(all));updateAccess();updateButton();updateProgress();const nextLink=document.querySelector<HTMLAnchorElement>('.lesson-navigation .next-lesson');if(nextLink)nextLink.classList.add('is-unlocked')}catch{button.textContent='Storage unavailable'}});
document.querySelectorAll<HTMLButtonElement>('[data-run-example]').forEach((runButton)=>runButton.addEventListener('click',()=>{const code=runButton.previousElementSibling?.querySelector('code')?.textContent||'';try{sessionStorage.setItem('btecky.learnlab.playground.seed.v1',code);window.location.href='/learn/playground/';}catch{runButton.textContent='Open playground and paste this example';}}));
document.querySelector('[data-check-answers]')?.addEventListener('click',()=>{let score=0;let answered=0;document.querySelectorAll('[data-question]').forEach((field,index)=>{const selected=field.querySelector('input:checked');const feedback=field.querySelector('[data-feedback]');const explanation=field.querySelector('.quiz-explanation');const correct=Number(selected?.value)===quiz[index].answer;if(selected)answered++;if(correct)score++;feedback.hidden=false;feedback.textContent=selected?(correct?'Correct.':'Not quite.'):'Choose an answer to see feedback.';feedback.className='quiz-feedback '+(correct?'is-correct':'is-incorrect');explanation.hidden=false});const result=document.querySelector('[data-quiz-result]');if(result)result.textContent='You got '+score+' of '+quiz.length+' correct ('+answered+' answered). Review the explanations and try again.'});
</script>
</BaseLayout>
<style>
