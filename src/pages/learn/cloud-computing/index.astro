---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const course = {"slug": "cloud-computing", "name": "Cloud Computing", "short": "Plan, deploy, secure, and operate applications in the cloud.", "modules": [{"title": "Cloud foundations", "summary": "Understand cloud models, regions, and shared responsibility.", "lessons": [{"title": "What cloud computing means", "body": "Cloud computing delivers compute, storage, databases, and managed services over a network. Instead of buying a server for every project, teams provision resources when needed and pay according to the service and usage. The key benefit is not simply someone else's computer: it is the ability to provision quickly, scale, automate, and use managed infrastructure.", "task": "Compare a traditional on-premises server room with a cloud-hosted application. List three responsibilities that move to the provider and three that remain with your team."}, {"title": "Service models: IaaS, PaaS, and SaaS", "body": "Infrastructure as a Service gives you control over virtual machines, networks, and disks. Platform as a Service manages more of the runtime and deployment platform. Software as a Service delivers a finished application. More provider management usually means less infrastructure control.", "task": "Classify a virtual machine, a managed application platform, and an online email service as IaaS, PaaS, or SaaS. Explain the trade-off."}, {"title": "Public, private, and hybrid cloud", "body": "Public cloud resources are offered by a provider to many customers with logical isolation. Private cloud infrastructure is dedicated to one organization. Hybrid cloud combines environments, often to meet integration, latency, residency, or migration needs.", "task": "Sketch a hybrid architecture for a company that keeps a sensitive legacy database on-premises but hosts its public website in a cloud environment."}, {"title": "Regions, zones, and resilience", "body": "A region is a geographic area containing cloud infrastructure. Availability zones are isolated locations within a region. Distributing critical components across zones can reduce the impact of a localized failure, but resilience also requires backups, health checks, and tested recovery procedures.", "task": "Design a simple highly available web service using two availability zones. Identify what happens if one zone becomes unavailable."}]}, {"title": "Compute, storage, and networking", "summary": "Choose the right building blocks for a reliable application.", "lessons": [{"title": "Virtual machines and containers", "body": "Virtual machines emulate a computer with its own operating system environment. Containers package an application and its dependencies while sharing the host kernel. VMs provide strong isolation boundaries; containers are often lighter and easier to replicate for application workloads.", "task": "Choose between a VM and a container for (a) a legacy operating-system-dependent application and (b) a stateless web API. Justify each choice."}, {"title": "Object, block, and file storage", "body": "Object storage stores data as objects with metadata and is useful for media, backups, and static assets. Block storage provides disk-like volumes for operating systems and databases. File storage exposes shared file-system semantics for workloads that need folders and shared access.", "task": "Map profile photos, a VM boot disk, and a shared team directory to object, block, and file storage. Include one reason for each mapping."}, {"title": "Cloud networking basics", "body": "Virtual networks isolate cloud resources. Subnets divide address space, route tables direct traffic, and firewalls or security groups control permitted connections. Public exposure should be deliberate; private services should not receive unnecessary inbound internet access.", "task": "Draw a network with a public load balancer and private application and database subnets. State which ports should be reachable between each tier."}, {"title": "Load balancing and autoscaling", "body": "A load balancer distributes requests across healthy targets. Autoscaling changes capacity in response to demand or schedules. Together they can improve availability and responsiveness, but scaling policies need sensible limits, health checks, and monitoring.", "task": "For a traffic spike, describe how a load balancer and autoscaling group cooperate. Name two metrics you would monitor."}]}, {"title": "Deployment, security, and operations", "summary": "Deploy repeatably and protect cloud resources.", "lessons": [{"title": "Identity and access management", "body": "Identity and Access Management controls who or what can access resources. Use individual identities, roles, least privilege, and short-lived credentials where possible. Avoid shared administrator accounts and never place secrets in source code.", "task": "Create a role outline for a developer who can deploy to a test environment but cannot change production identity policies."}, {"title": "Infrastructure as Code", "body": "Infrastructure as Code describes infrastructure in version-controlled files. Reviewing and applying these definitions makes environments repeatable and reduces manual configuration drift. Changes should be tested and reviewed like application code.", "task": "Write pseudocode for a reusable environment definition containing a network, one application service, and a storage bucket. Identify which values should be parameters."}, {"title": "CI/CD and deployment strategies", "body": "Continuous integration validates changes frequently. Continuous delivery automates the path to a releasable build. Rolling, blue-green, and canary deployments reduce release risk in different ways. A rollback plan should be designed before deployment.", "task": "Choose a deployment strategy for a customer-facing API where you want to expose a new version to 5% of traffic first. Explain how you would stop the rollout."}, {"title": "Monitoring, logs, and alerts", "body": "Metrics show numerical behavior over time, logs record events, and traces follow requests across services. Useful alerts focus on user impact and actionable thresholds rather than every minor fluctuation. Dashboards should support diagnosis, not just look impressive.", "task": "Define four signals for an online shop: availability, latency, error rate, and saturation. For each, describe an alert that would prompt investigation."}]}, {"title": "Cost, reliability, and capstone", "summary": "Apply cloud design principles to a realistic service.", "lessons": [{"title": "Cloud cost management", "body": "Cloud costs are shaped by resource size, runtime, data transfer, storage class, and managed-service usage. Tag resources, set budgets, review utilization, and remove unused resources. Cost optimization should not compromise required security or reliability.", "task": "Review a hypothetical environment with idle VMs, oversized databases, and untagged storage. Prioritize three cost actions and state their risks."}, {"title": "Backup and disaster recovery", "body": "Backups protect data; disaster recovery restores service after a major incident. Define recovery point objective (acceptable data loss) and recovery time objective (acceptable downtime). Test restoration because an untested backup is only an assumption.", "task": "For a booking service that can tolerate 15 minutes of data loss and 1 hour of downtime, translate those limits into RPO and RTO targets."}, {"title": "Well-architected design", "body": "A sound cloud architecture considers operational excellence, security, reliability, performance efficiency, and cost optimization. These goals can conflict. Make trade-offs explicit and validate them with measurable requirements.", "task": "Evaluate a proposed single-server application against the five design pillars. Identify the highest-risk gap and propose a practical improvement."}, {"title": "Capstone: deploy a resilient web app", "body": "Design a small web application with a public entry point, private application tier, managed database, object storage for uploads, identity controls, monitoring, backups, and a repeatable deployment process. Document assumptions and failure behavior.", "task": "Produce an architecture diagram, resource inventory, access policy, deployment plan, backup and recovery targets, monitoring checklist, and estimated monthly cost assumptions."}]}], "quiz": [["Which service model gives the customer the most control over operating systems and virtual networks?", ["SaaS", "IaaS", "PaaS", "None"], 1, "IaaS exposes infrastructure primitives such as virtual machines and networks, so the customer manages more of the stack."], ["Which storage type is commonly suited to images and static media?", ["Object storage", "Block storage", "CPU cache", "Swap"], 0, "Object storage is designed for durable, scalable storage of objects such as images and backups."], ["What does least privilege mean?", ["Everyone is an administrator", "Grant only the access needed for a task", "Disable all logging", "Use one shared account"], 1, "Least privilege limits the impact of mistakes or compromised identities."], ["What does RPO describe?", ["Maximum acceptable data loss measured in time", "Maximum CPU utilization", "Deployment frequency", "Network bandwidth"], 0, "Recovery Point Objective defines how far back restored data may be after an incident."]], "capstone": "Design and document a resilient cloud-hosted web application. Include a network diagram, service choices, IAM roles, deployment workflow, monitoring, backup strategy, RPO/RTO, and cost assumptions."};
const storagePrefix = `btecky-${course.slug}-`;
---

<BaseLayout title={`${course.name} | B Tecky LearnLab`} description={course.short}>
  <main class="course-shell">
    <a class="back-link" href="/learn/">← All learning paths</a>
    <header class="hero">
      <p class="eyebrow">B TECKY · LEARNLAB</p>
      <h1>{course.name}</h1>
      <p class="intro">{course.short}</p>
      <div class="progress-wrap">
        <div class="progress-copy"><span>Your course progress</span><strong id="progress-label">0% complete</strong></div>
        <div class="progress-track"><div id="progress-fill"></div></div>
      </div>
    </header>
    <div class="layout">
      <aside class="sidebar">
        <h2>Course roadmap</h2>
        <nav id="lesson-nav" aria-label="Course lessons">
          {course.modules.map((module, mi) => <section class="nav-module">
            <h3>{mi + 1}. {module.title}</h3>
            {module.lessons.map((lesson, li) => <button class="nav-lesson" data-lesson={`${mi}-${li}`} type="button">{li + 1}. {lesson.title}</button>)}
          </section>)}
          <button class="nav-lesson quiz-link" data-quiz="true" type="button">Knowledge checks</button>
          <button class="nav-lesson quiz-link" data-capstone="true" type="button">Final capstone</button>
        </nav>
      </aside>
      <section class="lesson-panel" aria-live="polite">
        <div id="lesson-content">
          <p class="eyebrow">START HERE</p>
          <h2>Welcome to {course.name}</h2>
          <p>Work through the lessons in order. Each lesson includes an explanation and a practical task. Your progress is saved in this browser.</p>
          <button id="start-button" class="primary" type="button">Start first lesson</button>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
:global(body){background:#f6f8fc;color:#172033}.course-shell{max-width:1180px;margin:0 auto;padding:34px 22px 80px}.back-link{color:#3156a5;text-decoration:none;font-weight:650}.hero{padding:34px 0 28px}.eyebrow{font-size:.76rem;letter-spacing:.14em;font-weight:800;color:#5570aa}.hero h1{font-size:clamp(2.2rem,5vw,3.6rem);line-height:1.05;margin:10px 0}.intro{font-size:1.1rem;color:#596579;max-width:680px}.progress-wrap{max-width:580px;margin-top:28px}.progress-copy{display:flex;justify-content:space-between;font-size:.9rem;margin-bottom:9px}.progress-track{height:9px;background:#e1e7f1;border-radius:20px;overflow:hidden}.progress-track div{height:100%;width:0;background:#4169d8;border-radius:20px;transition:width .2s}.layout{display:grid;grid-template-columns:290px minmax(0,1fr);gap:22px;align-items:start}.sidebar,.lesson-panel{background:white;border:1px solid #e5eaf2;border-radius:18px;box-shadow:0 8px 28px #1c31500b}.sidebar{padding:20px;position:sticky;top:18px;max-height:calc(100vh - 36px);overflow:auto}.sidebar h2{font-size:1.05rem;margin:0 0 16px}.nav-module{margin:0 0 18px}.nav-module h3{font-size:.88rem;margin:0 0 8px;color:#34415a}.nav-lesson{display:block;width:100%;text-align:left;border:0;background:transparent;border-radius:8px;padding:9px 10px;color:#58657a;cursor:pointer;font:inherit;font-size:.87rem}.nav-lesson:hover,.nav-lesson.active{background:#edf2ff;color:#254caa}.nav-lesson.done:after{content:' ✓';color:#16804a;font-weight:800}.lesson-panel{padding:clamp(22px,4vw,44px);min-height:480px}.lesson-panel h2{font-size:clamp(1.6rem,3vw,2.25rem);margin:8px 0 16px}.lesson-panel p{line-height:1.8;color:#4c596d}.task{background:#f1f5ff;border-left:4px solid #5577d6;padding:18px 20px;border-radius:10px;margin:24px 0}.task strong{display:block;color:#243c7b;margin-bottom:6px}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:24px}.primary,.secondary{border:0;border-radius:9px;padding:12px 17px;font-weight:700;cursor:pointer}.primary{background:#315bd1;color:white}.secondary{background:#edf1f7;color:#27344b}.code-sample{background:#111827;color:#e5edff;padding:16px;border-radius:10px;overflow:auto;white-space:pre-wrap}.quiz-option{display:block;width:100%;text-align:left;padding:13px;margin:9px 0;border:1px solid #dce3ef;border-radius:9px;background:white;cursor:pointer}.quiz-option.selected{border-color:#4169d8;background:#eff3ff}.feedback{padding:13px;border-radius:9px;margin-top:14px;background:#f0f7f2;color:#205b37}.muted{color:#6b778b!important}@media(max-width:800px){.layout{grid-template-columns:1fr}.sidebar{position:static;max-height:none}.lesson-panel{min-height:400px}}

/* Styling for dynamically rendered lesson content */
:global(.lesson-panel h2) {
  font-size: clamp(1.6rem, 3vw, 2.25rem);
  line-height: 1.2;
  margin: 10px 0 18px;
  color: #172033;
}
:global(.lesson-panel p) {
  line-height: 1.8;
  color: #4c596d;
  margin: 12px 0;
}
:global(.lesson-panel .task) {
  background: #f1f5ff;
  border-left: 4px solid #5577d6;
  padding: 20px 22px;
  border-radius: 10px;
  margin: 26px 0;
  line-height: 1.7;
  color: #34415a;
}
:global(.lesson-panel .task strong) {
  display: block;
  color: #243c7b;
  margin-bottom: 8px;
}
:global(.lesson-panel .actions) {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 26px;
}
:global(.lesson-panel .primary),
:global(.lesson-panel .secondary) {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 9px;
  padding: 12px 19px;
  min-height: 44px;
  font: inherit;
  font-weight: 700;
  cursor: pointer;
}
:global(.lesson-panel .primary) {
  background: #315bd1;
  color: white;
}
:global(.lesson-panel .secondary) {
  background: #edf1f7;
  color: #27344b;
}
:global(.lesson-panel .quiz-option) {
  display: block;
  width: 100%;
  text-align: left;
  padding: 14px 16px;
  margin: 10px 0;
  border: 1px solid #dce3ef;
  border-radius: 9px;
  background: white;
  color: #27344b;
  font: inherit;
  cursor: pointer;
}
:global(.lesson-panel .quiz-option:hover),
:global(.lesson-panel .quiz-option.selected) {
  border-color: #4169d8;
  background: #eff3ff;
}
:global(.lesson-panel .feedback) {
  padding: 15px 18px;
  border-radius: 9px;
  margin-top: 16px;
  background: #f0f7f2;
  color: #205b37;
  line-height: 1.7;
}
:global(.lesson-panel .muted) {
  color: #6b778b;
  font-size: .9rem;
}

</style>

<script define:vars={{ course, storagePrefix }}>
const content = document.getElementById('lesson-content');
const nav = document.getElementById('lesson-nav');
const fill = document.getElementById('progress-fill');
const label = document.getElementById('progress-label');
const totalLessons = course.modules.reduce((sum, module) => sum + module.lessons.length, 0);
const key = (mi, li) => `${storagePrefix}lesson-${mi}-${li}`;
const isDone = (mi, li) => localStorage.getItem(key(mi, li)) === 'true';
function updateProgress() {
  const done = course.modules.reduce((sum, module, mi) => sum + module.lessons.filter((_, li) => isDone(mi, li)).length, 0);
  const percent = Math.round(done / totalLessons * 100);
  fill.style.width = `${percent}%`;
  label.textContent = `${percent}% complete`;
  nav.querySelectorAll('[data-lesson]').forEach(button => {
    const [mi, li] = button.dataset.lesson.split('-').map(Number);
    button.classList.toggle('done', isDone(mi, li));
  });
}
function showLesson(mi, li) {
  const module = course.modules[mi], lesson = module.lessons[li];
  nav.querySelectorAll('.nav-lesson').forEach(b => b.classList.toggle('active', b.dataset.lesson === `${mi}-${li}`));
  content.innerHTML = `<p class="eyebrow">MODULE ${mi + 1} · LESSON ${li + 1}</p><h2>${lesson.title}</h2><p>${lesson.body}</p><div class="task"><strong>Practical task</strong>${lesson.task}</div><p class="muted">${isDone(mi,li) ? 'You have completed this lesson.' : 'Mark this lesson complete when you are ready to continue.'}</p><div class="actions"><button class="primary" id="complete-button" type="button">${isDone(mi,li) ? 'Completed ✓' : 'Mark complete'}</button>${li < module.lessons.length - 1 ? '<button class="secondary" id="next-button" type="button">Next lesson →</button>' : mi < course.modules.length - 1 ? '<button class="secondary" id="next-button" type="button">Next module →</button>' : '<button class="secondary" id="quiz-button" type="button">Knowledge checks →</button>'}</div>`;
  document.getElementById('complete-button').addEventListener('click', () => { localStorage.setItem(key(mi,li),'true'); updateProgress(); showLesson(mi,li); });
  document.getElementById('next-button')?.addEventListener('click', () => li < module.lessons.length - 1 ? showLesson(mi,li+1) : showLesson(mi+1,0));
  document.getElementById('quiz-button')?.addEventListener('click', showQuiz);
}
function showQuiz() {
  nav.querySelectorAll('.nav-lesson').forEach(b => b.classList.toggle('active', b.dataset.quiz === 'true'));
  let index = 0;
  function renderQuestion() {
    const q = course.quiz[index];
    content.innerHTML = `<p class="eyebrow">KNOWLEDGE CHECK ${index+1} OF ${course.quiz.length}</p><h2>${q[0]}</h2><div id="options"></div><div id="quiz-feedback"></div><div class="actions"><button class="secondary" id="quiz-next" type="button" disabled>${index === course.quiz.length-1 ? 'Finish quiz' : 'Next question →'}</button></div>`;
    const options = document.getElementById('options');
    q[1].forEach((option, oi) => {
      const button = document.createElement('button'); button.className='quiz-option'; button.type='button'; button.textContent=option;
      button.addEventListener('click', () => {
        if (options.dataset.answered) return;
        options.dataset.answered='true';
        const correct = oi === q[2];
        button.classList.add('selected');
        document.getElementById('quiz-feedback').innerHTML = `<p class="feedback">${correct ? 'Correct. ' : 'Not quite. '}${q[3]}</p>`;
        document.getElementById('quiz-next').disabled=false;
      });
      options.appendChild(button);
    });
    document.getElementById('quiz-next').addEventListener('click', () => { if(index < course.quiz.length-1){index++;renderQuestion();} else showCapstone(); });
  }
  renderQuestion();
}
function showCapstone() {
  nav.querySelectorAll('.nav-lesson').forEach(b => b.classList.toggle('active', b.dataset.capstone === 'true'));
  content.innerHTML = `<p class="eyebrow">FINAL PROJECT</p><h2>Course capstone</h2><p>${course.capstone}</p><div class="task"><strong>Submission checklist</strong>Document your goal, approach, decisions, evidence, limitations, and what you would improve next.</div><p class="muted">You have reached the end of the course pathway. Review any lesson again from the roadmap whenever you need.</p><button class="primary" id="review-button" type="button">Review first lesson</button>`;
  document.getElementById('review-button').addEventListener('click',()=>showLesson(0,0));
}
nav.querySelectorAll('[data-lesson]').forEach(button => button.addEventListener('click',()=>{const [mi,li]=button.dataset.lesson.split('-').map(Number);showLesson(mi,li);}));
nav.querySelector('[data-quiz]').addEventListener('click',showQuiz);
nav.querySelector('[data-capstone]').addEventListener('click',showCapstone);
document.getElementById('start-button')?.addEventListener('click',()=>showLesson(0,0));
updateProgress();
</script>
