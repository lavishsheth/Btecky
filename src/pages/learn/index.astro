---
import BaseLayout from '@layouts/BaseLayout.astro';
import { courses } from '../../data/learn/courses';
import { learningPaths } from '../../data/learn/paths';
import { learningCategories } from '../../data/learn/categories';
import { assertValidLearnLabCatalogue } from '../../data/learn/catalogue';

assertValidLearnLabCatalogue();
const webPath = learningPaths.find((path) => path.slug === 'web-development');
const courseById = new Map(courses.map((course) => [course.id, course]));
const firstStage = webPath?.stages.find((stage) => stage.status === 'available' && stage.courseId);
const startCourse = firstStage?.courseId ? courseById.get(firstStage.courseId) : courses[0];
const categories = learningCategories.filter((category) => courses.some((course) => course.categoryId === category.id)).sort((a, b) => a.sortOrder - b.sortOrder);
const courseCards = courses.map((course) => ({
  id: course.id,
  slug: course.slug,
  title: course.title,
  category: course.category,
  categoryId: course.categoryId,
  level: course.level,
  summary: course.summary,
  lessons: course.lessons.length,
}));
---
<BaseLayout
  title="LearnLab — Learn technology by building | B Tecky"
  description="A free, beginner-friendly place to learn technology. Follow a clear learning path, practise one lesson at a time and build a real project with B Tecky LearnLab."
>
  <main class="learn-home" id="top">
    <section class="welcome">
      <div class="welcome-copy">
        <span class="eyebrow"><i></i> B TECKY LEARNLAB · FREE FOR EVERYONE</span>
        <h1>Learn one step.<br /><em>Build something real.</em></h1>
        <p>Not sure where to begin? That's okay. Choose a learning path and we'll guide you through each course and lesson, one step at a time.</p>
        <div class="welcome-actions">
          {startCourse && <a class="primary-action" href={'/learn/' + startCourse.slug + '/'}>Start learning <span>→</span></a>}
          <a class="secondary-action" href="#courses">I know what I want to learn</a>
        </div>
        <div class="welcome-trust"><span>✓ Free to access</span><span>✓ Beginner-friendly</span><span>✓ Learn at your own pace</span></div>
      </div>
      <aside class="start-card">
        <span class="start-card-label">NEW TO LEARNLAB?</span>
        <div class="start-number">01</div>
        <h2>Start with HTML</h2>
        <p>Learn how a website is structured. Then you'll use that same website to learn CSS, JavaScript and React.</p>
        {startCourse && <a href={'/learn/' + startCourse.slug + '/'}>Start the first course <span>↗</span></a>}
        <small>No experience needed · No account required to explore</small>
      </aside>
    </section>

    <section class="how-section" aria-labelledby="how-title">
      <div class="section-intro">
        <span class="eyebrow">HOW LEARNLAB WORKS</span>
        <h2 id="how-title">Three simple steps.</h2>
        <p>You don't need to figure everything out at once. Just follow this loop.</p>
      </div>
      <div class="how-grid">
        <article><span class="step-icon">01</span><h3>Learn</h3><p>Read a short lesson, understand the idea and follow a clear example.</p></article>
        <article><span class="step-icon">02</span><h3>Try it</h3><p>Practise with a small task and check what you've understood.</p></article>
        <article><span class="step-icon">03</span><h3>Build</h3><p>Add what you learned to your project. Each course moves it forward.</p></article>
      </div>
    </section>

    {webPath && <section class="journey-section" aria-labelledby="journey-title">
      <div class="section-intro section-intro-row">
        <div><span class="eyebrow">RECOMMENDED FOR BEGINNERS</span><h2 id="journey-title">Your web development journey.</h2><p>Build one website from beginning to end. You keep improving the same project as you learn new skills.</p></div>
        <span class="journey-badge">4 connected courses</span>
      </div>
      <div class="journey-flow">
        {webPath.stages.map((stage, index) => {
          const course = stage.courseId ? courseById.get(stage.courseId) : undefined;
          return <article class:list={['journey-step', { 'is-available': stage.status === 'available' && course }]}>
            <span class="journey-step-number">{String(index + 1).padStart(2, '0')}</span>
            <div class="journey-step-copy"><span>{stage.status === 'available' && course ? 'COURSE AVAILABLE' : 'COMING LATER'}</span><h3>{stage.title}</h3><p>{stage.description}</p></div>
            {stage.status === 'available' && course ? <a href={'/learn/' + course.slug + '/'} aria-label={'Open ' + course.title}>Open course <b>→</b></a> : <span class="coming-label">Coming soon</span>}
          </article>;
        })}
      </div>
      <p class="journey-note"><span>✦</span> Your project grows with you: HTML gives it structure, CSS gives it style, JavaScript adds interaction, and React organises it into components.</p>
    </section>}

    <section class="course-section" id="courses" aria-labelledby="courses-title">
      <div class="section-intro section-intro-row">
        <div><span class="eyebrow">LEARN A TOPIC AT YOUR OWN PACE</span><h2 id="courses-title">Or choose a course.</h2><p>Already know what you're interested in? Pick a course directly. We'll show you its lessons and what to do next.</p></div>
        <a class="all-courses-link" href="/learn/courses/">View course catalogue →</a>
      </div>
      <div class="course-controls">
        <label class="course-search"><span aria-hidden="true">⌕</span><input id="course-search" type="search" placeholder="Search a course..." aria-label="Search courses" /></label>
        <div class="category-filters" role="group" aria-label="Filter courses">
          <button type="button" class="selected" data-filter="all" aria-pressed="true">All</button>
          {categories.map((category) => <button type="button" data-filter={category.id} aria-pressed="false">{category.title}</button>)}
        </div>
      </div>
      <div class="course-grid" id="course-grid">
        {courseCards.map((course) => <a class="course-card" href={'/learn/' + course.slug + '/'} data-course-card data-category={course.categoryId} data-search={(course.title + ' ' + course.category + ' ' + course.summary).toLowerCase()}>
          <div class="course-card-top"><span class="course-icon">{course.categoryId === 'web-development' ? '</>' : '✳'}</span><span>{course.level}</span></div>
          <small>{course.category}</small><h3>{course.title}</h3><p>{course.summary}</p>
          <div class="course-card-foot"><span>{course.lessons} lessons</span><b>View course →</b></div>
        </a>)}
      </div>
      <p class="no-results" id="no-results" hidden>No courses found. Try a different search.</p>
    </section>

    <section class="reassurance">
      <div><span class="eyebrow">A FEW THINGS TO KNOW</span><h2>Learning should feel simple.</h2></div>
      <div class="reassurance-items">
        <details><summary>Is LearnLab free? <span>+</span></summary><p>Yes. LearnLab is free to access. You can explore the available courses without a subscription.</p></details>
        <details><summary>Do I need coding experience? <span>+</span></summary><p>No. Start with the beginner-friendly HTML course. It introduces the basics before moving forward.</p></details>
        <details><summary>How do I know what to do next? <span>+</span></summary><p>Follow the lessons in order. Finish a lesson and mark it complete to unlock the next one. Your progress is saved in this browser on this device.</p></details>
        <details><summary>Can I keep my project? <span>+</span></summary><p>The connected web development project is designed to grow across the courses. Use the project workspace to continue building and export your work when available.</p></details>
      </div>
    </section>
    <footer class="learn-footer"><p>One lesson at a time. One project at a time.</p><a href="#top" onclick="window.scrollTo({top:0,behavior:'smooth'});return false;">Back to top ↑</a></footer>
  </main>
  <script>
    const search = document.querySelector<HTMLInputElement>('#course-search');
    const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const cards = [...document.querySelectorAll<HTMLElement>('[data-course-card]')];
    const empty = document.querySelector<HTMLElement>('#no-results');
    let active = 'all';
    function update() {
      const query = search?.value.trim().toLowerCase() || '';
      let count = 0;
      cards.forEach((card) => {
        const visible = (active === 'all' || card.dataset.category === active) && (card.dataset.search || '').includes(query);
        card.hidden = !visible;
        if (visible) count++;
      });
      if (empty) empty.hidden = count > 0;
    }
    search?.addEventListener('input', update);
    filters.forEach((filter) => filter.addEventListener('click', () => {
      active = filter.dataset.filter || 'all';
      filters.forEach((item) => {
        const selected = item === filter;
        item.classList.toggle('selected', selected);
        item.setAttribute('aria-pressed', String(selected));
      });
      update();
    }));
  </script>
</BaseLayout>
<style>
.learn-home{--ink:#17213b;--muted:#667085;--blue:#315efb;--line:#e6eaf2;color:var(--ink);background:#fff}
.learn-home *{box-sizing:border-box}
.learn-home a{color:inherit;text-decoration:none}
.learn-home .welcome{width:min(1160px,calc(100% - 44px));margin:0 auto;padding:76px 0 68px;display:grid;grid-template-columns:1.25fr .75fr;gap:70px;align-items:center}
.eyebrow{display:inline-flex;align-items:center;gap:8px;color:var(--blue);font-size:.67rem;font-weight:850;letter-spacing:.13em}
.eyebrow i{width:7px;height:7px;border-radius:50%;background:#20a66b}
.welcome h1{font-size:clamp(3rem,6.2vw,5.8rem);line-height:.98;letter-spacing:-.075em;margin:22px 0}
.welcome h1 em,.section-intro h2 em{color:var(--blue);font-style:normal}
.welcome-copy>p{max-width:620px;color:var(--muted);font-size:1.08rem;line-height:1.8}
.welcome-actions{display:flex;align-items:center;gap:20px;flex-wrap:wrap;margin-top:28px}
.primary-action{display:inline-flex;gap:28px;align-items:center;background:var(--blue);color:#fff!important;padding:15px 21px;border-radius:9px;font-size:.88rem;font-weight:800;box-shadow:0 8px 22px #315efb25}
.primary-action:hover{background:#244bd6;transform:translateY(-1px)}
.primary-action span{font-size:1.2rem}
.secondary-action{font-size:.82rem;font-weight:750;color:#4b5870!important}
.welcome-trust{display:flex;gap:18px;flex-wrap:wrap;margin-top:30px;color:#68758b;font-size:.72rem}
.start-card{position:relative;overflow:hidden;padding:30px;border:1px solid #dfe6fb;border-radius:18px;background:linear-gradient(145deg,#f5f7ff,#fff 72%);box-shadow:0 18px 55px #1a2b570c}
.start-card-label{font-size:.62rem;letter-spacing:.12em;color:var(--blue);font-weight:900}
.start-number{font-size:5rem;line-height:1;font-weight:900;letter-spacing:-.09em;color:#dce4ff;margin:26px 0 12px}
.start-card h2{font-size:1.55rem;letter-spacing:-.04em;margin:0 0 10px}
.start-card p{color:var(--muted);font-size:.87rem;line-height:1.7}
.start-card>a{display:flex;justify-content:space-between;margin-top:22px;padding:13px 0;border-top:1px solid #dfe5f4;color:var(--blue);font-size:.82rem;font-weight:850}
.start-card small{display:block;color:#818ba0;font-size:.68rem;line-height:1.5}
.how-section,.journey-section,.course-section,.reassurance{width:min(1160px,calc(100% - 44px));margin:0 auto;padding:66px 0}
.how-section{border-top:1px solid var(--line)}
.section-intro{max-width:650px}
.section-intro h2{font-size:clamp(2rem,4vw,3.3rem);letter-spacing:-.065em;line-height:1.05;margin:12px 0}
.section-intro>p,.section-intro>div>p{color:var(--muted);line-height:1.75;font-size:.92rem}
.section-intro-row{max-width:none;display:flex;justify-content:space-between;align-items:end;gap:28px}
.section-intro-row>div{max-width:680px}
.how-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:30px}
.how-grid article{padding:24px;border:1px solid var(--line);border-radius:14px;background:#fff}
.step-icon{display:grid;place-items:center;width:38px;height:38px;border-radius:10px;background:#edf1ff;color:var(--blue);font-weight:900;font-size:.76rem}
.how-grid h3{margin:20px 0 7px;font-size:1.2rem}
.how-grid p{margin:0;color:var(--muted);font-size:.84rem;line-height:1.7}
.journey-section{border-top:1px solid var(--line)}
.journey-badge{white-space:nowrap;padding:8px 12px;border:1px solid #dce5ff;border-radius:30px;color:var(--blue);font-size:.72rem;font-weight:800}
.journey-flow{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:30px}
.journey-step{position:relative;display:flex;flex-direction:column;min-height:240px;padding:20px;border:1px solid var(--line);border-radius:14px;background:#fafbfe}
.journey-step.is-available{background:#fff;border-color:#d8e1ff}
.journey-step-number{font-size:1.8rem;font-weight:900;letter-spacing:-.06em;color:#c6d1f5}
.journey-step-copy{margin-top:24px}
.journey-step-copy>span{font-size:.58rem;font-weight:900;letter-spacing:.1em;color:#8993a5}
.journey-step h3{font-size:1rem;margin:8px 0}
.journey-step p{font-size:.76rem;line-height:1.65;color:var(--muted);margin:0}
.journey-step>a{display:flex;justify-content:space-between;align-items:center;margin-top:auto;padding-top:18px;color:var(--blue);font-size:.76rem;font-weight:850}
.coming-label{margin-top:auto;padding-top:18px;color:#929bad;font-size:.72rem;font-weight:750}
.journey-note{display:flex;gap:10px;align-items:flex-start;margin:18px 0 0;padding:15px 17px;border-radius:10px;background:#f5f7ff;color:#52617d;font-size:.78rem;line-height:1.6}
.journey-note span{color:var(--blue)}
.course-section{border-top:1px solid var(--line)}
.all-courses-link{white-space:nowrap;color:var(--blue)!important;font-size:.8rem;font-weight:850}
.course-controls{display:flex;justify-content:space-between;align-items:center;gap:18px;margin:28px 0 20px}
.course-search{display:flex;align-items:center;gap:9px;width:min(330px,100%);padding:11px 13px;border:1px solid var(--line);border-radius:9px;color:#7b879b}
.course-search input{width:100%;border:0;outline:0;font:inherit;font-size:.8rem;color:var(--ink);background:transparent}
.category-filters{display:flex;gap:7px;flex-wrap:wrap}
.category-filters button{border:1px solid var(--line);background:#fff;border-radius:30px;padding:8px 12px;color:#667085;font:inherit;font-size:.7rem;font-weight:750;cursor:pointer}
.category-filters button.selected{border-color:#315efb;background:#edf1ff;color:#315efb}
.course-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.course-card{display:flex;flex-direction:column;min-height:220px;padding:21px;border:1px solid var(--line);border-radius:14px;background:#fff;transition:transform .18s,border-color .18s,box-shadow .18s}
.course-card:hover{transform:translateY(-3px);border-color:#cbd7ff;box-shadow:0 12px 30px #17213b0b}
.course-card[hidden]{display:none}
.course-card-top{display:flex;align-items:center;justify-content:space-between}
.course-icon{display:grid;place-items:center;width:38px;height:38px;border-radius:10px;background:#edf1ff;color:var(--blue);font-size:.78rem;font-weight:900}
.course-card-top>span:last-child{font-size:.64rem;color:#7e899c}
.course-card>small{margin-top:19px;color:var(--blue);font-size:.64rem;font-weight:850}
.course-card h3{font-size:1.12rem;margin:7px 0}
.course-card>p{margin:0;color:var(--muted);font-size:.77rem;line-height:1.65}
.course-card-foot{display:flex;justify-content:space-between;gap:8px;align-items:center;margin-top:auto;padding-top:20px;color:#8490a3;font-size:.68rem}
.course-card-foot b{color:var(--blue);font-size:.7rem}
.no-results{padding:24px;color:var(--muted);text-align:center}
.reassurance{border-top:1px solid var(--line);display:grid;grid-template-columns:.75fr 1.25fr;gap:65px}
.reassurance h2{font-size:2rem;letter-spacing:-.06em;margin:12px 0}
.reassurance-items details{border-bottom:1px solid var(--line);padding:15px 0}
.reassurance-items summary{display:flex;justify-content:space-between;gap:12px;cursor:pointer;list-style:none;font-size:.85rem;font-weight:800}
.reassurance-items summary::-webkit-details-marker{display:none}
.reassurance-items summary span{color:var(--blue);font-size:1.1rem}
.reassurance-items details p{max-width:650px;color:var(--muted);font-size:.8rem;line-height:1.7;margin:12px 0 0}
.learn-footer{display:flex;justify-content:space-between;gap:15px;padding:24px max(22px,calc((100% - 1160px)/2));background:#f7f8fc;color:#667085;font-size:.75rem}
.learn-footer p{margin:0}.learn-footer a{color:var(--blue);font-weight:800}
@media(max-width:900px){.learn-home .welcome{grid-template-columns:1fr;gap:35px;padding-top:55px}.start-card{max-width:560px}.journey-flow{grid-template-columns:repeat(2,1fr)}.course-grid{grid-template-columns:repeat(2,1fr)}.reassurance{grid-template-columns:1fr;gap:25px}}
@media(max-width:600px){.learn-home .welcome,.how-section,.journey-section,.course-section,.reassurance{width:calc(100% - 30px)}.learn-home .welcome{padding:44px 0}.welcome h1{font-size:clamp(2.8rem,13vw,4.3rem)}.welcome-actions{align-items:flex-start;flex-direction:column;gap:14px}.welcome-trust{gap:9px 14px}.how-section,.journey-section,.course-section,.reassurance{padding:46px 0}.how-grid,.journey-flow,.course-grid{grid-template-columns:1fr}.section-intro-row{align-items:flex-start;flex-direction:column;gap:8px}.journey-step{min-height:205px}.course-controls{align-items:stretch;flex-direction:column}.course-search{width:100%}.category-filters{overflow-x:auto;flex-wrap:nowrap;padding-bottom:4px}.category-filters button{white-space:nowrap}.learn-footer{padding:20px 15px}}
@media(prefers-reduced-motion:reduce){.course-card{transition:none}.primary-action:hover,.course-card:hover{transform:none}}
</style>
