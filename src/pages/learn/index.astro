---
import BaseLayout from '@layouts/BaseLayout.astro';
import { courses } from '../../data/learn/courses';
const categories=[['01','Programming','Learn software fundamentals and problem-solving.','Python · Java · JavaScript','⌘'],['02','Web development','Build responsive, accessible web experiences.','HTML · CSS · JavaScript · React','◫'],['03','Databases','Model, query and reason about application data.','SQL · MySQL · DBMS','▤'],['04','Cloud & DevOps','Explore deployment, infrastructure and automation.','Git · Docker · Kubernetes · Cloud','☁'],['05','AI & data','Build foundations in data and modern AI systems.','Data science · ML · Generative AI','✳'],['06','Computer science','Understand algorithms, systems and software design.','DSA · OS · Networks · OOP','⌬']];
const paths=[['Web development foundations','Beginner','A guided route through HTML, CSS and JavaScript.'],['Programming fundamentals','Beginner','Build core concepts before choosing a language.'],['Modern developer workflow','Beginner → Intermediate','Learn Git, collaboration, testing and project habits.']];
---
<BaseLayout title="B Tecky LearnLab — Learn. Practise. Build." description="Build practical technology skills with structured learning paths, clear lessons, practice and projects from B Tecky.">
<main class="learnlab">
<section class="hero"><div class="container hero-grid"><div><p class="eyebrow">● B TECKY / LEARNLAB</p><h1 class="display">Learn with purpose.<br><em>Build with confidence.</em></h1><p class="lede">Understand technology from the foundations up. Follow a clear path, practise what you learn and turn concepts into practical projects.</p><div class="actions"><a class="primary" href="/learn/paths/">Explore learning paths ↘</a><a class="secondary" href="#categories">Browse subjects</a><a class="secondary" href="/learn/practice/">Practice centre</a></div><div class="proof">01 / UNDERSTAND　　02 / PRACTISE　　03 / BUILD</div></div><div class="art"><div class="orbit"></div><div class="board"><div class="board-top"><b>B.</b><span>YOUR NEXT SKILL STARTS HERE</span><i>● READY</i></div><div class="board-main">From first<br><strong>principles</strong><br>to real projects.</div><div class="board-steps">LEARN　→　PRACTISE　→　BUILD</div><div class="meter"><i></i></div></div><span class="float-one">LESSON 01<br><b>Start small.</b></span><span class="float-two">PROJECT 01<br><b>Make it real.</b></span></div></div></section>
<section class="principles"><div class="container principles-grid"><div><b>Clear explanations</b><span>Understand the why, not just the syntax.</span></div><div><b>Practical examples</b><span>See concepts applied to real problems.</span></div><div><b>Steady progression</b><span>Know what to learn next and why.</span></div></div></section>
<section class="container section journey" id="paths"><div class="section-heading"><div><p class="kicker">ONE PATH · ONE REAL PROJECT</p><h2 class="display">Become a web developer<br/>by building a website.</h2></div><p>Learn each technology in the order real websites are made. Your project grows with you: structure first, design second, functionality third.</p></div><div class="journey-banner"><div class="journey-intro"><span class="journey-tag">FEATURED LEARNING PATH</span><h3>Complete Web Development</h3><p>HTML → CSS → JavaScript. Three connected stages, one website you build yourself.</p><a class="primary" href="/learn/paths/web-development/">Explore the Web Development path ↗</a></div><div class="journey-stages"><article class="journey-stage active"><span>01</span><div><b>HTML</b><small>Build the structure</small></div><i>AVAILABLE NOW</i></article><article class="journey-stage"><span>02</span><div><b>CSS</b><small>Design the same website</small></div><i>UP NEXT</i></article><article class="journey-stage"><span>03</span><div><b>JavaScript</b><small>Make it interactive</small></div><i>FINAL STAGE</i></article></div></div><div class="journey-note"><b>Your work carries forward.</b> The same project continues through every stage — no starting over and no rebuilding the website from scratch.</div></section>
<section class="container section course-catalogue" id="available-courses"><div class="section-heading"><div><p class="kicker">AVAILABLE COURSES</p><h2 class="display">Start learning today.</h2></div><p>Begin with a structured course, practise each concept and apply what you learn in a guided project.</p></div><div class="available-grid">{courses.map((course,index)=><a class="available-card" href={"/learn/"+course.slug+"/"}><span>COURSE / {String(index+1).padStart(2,"0")}</span><small>{course.level} · {course.lessons.length} lessons</small><h3>{course.title}</h3><p>{course.summary}</p><b>Explore course →</b></a>)}</div></section><section class="category-section" id="categories"><div class="container"><div class="section-heading"><div><p class="kicker">EXPLORE BY SUBJECT</p><h2 class="display">Find your starting point.</h2></div><p>Choose a subject that interests you. Each area will grow into structured courses with lessons, examples and practice.</p></div><div class="category-grid">{categories.map(c=><article class="category-card"><div class="category-top"><span>{c[0]} / LEARN</span><b>{c[4]}</b></div><h3>{c[1]}</h3><p>{c[2]}</p><div class="category-bottom"><span>{c[3]}</span><i>Coming soon</i></div>{c[1] === "Web development" && <a class="category-start" href="/learn/html/">Start with HTML foundations ↗</a>}</article>)}</div></div></section>
<section class="container levels"><div><p class="kicker">GROW AT YOUR PACE</p><h2 class="display">Start where you are.<br>Go as far as you want.</h2><p>Courses will have clear prerequisites and increasing depth, helping you build a strong foundation before advanced work.</p></div><div class="level-list"><article><span>01</span><div><h3>Beginner</h3><p>Core ideas, terminology, setup and guided examples.</p></div><b>FOUNDATIONS</b></article><article><span>02</span><div><h3>Intermediate</h3><p>Combine concepts, solve problems and learn common patterns.</p></div><b>APPLICATION</b></article><article><span>03</span><div><h3>Advanced</h3><p>Explore internals, architecture, trade-offs, performance and security.</p></div><b>MASTERY</b></article></div></section>
<section class="cta"><div class="container cta-inner"><div><p class="kicker">BUILT FOR CURIOUS BUILDERS</p><h2 class="display">Don't just read about it.<br><em>Learn it. Use it. Build it.</em></h2><p>We're building the lesson, practice and project experience to make every step count.</p></div><a class="primary" href="/contact">Connect with B Tecky ↗</a></div></section>
</main></BaseLayout>
<style>
.learnlab{overflow:hidden}.learnlab .container{width:min(1160px,calc(100% - 48px));margin:auto}.hero{padding:75px 0 58px;background:radial-gradient(ellipse at 78% 25%,#dce5ff,transparent 34%),linear-gradient(135deg,#f5f7ff,#fff 56%,#f7f9ff)}.hero-grid{display:grid;grid-template-columns:1.08fr .92fr;gap:40px;align-items:center;min-height:450px}.eyebrow,.kicker{font-size:.7rem;font-weight:900;letter-spacing:.15em;color:#315efb}.hero h1{font-size:clamp(3.1rem,6.3vw,6.1rem);line-height:.94;letter-spacing:-.075em;margin:24px 0}.hero h1 em{font-style:normal;color:#315efb}.lede{max-width:570px;color:#667085;font-size:1.08rem;line-height:1.85}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:27px}.primary,.secondary{display:inline-flex;padding:14px 18px;border-radius:11px;font-size:.86rem;font-weight:800}.primary{background:#315efb;color:#fff}.secondary{border:1px solid #e1e6f0;background:#fff}.proof{margin-top:32px;color:#8993a7;font-size:.61rem;font-weight:900;letter-spacing:.12em}.art{height:400px;position:relative;display:grid;place-items:center}.orbit{position:absolute;width:390px;height:270px;border:1px solid #c9d5ff;border-radius:50%;transform:rotate(-25deg)}.board{position:relative;z-index:1;width:min(390px,88%);min-height:285px;padding:24px;border-radius:24px;background:linear-gradient(145deg,#172b69,#315efb 75%,#6c8aff);color:#fff;box-shadow:0 30px 70px #2448a344;display:flex;flex-direction:column;justify-content:space-between;transform:rotate(-4deg)}.board-top,.board-steps{display:flex;justify-content:space-between;align-items:center;gap:10px;font-size:.57rem;font-weight:800;letter-spacing:.1em;color:#d9e2ff}.board-top b{font-size:1.4rem;color:#fff}.board-top i{font-style:normal;color:#baffdf}.board-main{font-family:var(--font-display);font-size:3.3rem;line-height:.91;letter-spacing:-.07em;padding:20px 0}.board-main strong{color:#b9caff}.meter{height:5px;background:#ffffff40;border-radius:8px;overflow:hidden}.meter i{display:block;width:72%;height:100%;background:#fff}.float-one,.float-two{position:absolute;z-index:2;padding:13px 16px;border:1px solid #e8ecf6;border-radius:13px;background:#fff;box-shadow:0 16px 40px #24345f20;font-size:.55rem;font-weight:900;letter-spacing:.12em;color:#315efb;line-height:1.8}.float-one b,.float-two b{font-size:1rem;color:#101828}.float-one{top:35px;left:0;transform:rotate(-7deg)}.float-two{bottom:35px;right:0;transform:rotate(6deg)}.principles{border-block:1px solid #e8ebf3}.principles-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;padding-block:25px}.principles-grid div{display:flex;flex-direction:column;gap:6px}.principles-grid b{font-size:.9rem}.principles-grid span{font-size:.8rem;color:#667085;line-height:1.5}.section{padding-block:88px}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:32px}.section-heading h2{font-size:clamp(2.3rem,4.5vw,4rem);line-height:1;letter-spacing:-.065em;margin:14px 0 0}.section-heading>p{max-width:390px;color:#667085;line-height:1.75;font-size:.92rem}.path-grid,.category-grid,.available-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.path-card,.category-card{padding:23px;border:1px solid #e5e9f2;border-radius:17px;background:#fff;min-height:220px}.path-card>span,.category-top span{font-size:.62rem;font-weight:900;letter-spacing:.12em;color:#8792a6}.path-card small{float:right;padding:6px 9px;border-radius:20px;background:#edf2ff;color:#315efb;font-weight:800}.path-card h3,.category-card h3{font-family:var(--font-display);font-size:1.4rem;letter-spacing:-.04em;margin:30px 0 8px}.path-card p,.category-card p{font-size:.86rem;color:#667085;line-height:1.7}.path-card>b{font-size:.67rem;color:#315efb}.path-start,.category-start{display:inline-block;margin-top:12px;color:#315efb;font-size:.75rem;font-weight:900}.category-start{padding-top:13px}.category-section{padding:80px 0;background:#f7f8fc}.category-top,.category-bottom{display:flex;justify-content:space-between;align-items:center;gap:10px}.category-top b{width:42px;height:42px;display:grid;place-items:center;border-radius:12px;background:#edf2ff;color:#315efb;font-size:1.3rem}.category-card h3{margin:18px 0 4px}.category-bottom{padding-top:14px;border-top:1px solid #edf0f5;color:#315efb;font-size:.67rem;font-weight:800}.category-bottom i{font-style:normal;color:#8792a6}.levels{display:grid;grid-template-columns:.85fr 1.15fr;gap:70px;padding-block:95px}.levels h2{font-size:clamp(2.4rem,4vw,3.8rem);line-height:1;letter-spacing:-.06em;margin:15px 0}.levels>div:first-child>p:last-child{color:#667085;line-height:1.8}.level-list article{display:grid;grid-template-columns:35px 1fr auto;gap:15px;align-items:center;padding:22px 0;border-bottom:1px solid #e8ebf2}.level-list article:first-child{border-top:1px solid #e8ebf2}.level-list article>span{color:#315efb;font-size:.75rem;font-weight:900}.level-list h3{margin:0 0 5px;font-family:var(--font-display);font-size:1.25rem}.level-list p{margin:0;color:#667085;font-size:.8rem;line-height:1.6}.level-list article>b{font-size:.58rem;letter-spacing:.1em;color:#8792a6}.cta{padding:68px 0;background:#142653;color:#fff}.cta-inner{display:flex;align-items:center;justify-content:space-between;gap:35px}.cta .kicker{color:#a9bcff}.cta h2{font-size:clamp(2.3rem,4.2vw,4rem);line-height:1;letter-spacing:-.06em;margin:15px 0}.cta h2 em{font-style:normal;color:#a9bcff}.cta p:not(.kicker){color:#d1daf0;line-height:1.7}
@media(max-width:900px){.hero-grid{grid-template-columns:1fr}.art{height:360px}.levels{grid-template-columns:1fr;gap:30px}}@media(max-width:700px){.learnlab .container{width:min(100% - 32px,1160px)}.hero{padding-top:55px}.art{height:315px}.board{min-height:245px}.board-main{font-size:2.8rem}.float-one{top:12px}.float-two{bottom:12px}.principles-grid{grid-template-columns:1fr;gap:17px}.section{padding-block:62px}.section-heading{display:block}.section-heading>p{margin-top:15px}.path-grid,.category-grid{grid-template-columns:1fr}.levels{padding-block:65px}.level-list article{grid-template-columns:28px 1fr}.level-list article>b{grid-column:2}.cta-inner{display:block}.cta-inner>.primary{margin-top:18px}}
.journey-banner{display:grid;grid-template-columns:1fr 1fr;gap:28px;padding:34px;border-radius:24px;background:linear-gradient(125deg,#142653,#2449a5);color:#fff}.journey-tag{font-size:.62rem;letter-spacing:.14em;font-weight:900;color:#b8c9ff}.journey-intro h3{font-size:2rem;letter-spacing:-.05em;margin:18px 0 8px}.journey-intro p{max-width:420px;color:#d5def6;line-height:1.7;margin-bottom:22px}.journey-intro .primary{background:#fff;color:#2449a5}.journey-stages{display:grid;gap:10px}.journey-stage{display:grid;grid-template-columns:38px 1fr auto;gap:12px;align-items:center;padding:17px;border:1px solid #ffffff35;border-radius:14px;background:#ffffff0c}.journey-stage>span{font-weight:900;color:#a9bcff}.journey-stage div{display:grid;gap:4px}.journey-stage b{font-size:1rem}.journey-stage small{font-size:.75rem;color:#d5def6}.journey-stage i{font-size:.56rem;font-style:normal;font-weight:900;letter-spacing:.08em;color:#c3d0f3}.journey-stage.active{background:#ffffff18;border-color:#a9bcff}.journey-note{margin-top:14px;padding:16px 20px;border:1px solid #e5e9f2;border-radius:12px;color:#667085;font-size:.84rem;line-height:1.6}.journey-note b{color:#17213b}.available-card{display:block;padding:23px;border:1px solid #e5e9f2;border-radius:17px;background:#fff;color:inherit;transition:transform .18s,border-color .18s}.available-card:hover{transform:translateY(-3px);border-color:#315efb}.available-card>span{font-size:.62rem;font-weight:900;letter-spacing:.12em;color:#8792a6}.available-card>small{float:right;font-size:.65rem;color:#315efb;font-weight:800}.available-card h3{font-family:var(--font-display);font-size:1.35rem;letter-spacing:-.04em;margin:28px 0 8px}.available-card p{min-height:58px;font-size:.84rem;color:#667085;line-height:1.7}.available-card b{font-size:.75rem;color:#315efb}\n@media(max-width:700px){.journey-banner{grid-template-columns:1fr;padding:22px}.journey-stage{grid-template-columns:28px 1fr}.journey-stage i{grid-column:2}.available-grid{grid-template-columns:1fr}}\n</style>