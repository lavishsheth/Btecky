---
import BaseLayout from '@layouts/BaseLayout.astro';
import { courses } from '../../data/learn/courses';
import { learningCategories } from '../../data/learn/categories';
import { assertValidLearnLabCatalogue } from '../../data/learn/catalogue';

assertValidLearnLabCatalogue();
const availableCategories = learningCategories.filter((category) => courses.some((course) => course.category === category.title)).sort((a, b) => a.sortOrder - b.sortOrder);
const featuredCourses = courses.map((course) => ({
  slug: course.slug,
  title: course.title,
  category: course.category,
  level: course.level,
  summary: course.summary,
  lessons: course.lessons.length,
  minutes: course.lessons.reduce((total, lesson) => total + lesson.minutes, 0),
}));
---
<BaseLayout
  title="LearnLab — Free, practical technology learning | B Tecky"
  description="Learn technology for free with B Tecky LearnLab. Follow connected learning paths, study individual courses, practise concepts and build real projects at your own pace."
>
  <main class="learnlab-home">
    <section class="ll-hero">
      <div class="ll-container ll-hero__grid">
        <div class="ll-hero__copy">
          <p class="ll-eyebrow"><span></span> B TECKY / LEARNLAB</p>
          <h1>Make learning<br />your <em>superpower.</em></h1>
          <p class="ll-hero__lead">A place to understand technology, practise what you learn, and turn your ideas into things that work. Start with the basics. Keep building from there.</p>
          <div class="ll-hero__actions">
            <a class="ll-button ll-button--primary" href="#explore">Explore what you can learn <span aria-hidden="true">↘</span></a>
            <a class="ll-button ll-button--quiet" href="#how-it-works">See how LearnLab works</a>
          </div>
          <div class="ll-hero__promise"><span aria-hidden="true">✓</span> Free for everyone <i></i> Learn at your own pace <i></i> No account required to start</div>
        </div>
        <div class="ll-hero-art" aria-label="Illustration of a website being built with HTML, CSS and JavaScript">
          <div class="ll-hero-art__glow"></div>
          <div class="ll-code-window">
            <div class="ll-code-window__bar"><div><i></i><i></i><i></i></div><span>your-first-website</span><b>•••</b></div>
            <div class="ll-code-window__body">
              <div class="ll-code-lines" aria-hidden="true"><span>01</span><span>02</span><span>03</span><span>04</span><span>05</span><span>06</span><span>07</span><span>08</span></div>
              <pre><code><span class="ll-code-purple">&lt;main&gt;</span>
  <span class="ll-code-blue">&lt;h1&gt;</span>Hello, world!<span class="ll-code-blue">&lt;/h1&gt;</span>
  <span class="ll-code-blue">&lt;p&gt;</span>
    I built this.
  <span class="ll-code-blue">&lt;/p&gt;</span>
  <span class="ll-code-purple">&lt;button&gt;</span>
    Explore
  <span class="ll-code-purple">&lt;/button&gt;</span>
<span class="ll-code-purple">&lt;/main&gt;</span></code></pre>
            </div>
            <div class="ll-code-window__foot"><span><b></b> All changes saved</span><span>HTML · CSS · JS</span></div>
          </div>
          <div class="ll-float-card ll-float-card--top"><span class="ll-float-icon">⌘</span><span><b>Start with the basics</b><small>One concept at a time</small></span></div>
          <div class="ll-float-card ll-float-card--bottom"><span class="ll-float-icon ll-float-icon--green">↗</span><span><b>Build something real</b><small>Learning you can use</small></span></div>
          <div class="ll-hero-art__caption">FROM FIRST IDEA TO FINISHED PROJECT <span>✳</span></div>
        </div>
      </div>
      <div class="ll-container ll-hero__bottom"><span>CURIOUS MINDS WELCOME</span><span>01 — LEARN <i>→</i> 02 — PRACTISE <i>→</i> 03 — BUILD</span></div>
    </section>

    <section class="ll-intro ll-container" id="why-learnlab">
      <div class="ll-intro__label"><span class="ll-eyebrow">WHY WE BUILT THIS</span><span class="ll-section-index">01 / THE IDEA</span></div>
      <div class="ll-intro__content">
        <h2>Technology should be easier to <em>learn, explore and create with.</em></h2>
        <div class="ll-intro__text"><p>We created LearnLab because getting started with technology can feel confusing. Tutorials are scattered, concepts are disconnected, and it is not always clear what to learn next.</p><p>LearnLab brings learning into one guided space. We want anyone with curiosity and an internet connection to have the chance to build useful skills—without a price tag standing in the way.</p><div class="ll-free-note"><span>✳</span><p><b>Always free to access.</b><br />Our goal is to make practical technology education accessible to everyone.</p></div></div>
      </div>
    </section>

    <section class="ll-benefits">
      <div class="ll-container">
        <div class="ll-section-heading"><div><span class="ll-eyebrow">MORE THAN JUST LESSONS</span><h2>Everything you need<br />to move forward.</h2></div><p>LearnLab connects the pieces of learning, so you can go from understanding a concept to using it with confidence.</p></div>
        <div class="ll-benefit-grid">
          <article class="ll-benefit"><span class="ll-benefit__icon">▤</span><span class="ll-benefit__number">01</span><h3>Clear, in-depth lessons</h3><p>Understand topics through structured explanations, examples, and useful references—not just quick definitions.</p></article>
          <article class="ll-benefit"><span class="ll-benefit__icon">⌘</span><span class="ll-benefit__number">02</span><h3>Guided learning paths</h3><p>Follow a sensible sequence where each subject builds on what came before it.</p></article>
          <article class="ll-benefit"><span class="ll-benefit__icon">⚡</span><span class="ll-benefit__number">03</span><h3>Practice as you learn</h3><p>Reinforce ideas with exercises and knowledge checks that help you test your understanding.</p></article>
          <article class="ll-benefit"><span class="ll-benefit__icon">↗</span><span class="ll-benefit__number">04</span><h3>Projects with purpose</h3><p>Bring multiple lessons together and create practical work you can understand and improve.</p></article>
        </div>
      </div>
    </section>

    <section class="ll-path-section" id="how-it-works">
      <div class="ll-container">
        <div class="ll-section-heading ll-section-heading--path"><div><span class="ll-eyebrow">LEARN IN A CONNECTED WAY</span><h2>One step leads<br />to the next.</h2></div><p>Some skills make more sense when you learn them together. A learning path connects related courses into one bigger journey.</p></div>
        <div class="ll-path-feature">
          <div class="ll-path-feature__copy">
            <span class="ll-path-tag">FEATURED LEARNING PATH</span>
            <h3>Web development</h3>
            <p>Build one website from the ground up. Start by creating its structure, give that same website its design, then bring it to life with interactions.</p>
            <a class="ll-text-link" href="/learn/paths/">Explore learning paths <span>↗</span></a>
            <div class="ll-path-note"><span>✳</span> Your work carries forward. Each stage builds on the website you made in the previous stage.</div>
          </div>
          <div class="ll-journey" aria-label="Web development learning sequence">
            <div class="ll-journey__step ll-journey__step--active"><span class="ll-journey__symbol">&lt;/&gt;</span><div><small>STEP 01 · AVAILABLE</small><b>HTML — Build the structure</b><p>Create the content and foundation of your website.</p></div><span class="ll-journey__status">Start here ↗</span></div>
            <div class="ll-journey__connector"><span></span></div>
            <div class="ll-journey__step"><span class="ll-journey__symbol ll-journey__symbol--blue">✳</span><div><small>STEP 02 · NEXT STAGE</small><b>CSS — Design the website</b><p>Style the same pages with layout, colour and responsive design.</p></div><span class="ll-journey__status">Coming next</span></div>
            <div class="ll-journey__connector"><span></span></div>
            <div class="ll-journey__step"><span class="ll-journey__symbol ll-journey__symbol--gold">{ }</span><div><small>STEP 03 · NEXT STAGE</small><b>JavaScript — Add behaviour</b><p>Make the same website interactive and useful.</p></div><span class="ll-journey__status">Coming next</span></div>
            <div class="ll-journey__result"><span>✦</span><div><b>One complete website</b><small>Structure + design + functionality</small></div></div>
          </div>
        </div>
      </div>
    </section>

    <section class="ll-catalogue ll-container" id="explore">
      <div class="ll-section-heading"><div><span class="ll-eyebrow">YOUR NEXT SKILL STARTS HERE</span><h2>Explore the courses.</h2></div><p>Prefer to focus on one topic? Browse individual courses and learn what you need, in the order that works for you.</p></div>
      <div class="ll-catalogue__tools">
        <label class="ll-search"><span aria-hidden="true">⌕</span><input id="ll-course-search" type="search" placeholder="Search courses or topics..." aria-label="Search courses" /><kbd>/</kbd></label>
        <div class="ll-filters" role="group" aria-label="Filter courses">
          <button class="is-active" type="button" data-course-filter="all" aria-pressed="true">All courses</button>
          {availableCategories.map((category) => <button type="button" data-course-filter={category.title} aria-pressed="false">{category.title}</button>)}
        </div>
      </div>
      <div class="ll-course-grid" id="ll-course-grid">
        {featuredCourses.map((course) => <a class="ll-course-card" href={'/learn/' + course.slug + '/'} data-course-card data-category={course.category} data-search={(course.title + ' ' + course.category + ' ' + course.summary).toLowerCase()}>
          <div class="ll-course-card__top"><span class="ll-course-card__icon">{course.category === 'Web development' ? '</>' : '⌘'}</span><span class="ll-course-level">{course.level}</span></div>
          <span class="ll-course-category">{course.category}</span><h3>{course.title}</h3><p>{course.summary}</p>
          <div class="ll-course-card__meta"><span>{course.lessons} lessons</span><span>~{course.minutes} min</span><b>Explore course ↗</b></div>
        </a>)}
      </div>
      <p class="ll-no-results" id="ll-no-results" hidden>No courses match that search yet. Try another topic or choose a different filter.</p>
      <div class="ll-catalogue__foot"><span>New topics and courses will be added as LearnLab grows.</span><div><a class="ll-text-link" href="/learn/paths/">See learning paths <span>↗</span></a><a class="ll-text-link" href="/learn/courses/">Browse all courses <span>↗</span></a></div></div>
    </section>

    <section class="ll-practice">
      <div class="ll-container ll-practice__grid">
        <div class="ll-practice__visual" aria-hidden="true"><div class="ll-practice-sheet"><span>QUICK KNOWLEDGE CHECK</span><b>What does HTML do?</b><div class="ll-answer ll-answer--chosen"><i>A</i> Gives a page its structure <strong>✓</strong></div><div class="ll-answer"><i>B</i> Styles the page</div><div class="ll-answer"><i>C</i> Stores user data</div><div class="ll-practice-sheet__foot"><span>KEEP LEARNING</span><b>01 / 03</b></div></div><span class="ll-practice-sticker">LEARN<br />BY DOING ✳</span></div>
        <div class="ll-practice__copy"><span class="ll-eyebrow">UNDERSTANDING COMES FROM DOING</span><h2>Read it. Try it.<br /><em>Make it stick.</em></h2><p>Every lesson is designed to move beyond reading. Work through practical exercises, check your understanding, and revisit ideas whenever you need a refresher.</p><div class="ll-practice-points"><span><b>01</b> Guided exercises</span><span><b>02</b> Knowledge checks</span><span><b>03</b> Learn at your own pace</span></div><a class="ll-button ll-button--primary" href="/learn/practice/">Visit the practice centre <span>↗</span></a></div>
      </div>
    </section>

    <section class="ll-project-section ll-container">
      <div class="ll-project-copy"><span class="ll-eyebrow">THE GOAL IS TO BUILD</span><h2>Turn what you learn<br />into <em>something real.</em></h2><p>Lessons give you the building blocks. Projects help you connect them. Our learning journeys are designed to bring concepts together into practical outcomes you can keep improving.</p><a class="ll-text-link" href="/learn/paths/">See how projects fit into learning <span>↗</span></a></div>
      <div class="ll-project-board"><div class="ll-project-board__head"><span>YOUR LEARNING JOURNEY</span><span>✳ IN PROGRESS</span></div><div class="ll-project-board__canvas"><div class="ll-browser"><div class="ll-browser__bar"><i></i><i></i><i></i><span>my-first-website.dev</span></div><div class="ll-browser__page"><div class="ll-browser__nav"><b>mySite.</b><span>HOME　 ABOUT　 CONTACT</span></div><div class="ll-browser__hero"><small>HELLO, WORLD</small><b>Ideas become<br />experiences.</b><span>A website built one skill at a time.</span><i>EXPLORE MORE ↗</i></div><div class="ll-browser__blocks"><i></i><i></i><i></i></div></div></div></div><div class="ll-project-board__foot"><span><b>HTML</b> Structure</span><i>+</i><span><b>CSS</b> Design</span><i>+</i><span><b>JS</b> Interaction</span></div></div>
    </section>

    <section class="ll-faq">
      <div class="ll-container ll-faq__grid">
        <div><span class="ll-eyebrow">GOOD TO KNOW</span><h2>Questions?<br /><em>We've got you.</em></h2><p>A few things worth knowing before you begin.</p></div>
        <div class="ll-faq-list">
          <details open><summary>Is LearnLab really free? <span>+</span></summary><p>Yes. LearnLab is designed to be free for everyone. You can access the available learning content without paying for a subscription.</p></details>
          <details><summary>Do I need prior coding experience? <span>+</span></summary><p>No. Beginner-friendly learning starts with the foundations. Each course explains its prerequisites so you can choose a comfortable starting point.</p></details>
          <details><summary>Can I learn just one topic? <span>+</span></summary><p>Absolutely. You can explore individual courses independently, or follow a connected learning path when you want a guided sequence.</p></details>
          <details><summary>Will I build real projects? <span>+</span></summary><p>Yes. Practice tasks help you apply individual concepts, while integrated projects bring related skills together. The web development journey is designed around building one website through HTML, CSS and JavaScript.</p></details>
          <details><summary>Do I need to create an account? <span>+</span></summary><p>You can start exploring the available lessons without creating an account. Some progress information is stored locally in your browser on your device.</p></details>
        </div>
      </div>
    </section>

    <section class="ll-final">
      <div class="ll-container ll-final__inner"><span class="ll-eyebrow">YOUR NEXT CHAPTER STARTS HERE</span><h2>Curiosity is a great<br />place to <em>start.</em></h2><p>Pick a topic, take the first lesson, and see where it leads. LearnLab is here when you're ready.</p><a class="ll-button ll-button--light" href="#explore">Start exploring LearnLab <span>↗</span></a><small>FREE FOR EVERYONE · BUILT BY B TECKY</small></div>
    </section>
  </main>
  <script>
    const searchInput = document.querySelector<HTMLInputElement>('#ll-course-search');
    const filterButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-course-filter]')];
    const courseCards = [...document.querySelectorAll<HTMLElement>('[data-course-card]')];
    const noResults = document.querySelector<HTMLElement>('#ll-no-results');
    let activeCategory = 'all';

    function updateCourses() {
      const query = searchInput?.value.trim().toLowerCase() || '';
      let visibleCount = 0;
      courseCards.forEach((card) => {
        const matchesCategory = activeCategory === 'all' || card.dataset.category === activeCategory;
        const matchesQuery = !query || (card.dataset.search || '').includes(query);
        const visible = matchesCategory && matchesQuery;
        card.hidden = !visible;
        if (visible) visibleCount += 1;
      });
      if (noResults) noResults.hidden = visibleCount > 0;
    }

    searchInput?.addEventListener('input', updateCourses);
    filterButtons.forEach((button) => button.addEventListener('click', () => {
      activeCategory = button.dataset.courseFilter || 'all';
      filterButtons.forEach((item) => {
        const selected = item === button;
        item.classList.toggle('is-active', selected);
        item.setAttribute('aria-pressed', String(selected));
      });
      updateCourses();
    }));

    document.addEventListener('keydown', (event) => {
      if (event.key === '/' && !['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName || '')) {
        event.preventDefault();
        searchInput?.focus();
      }
    });
  </script>
</BaseLayout>

<style>
  .learnlab-home{--ll-blue:var(--color-brand);--ll-ink:var(--color-ink);--ll-muted:var(--color-muted);--ll-line:var(--color-border);color:var(--ll-ink);overflow:hidden}
  .ll-container{width:min(var(--content-width),calc(100% - 48px));margin-inline:auto}
  .ll-eyebrow{display:inline-flex;align-items:center;gap:9px;color:var(--color-brand);font-size:.68rem;font-weight:900;letter-spacing:.15em}
  .ll-eyebrow>span{width:7px;height:7px;border-radius:50%;background:var(--color-brand);box-shadow:0 0 0 4px rgba(49,94,251,.1)}
  .ll-hero{position:relative;padding:75px 0 0;background:radial-gradient(ellipse at 78% 32%,rgba(49,94,251,.12),transparent 33%),linear-gradient(135deg,#f5f7ff 0%,#fff 56%,#f8f9ff 100%)}
  .ll-hero__grid{display:grid;grid-template-columns:1.02fr .98fr;align-items:center;gap:50px;min-height:485px}
  .ll-hero h1,.ll-section-heading h2,.ll-intro h2,.ll-practice h2,.ll-project-copy h2,.ll-faq h2,.ll-final h2{font-family:var(--font-display);font-weight:700;letter-spacing:-.065em}
  .ll-hero h1{font-size:clamp(3.5rem,6.4vw,6.4rem);line-height:.94;margin:25px 0 22px}
  .ll-hero h1 em,.ll-intro h2 em,.ll-practice h2 em,.ll-project-copy h2 em,.ll-faq h2 em{font-style:normal;color:var(--color-brand)}
  .ll-hero__lead{max-width:570px;color:#596579;font-size:1.05rem;line-height:1.85}
  .ll-hero__actions{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-top:28px}
  .ll-button{display:inline-flex;align-items:center;justify-content:center;gap:16px;min-height:49px;padding:0 19px;border-radius:11px;font-size:.82rem;font-weight:800;transition:transform .2s ease,box-shadow .2s ease,background .2s ease}
  .ll-button:hover{transform:translateY(-2px)}
  .ll-button--primary{background:var(--color-brand);color:#fff;box-shadow:0 9px 22px rgba(49,94,251,.2)}
  .ll-button--primary:hover{background:var(--color-brand-strong);box-shadow:0 13px 26px rgba(49,94,251,.25)}
  .ll-button--quiet{color:var(--ll-ink);border:1px solid #e1e6f0;background:rgba(255,255,255,.75)}
  .ll-hero__promise{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:25px;color:#68758a;font-size:.68rem;font-weight:700}
  .ll-hero__promise>span{display:grid;place-items:center;width:18px;height:18px;border-radius:50%;background:#e7f7ef;color:#16834d;font-size:.7rem}
  .ll-hero__promise i{width:3px;height:3px;border-radius:50%;background:#aab2c0}
  .ll-hero-art{height:430px;position:relative;display:grid;place-items:center}
  .ll-hero-art__glow{position:absolute;width:390px;height:330px;border-radius:50%;background:rgba(49,94,251,.1);filter:blur(35px)}
  .ll-code-window{position:relative;z-index:1;width:min(430px,88%);overflow:hidden;border:1px solid #263a70;border-radius:17px;background:#111d3a;box-shadow:0 30px 75px rgba(23,42,91,.25);transform:rotate(-3deg)}
  .ll-code-window__bar{height:46px;display:flex;align-items:center;justify-content:space-between;padding:0 15px;border-bottom:1px solid #ffffff15;color:#b7c5e5;font-size:.63rem}
  .ll-code-window__bar>div{display:flex;gap:5px}.ll-code-window__bar i{width:7px;height:7px;border-radius:50%;background:#fb7777}.ll-code-window__bar i:nth-child(2){background:#f3c66b}.ll-code-window__bar i:nth-child(3){background:#62d59b}.ll-code-window__bar b{letter-spacing:2px}
  .ll-code-window__body{display:grid;grid-template-columns:34px 1fr;padding:21px 16px 22px 0;min-height:258px}
  .ll-code-lines{display:flex;flex-direction:column;gap:12px;padding-left:13px;color:#65779f;font: .65rem/1.5 monospace}
  .ll-code-window pre{margin:0;color:#e2e9fb;font: .79rem/1.65 ui-monospace,SFMono-Regular,Consolas,monospace;white-space:pre-wrap}
  .ll-code-purple{color:#c3a6ff}.ll-code-blue{color:#7bc6ff}
  .ll-code-window__foot{display:flex;justify-content:space-between;padding:11px 15px;border-top:1px solid #ffffff15;color:#9badd2;font-size:.59rem}
  .ll-code-window__foot>span:first-child{display:flex;align-items:center;gap:7px}.ll-code-window__foot b{width:6px;height:6px;border-radius:50%;background:#5ed49a}
  .ll-float-card{position:absolute;z-index:2;display:flex;align-items:center;gap:10px;padding:12px 15px;border:1px solid #e7ebf4;border-radius:12px;background:#fff;box-shadow:0 15px 40px rgba(16,24,40,.12)}
  .ll-float-card--top{top:42px;left:-5px;transform:rotate(-5deg)}.ll-float-card--bottom{bottom:48px;right:-5px;transform:rotate(4deg)}
  .ll-float-icon{display:grid;place-items:center;width:34px;height:34px;border-radius:9px;background:#edf1ff;color:var(--color-brand);font-size:1.1rem;font-weight:900}.ll-float-icon--green{background:#e8f8f0;color:#16834d}
  .ll-float-card b,.ll-float-card small{display:block}.ll-float-card b{font-size:.72rem}.ll-float-card small{margin-top:3px;color:#7a8598;font-size:.62rem}
  .ll-hero-art__caption{position:absolute;bottom:3px;right:4px;color:#8993a6;font-size:.56rem;font-weight:900;letter-spacing:.13em}.ll-hero-art__caption span{color:var(--color-brand);margin-left:7px}
  .ll-hero__bottom{display:flex;justify-content:space-between;padding:18px 0;border-top:1px solid #e6eaf3;color:#8791a4;font-size:.59rem;font-weight:900;letter-spacing:.13em}
  .ll-hero__bottom i{font-style:normal;color:var(--color-brand);padding:0 5px}
  .ll-intro{display:grid;grid-template-columns:.45fr 1.55fr;gap:40px;padding-block:100px}
  .ll-intro__label{display:flex;flex-direction:column;justify-content:space-between;align-items:flex-start}.ll-section-index{color:#9aa3b3;font-size:.6rem;font-weight:900;letter-spacing:.12em}
  .ll-intro__content{display:grid;grid-template-columns:1.1fr .9fr;gap:50px;align-items:start}
  .ll-intro h2{font-size:clamp(2.5rem,4.6vw,4.4rem);line-height:1.02;margin:0}
  .ll-intro__text>p{margin:0 0 14px;color:#667085;font-size:.9rem;line-height:1.8}
  .ll-free-note{display:flex;gap:12px;align-items:flex-start;margin-top:23px;padding:15px;border:1px solid #dfe8ff;border-radius:12px;background:#f6f8ff}.ll-free-note>span{color:var(--color-brand);font-size:1.2rem}.ll-free-note p{margin:0;color:#53617a;font-size:.77rem;line-height:1.65}.ll-free-note b{color:#17213b}
  .ll-benefits{padding:86px 0 92px;background:#f7f8fc;border-block:1px solid #edf0f5}
  .ll-section-heading{display:flex;justify-content:space-between;align-items:end;gap:35px;margin-bottom:34px}
  .ll-section-heading h2{margin:13px 0 0;font-size:clamp(2.7rem,4.7vw,4.5rem);line-height:.98}
  .ll-section-heading>p{max-width:400px;margin:0 0 4px;color:#667085;font-size:.9rem;line-height:1.8}
  .ll-benefit-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:13px}
  .ll-benefit{position:relative;min-height:225px;padding:22px;border:1px solid #e5e9f2;border-radius:15px;background:#fff;transition:transform .2s ease,box-shadow .2s ease}
  .ll-benefit:hover{transform:translateY(-4px);box-shadow:var(--shadow-card)}
