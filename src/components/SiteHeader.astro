---
const links = [
  { href: '/', label: 'Home' }, { href: '/about', label: 'About' },
  { href: '/#products', label: 'Products' }, { href: '/blog', label: 'Blog' },
  { href: '/partners', label: 'Partners' }, { href: '/contact', label: 'Contact' },
];
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="B Tecky home"><span class="brand-mark" aria-hidden="true">B</span><span>B Tecky</span></a>
    <nav aria-label="Main navigation" class="desktop-nav">{links.map((link) => <a href={link.href}>{link.label}</a>)}</nav>
    <a class="header-cta" href="/contact">Let's talk <span aria-hidden="true">↗</span></a>
  </div>
</header>
<style>
.site-header{position:sticky;top:0;z-index:20;background:rgba(255,255,255,.88);backdrop-filter:blur(16px);border-bottom:1px solid var(--color-border)}
.header-inner{height:76px;display:flex;align-items:center;justify-content:space-between;gap:28px}
.brand{display:inline-flex;align-items:center;gap:11px;font-weight:800;font-size:1.08rem;letter-spacing:-.04em}
.brand-mark{display:grid;place-items:center;width:38px;height:38px;border-radius:12px;background:var(--color-brand);color:#fff;font-family:var(--font-display);font-size:1.5rem}
.desktop-nav{display:flex;align-items:center;gap:clamp(14px,2.2vw,30px);color:#475467;font-size:.9rem;font-weight:600}
.desktop-nav a:hover{color:var(--color-brand)}
.header-cta{padding:11px 16px;border:1px solid var(--color-border);border-radius:999px;font-size:.88rem;font-weight:700}
.header-cta:hover{border-color:var(--color-brand);color:var(--color-brand)}
@media(max-width:760px){.header-inner{height:66px}.desktop-nav{display:none}.header-cta{margin-left:auto}}
</style>
